    vip_code = str(cfg.get("vip_link_code", "")).strip()

    if not valid_place_id(place_id) or not valid_vip(vip_code):
        log("Place ID หรือ VIP Code ไม่ถูกต้อง", RED)
        return False

    log("กำลังปิดเกมและเคลียร์ Log...", YELLOW)
    await abatch_root({
        "stop": f"am force-stop {PACKAGE_NAME}",
        "rmlog": f"rm -rf {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log 2>/dev/null",
        "ram": "sync && echo 3 > /proc/sys/vm/drop_caches",
    })
