# ================= ฟังก์ชันแก้บัคพิมพ์ข้าม =================
def safe_input(prompt_text):
    try:
        import termios
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    except Exception: pass
    time.sleep(0.1)
    try: return input(prompt_text).strip()
    except EOFError: return ""

# ================= จัดการการตั้งค่าและคำสั่ง Root =================
def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                for k, v in DEFAULT_CONFIG.items():
                    if k not in data: data[k] = v
                return data
        except: pass
    return DEFAULT_CONFIG.copy()

def save_config(cfg):
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)

def log(msg, color=CYAN):
    now = datetime.now().strftime("%H:%M:%S")
    print(f"{color}[{now}] {msg}{RESET}")

def run_root_text(cmd):
    try:
        res = subprocess.run(["su", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
        return res.stdout.strip()
    except: return ""

def clear_system_ram():
    run_root_text("sync && echo 3 > /proc/sys/vm/drop_caches")

def capture_screenshot_bytes():
    try:
        cmd = "screencap -p /sdcard/orig_screen.png && cat /sdcard/orig_screen.png"
        res = subprocess.run(["su", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
        if res.returncode == 0 and res.stdout: return res.stdout
    except: pass
    return None

# ================= ระบบ Discord Bot =================
def get_discord_embed(dev_name):
    try:
        with open('/proc/stat', 'r') as f: s1 = [int(i) for i in f.readline().split()[1:8]]
        time.sleep(0.2)
        with open('/proc/stat', 'r') as f: s2 = [int(i) for i in f.readline().split()[1:8]]
        t1, t2 = sum(s1), sum(s2)
        i1, i2 = s1[3]+s1[4], s2[3]+s2[4]
        cpu_usage = round(100 * ((t2-t1) - (i2-i1)) / (t2-t1), 2) if t2-t1 > 0 else 0
    except: cpu_usage = 0

    try:
        with open('/proc/meminfo', 'r') as f: lines = f.readlines()
        mem_total = mem_avail = 0
        for l in lines:
            if l.startswith('MemTotal:'): mem_total = int(l.split()[1])
            elif l.startswith('MemAvailable:'): mem_avail = int(l.split()[1])
        mem_total_gb = round(mem_total / (1024*1024), 2)
        mem_avail_pct = round((mem_avail / mem_total) * 100, 2) if mem_total > 0 else 0
        mem_usage_pct = round(100 - mem_avail_pct, 2)
    except: mem_total_gb = mem_avail_pct = mem_usage_pct = 0

    try:
        with open('/proc/uptime', 'r') as f: up_sec = float(f.readline().split()[0])
        uptime_hrs = round(up_sec / 3600, 2)
    except: uptime_hrs = 0

    embed = discord.Embed(color=0x3498db) # สีฟ้า
    embed.add_field(name="🔹 Device Name", value=f"`{dev_name}`", inline=True)
    embed.add_field(name="⚙️ CPU Usage", value=f"`{cpu_usage}%`", inline=True)
    embed.add_field(name="💾 Memory Usage", value=f"`{mem_usage_pct}%`", inline=True)
    embed.add_field(name="💾 Memory Available", value=f"`{mem_avail_pct}%`", inline=True)
    embed.add_field(name="💡 Total Memory", value=f"`{mem_total_gb} GB`", inline=True)
    embed.add_field(name="⏰ Uptime", value=f"`{uptime_hrs} hours`", inline=True)
    return embed

async def join_roblox_async(cfg):
    place_id = cfg.get("place_id", "").strip()
    vip_code = cfg.get("vip_link_code", "").strip()
    
    log("กำลังบังคับปิดเกมและเคลียร์ไฟล์ Log เก่า...", YELLOW)
    run_root_text(f"am force-stop {PACKAGE_NAME}")
    run_root_text(f"rm -rf /data/data/{PACKAGE_NAME}/files/appData/logs/*.log")
    clear_system_ram()
    await asyncio.sleep(3)

    if vip_code: deep_link = f"roblox://placeId={place_id}&linkCode={vip_code}"
    else: deep_link = f"roblox://placeId={place_id}"

    cmd = f'am start -a android.intent.action.VIEW -d "{deep_link}" {PACKAGE_NAME}'
    run_root_text(cmd)
    log(f"ยิงคำสั่งเข้าแมพ {place_id} สำเร็จ! รอโหลดเข้าเกม 35 วินาที...", GREEN)
    await asyncio.sleep(35)

def analyze_game_health(cfg):
    target_place_id = str(cfg.get("place_id", "")).strip()
    if not run_root_text(f"pidof {PACKAGE_NAME}"): return False, "แอป Roblox ปิดตัวลง (App Crashed)"
    
    dumpsys_focus = run_root_text("dumpsys window windows | grep -E 'mCurrentFocus|mFocusedApp'")
    if "Application Not Responding" in dumpsys_focus: return False, "ตัวเกมค้างไม่ตอบสนอง (System ANR)"

    log_text = run_root_text(f"LOG_DIR=/data/data/{PACKAGE_NAME}/files/appData/logs; LATEST=$(ls -t $LOG_DIR/*.log 2>/dev/null | head -n 1); if [ -n \"$LATEST\" ]; then tail -n 150 \"$LATEST\"; fi")
    if log_text:
        log_lower = log_text.lower()
        if "273" in log_lower and ("same account" in log_lower or "disconnect" in log_lower): return False, "ตรวจพบการเข้าไอดีซ้อน! (Error Code: 273)"
        if "error code: 267" in log_lower or "kicked" in log_lower: return False, "ถูกเตะออกจากแมพ (Error Code: 267)"
        if "error code: 268" in log_lower or "unexpected client behavior" in log_lower: return False, "เซิร์ฟเวอร์เตะ (Error Code: 268)"
        for sig in ["lost connection", "disconnected from game", "idledisconnect", "error code: 277"]:
            if sig in log_lower: return False, f"หลุดออกจากเซิร์ฟเวอร์ ({sig})"
            
        if target_place_id:
            for line in reversed(log_text.splitlines()):
                if "placeId:" in line or "placeid=" in line.lower():
                    if target_place_id not in line: return False, f"ตรวจพบการอยู่ในแมพอื่นที่ไม่ใช่ Place ID: {target_place_id}"
                    break

    ui_xml = run_root_text("uiautomator dump /sdcard/orig_ui.xml && cat /sdcard/orig_ui.xml")
    if ui_xml and ("same account" in ui_xml.lower() or "273" in ui_xml.lower()): return False, "ตรวจพบคนเข้าไอดีซ้อนบนหน้าจอ (Error 273)"

    return True, "ปกติ"

