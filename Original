# ═══════════════════════════════════════════════════════════════
# TERMUX SERVICE MANAGEMENT
# ═══════════════════════════════════════════════════════════════
def _which(cmd: str) -> str | None:
    return shutil.which(cmd)

def _run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, **kw)

def is_installed() -> bool:
    return SERVICE_DIR.is_dir() and (SERVICE_DIR / "run").exists()

def install_service() -> bool:
    if not IS_TERMUX:
        error("ไม่ได้รันบน Termux — ไม่สามารถติดตั้ง service ได้")
        return False

    info(f"ติดตั้ง service: {SERVICE_NAME}")

    # ติดตั้งแพ็กเกจที่จำเป็น
    for pkg in ("python", "termux-services", "termux-api"):
        check = _run(["dpkg", "-s", pkg])
        if check.returncode != 0:
            info(f"ติดตั้ง {pkg} ...")
            r = _run(["pkg", "install", "-y", pkg])
            if r.returncode != 0:
                error(f"ติดตั้ง {pkg} ล้มเหลว")
                return False
            ok(f"{pkg} ติดตั้งสำเร็จ")

    # สร้างโฟลเดอร์
    LOG_DIR.mkdir(parents=True, exist_ok=True)

    # run script
    (SERVICE_DIR / "run").write_text(
        f'#!/data/data/com.termux/files/usr/bin/sh\n'
        f'termux-wake-lock\n'
        f'exec {sys.executable} -u "{SCRIPT_PATH}" --run-service\n'
    )
    (SERVICE_DIR / "run").chmod(0o755)

    # log script
    (SERVICE_DIR / "log" / "run").write_text(
        f'#!/data/data/com.termux/files/usr/bin/sh\n'
        f'exec svlogd -tt "{LOG_DIR}"\n'
    )
    (SERVICE_DIR / "log" / "run").chmod(0o755)

    ok(f"service พร้อม: {SERVICE_DIR}")

    # boot auto-start
    BOOT_DIR.mkdir(parents=True, exist_ok=True)
    BOOT_SCRIPT.write_text(
        f'#!/data/data/com.termux/files/usr/bin/sh\n'
        f'termux-wake-lock\n'
        f'sv up {SERVICE_NAME}\n'
    )
    BOOT_SCRIPT.chmod(0o755)
    ok(f"boot script: {BOOT_SCRIPT}")
    warn("ต้องติดตั้งแอป Termux:Boot จาก F-Droid → https://f-droid.org/packages/com.termux.boot/")

    # root: whitelist battery
    if _which("su"):
        info("ตรวจพบ root — whitelist Termux จาก battery optimization")
        _run(["su", "-c", "dumpsys deviceidle whitelist +com.termux"])
        _run(["su", "-c", "cmd appops set com.termux RUN_IN_BACKGROUND allow"])
        _run(["su", "-c", "cmd appops set com.termux RUN_ANY_IN_BACKGROUND allow"])
        ok("whitelist สำเร็จ")

    # sv-enable
    _run(["sv-enable", SERVICE_NAME])
    return True


def start_service() -> bool:
    if not is_installed():
        error("service ยังไม่ถูกติดตั้ง — รัน: python bot.py")
        return False
    r = _run(["sv", "up", SERVICE_NAME])
    time.sleep(2)
    return is_running()


def stop_service() -> bool:
    _run(["sv", "down", SERVICE_NAME])
    time.sleep(1)
    return not is_running()


def restart_service() -> bool:
    _run(["sv", "restart", SERVICE_NAME])
    time.sleep(2)
    return is_running()


def is_running() -> bool:
    r = _run(["sv", "status", SERVICE_NAME])
    return r.returncode == 0 and "run:" in r.stdout


def show_status() -> None:
    if not is_installed():
        warn("ยังไม่ได้ติดตั้ง service")
        print(f"  → รัน: {sys.executable} {SCRIPT_PATH.name}")
        return
    r = _run(["sv", "status", SERVICE_NAME])
    print(r.stdout.strip() if r.stdout else r.stderr.strip())
    print()
    if is_running():
        ok("บอทกำลังทำงานอยู่ (running)")
    else:
        warn("บอทไม่ได้ทำงาน (stopped)")
    print(f"   log file : {LOG_DIR / 'current'}")
    print(f"   คำสั่ง    : tail -f {LOG_DIR / 'current'}")


def uninstall_service() -> None:
    info("ลบ service...")
    _run(["sv-disable", SERVICE_NAME])
    _run(["sv", "down", SERVICE_NAME])
    if SERVICE_DIR.exists():
        shutil.rmtree(SERVICE_DIR)
    if BOOT_SCRIPT.exists():
        BOOT_SCRIPT.unlink()
    ok("ลบเรียบร้อย")


