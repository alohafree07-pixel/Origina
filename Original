class SealedFormatter(logging.Formatter):
    def format(self, record):
        try:
            text = super().format(record)
            return base64.b64encode(seal(text.encode("utf-8"))).decode("ascii")
        except Exception:
            return "[log-seal-error]"

def decode_log_line(line):
    line = line.strip()
    if not line:
        return ""
    try:
        return unseal(base64.b64decode(line, validate=True)).decode("utf-8", errors="replace")
    except Exception:
        return line

def style_log_line(line):
    ts, msg = (line[:23], line[23:]) if len(line) > 23 and line[4:5] == "-" else ("", line)
    low = msg.lower()
    if "[audit]" in low:
        c = "\033[38;5;244m"
    elif any(k in msg for k in ("❌", "🔥", "🚨", "ผิดพลาด")) or "error" in low or "traceback" in low:
        c = "\033[38;5;203m"
    elif any(k in msg for k in ("⚠", "🔌", "🔑", "📴")):
        c = "\033[38;5;221m"
    elif any(k in msg for k in ("✅", "สำเร็จ", "🟢", "🌐")):
        c = "\033[38;5;84m"
    else:
        c = "\033[38;5;252m"
    return f"\033[38;5;244m{ts}{RESET}{c}{msg}{RESET}"

def show_log(n=40):
