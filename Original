class AddScriptModal(discord.ui.Modal, title='📝 เพิ่มสคริปต์ฟาร์ม'):
    filename_input = discord.ui.TextInput(label='ชื่อไฟล์ (.lua, .txt, .json)', placeholder='เช่น farm.lua หรือ config.txt', required=True, max_length=60)
    script_input = discord.ui.TextInput(label='โค้ดสคริปต์ / เนื้อหาไฟล์', style=discord.TextStyle.paragraph, placeholder='loadstring(...) หรือข้อความ', required=True, max_length=4000)

    async def on_submit(self, interaction: discord.Interaction):
        if not is_authorized(interaction.user.id):
            return await interaction.response.send_message("⛔ ไม่มีสิทธิ์", ephemeral=True)
        path = normalize_path(CFG.get("autoexec_path", ""))
        filename = clean_filename(self.filename_input.value)
        if not filename:
            return await interaction.response.send_message("❌ ชื่อไฟล์ไม่ถูกต้อง (รองรับ .lua, .txt, .json, .cfg, .ini)", ephemeral=True)
        if not valid_path(path):
            return await interaction.response.send_message("❌ โฟลเดอร์ไม่ถูกต้อง", ephemeral=True)

        await interaction.response.defer(ephemeral=True)   # งาน root อาจเกิน 3 วินาที
        audit(interaction, f"add_script file={filename}")
        file_path = f"{path}/{filename}"
        encoded = base64.b64encode(self.script_input.value.encode('utf-8')).decode('ascii')
        qd, qf = shlex.quote(path), shlex.quote(file_path)
        cmd = (f"mkdir -p {qd} && echo {encoded} | base64 -d > {qf} "
               f"&& [ -s {qf} ] && echo OK || echo FAIL")
        res = await aroot(cmd)
        if res.strip() != "OK":
            log(f"เพิ่มสคริปต์ไม่สำเร็จ: {filename}", RED)
            return await interaction.followup.send(f"❌ เขียน `{filename}` ไม่สำเร็จ (ตรวจสิทธิ์ root / path)", ephemeral=True)
        add_history("Script Added", f"{filename} → {path}")
        await interaction.followup.send(f"✅ สร้าง `{filename}` สำเร็จ!", ephemeral=True)
        log(f"เพิ่มสคริปต์: {filename}", GREEN)

class DeleteScriptModal(discord.ui.Modal, title='🗑️ ลบสคริปต์ฟาร์ม'):
    filename_input = discord.ui.TextInput(label='ชื่อไฟล์ (รวมนามสกุล)', placeholder='เช่น farm.lua หรือ config.txt', required=True, max_length=60)

    async def on_submit(self, interaction: discord.Interaction):
        if not is_authorized(interaction.user.id):
            return await interaction.response.send_message("⛔ ไม่มีสิทธิ์", ephemeral=True)
        path = normalize_path(CFG.get("autoexec_path", ""))
        filename = clean_filename(self.filename_input.value)
        if not filename or not valid_path(path):
            return await interaction.response.send_message("❌ ไม่ถูกต้อง", ephemeral=True)

        await interaction.response.defer(ephemeral=True)
        audit(interaction, f"del_script file={filename}")
        q = shlex.quote(f"{path}/{filename}")
        res = await aroot(f"if [ -f {q} ]; then rm -f {q} && echo OK; else echo FAIL; fi")
        if res.strip() == 'OK':
            add_history("Script Deleted", f"{filename} → {path}")
            await interaction.followup.send(f"🗑️ ลบ `{filename}` แล้ว!", ephemeral=True)
            log(f"ลบสคริปต์: {filename}", YELLOW)
        else:
            await interaction.followup.send(f"❌ ไม่พบ `{filename}`", ephemeral=True)

class SettingsModal(discord.ui.Modal, title='⚙️ แก้ไขการตั้งค่า (Settings)'):
    def __init__(self):
        super().__init__()
        self.inp_pid = discord.ui.TextInput(label='Place ID', default=str(CFG.get('place_id', '')), required=True)
        self.inp_sm = discord.ui.TextInput(label='รอบแคปหน้าจอ (นาที)', default=str(CFG.get('screenshot_minutes', 10)), required=True)
        self.inp_rh = discord.ui.TextInput(label='รอบ Clear RAM (ชั่วโมง)', default=str(CFG.get('clear_ram_hours', 1.0)), required=True)
        self.inp_auto_rejoin = discord.ui.TextInput(label='บังคับรีจอยอัตโนมัติ (ชั่วโมง, 0=ปิด)', default=str(CFG.get('auto_rejoin_hours', 0.0)), required=True)
        self.inp_exec = discord.ui.TextInput(label='โฟลเดอร์ AutoExec', default=str(CFG.get('autoexec_path', '/sdcard/Delta/autoexec')), required=True)
        for item in (self.inp_pid, self.inp_sm, self.inp_rh, self.inp_auto_rejoin, self.inp_exec):
            self.add_item(item)

    async def on_submit(self, interaction: discord.Interaction):
        if not is_authorized(interaction.user.id):
            return await interaction.response.send_message("⛔ ไม่มีสิทธิ์", ephemeral=True)
        errors, updates = [], {}

        pid = self.inp_pid.value.strip()
        if valid_place_id(pid):
            updates["place_id"] = pid
        else:
            errors.append("Place ID ต้องเป็นตัวเลข")

        try:
            sm = int(self.inp_sm.value)
            if sm < 1:
                raise ValueError
            updates["screenshot_minutes"] = sm
        except ValueError:
            errors.append("รอบแคป ≥ 1")

        try:
            rh = float(self.inp_rh.value)
            if rh < 0.1:
                raise ValueError
            updates["clear_ram_hours"] = rh
        except ValueError:
            errors.append("Clear RAM ≥ 0.1")

        try:
            arh = float(self.inp_auto_rejoin.value)
            if arh < 0:
                raise ValueError
            updates["auto_rejoin_hours"] = arh
        except ValueError:
            errors.append("บังคับรีจอย ≥ 0")

        exec_path = normalize_path(self.inp_exec.value)
        if valid_path(exec_path):
            updates["autoexec_path"] = exec_path
        else:
            errors.append("โฟลเดอร์ไม่ถูกต้อง")

        if errors:
            return await interaction.response.send_message("❌ " + ", ".join(errors), ephemeral=True)

        audit(interaction, "edit_settings")

        old_arh = float(CFG.get('auto_rejoin_hours', 0.0))
        new_arh = updates.get("auto_rejoin_hours", old_arh)
        if old_arh != new_arh:
            STATE["last_auto_rejoin"] = time.time()

        CFG.update(updates)
        save_config(CFG)
        add_history("Settings", f"โดย {interaction.user.name}")
        await interaction.response.send_message(
            f"✅ **อัปเดตการตั้งค่าสำเร็จ**\n🎮 Place ID: `{CFG['place_id']}`\n⏰ บังคับรีจอย: `{CFG['auto_rejoin_hours']} ชม.`\n📂 AutoExec: `{CFG['autoexec_path']}`", ephemeral=True)
        log("อัปเดตการตั้งค่าผ่าน Discord", GREEN)

