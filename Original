class SettingsModal(discord.ui.Modal, title='⚙️ แก้ไขการตั้งค่า (Settings)'):
    def __init__(self):
        super().__init__()
        self.inp_pid = discord.ui.TextInput(label='Place ID', default=str(CFG.get('place_id', '')), required=True)
        self.inp_sm = discord.ui.TextInput(label='รอบแคปหน้าจอ (นาที)', default=str(CFG.get('screenshot_minutes', 10)), required=True)
        self.inp_rh = discord.ui.TextInput(label='รอบ Clear RAM (ชั่วโมง)', default=str(CFG.get('clear_ram_hours', 1.0)), required=True)
        self.inp_auto_rejoin = discord.ui.TextInput(label='บังคับรีจอยอัตโนมัติ (ชั่วโมง, 0=ปิด)', default=str(CFG.get('auto_rejoin_hours', 0.0)), required=True)
        self.inp_exec = discord.ui.TextInput(label='โฟลเดอร์ AutoExec', default=str(CFG.get('autoexec_path', '/sdcard/Delta/autoexec')), required=True)
        for item in (self.inp_pid, self.inp_sm, self.inp_rh, self.inp_auto_rejoin, self.inp_exec):
            self.add_item(item)

    async def on_submit(self, interaction: discord.Interaction):
        if not is_authorized(interaction.user.id):
            return await interaction.response.send_message("⛔ ไม่มีสิทธิ์", ephemeral=True)
        errors, updates = [], {}

        pid = self.inp_pid.value.strip()
        if valid_place_id(pid):
            updates["place_id"] = pid
        else:
            errors.append("Place ID ต้องเป็นตัวเลข")

        try:
            sm = int(self.inp_sm.value)
            if sm < 1:
                raise ValueError
            updates["screenshot_minutes"] = sm
        except ValueError:
            errors.append("รอบแคป ≥ 1")

        try:
            rh = float(self.inp_rh.value)
            if rh < 0.1:
                raise ValueError
            updates["clear_ram_hours"] = rh
        except ValueError:
            errors.append("Clear RAM ≥ 0.1")

        try:
            arh = float(self.inp_auto_rejoin.value)
            if arh < 0:
                raise ValueError
            updates["auto_rejoin_hours"] = arh
        except ValueError:
            errors.append("บังคับรีจอย ≥ 0")

        exec_path = self.inp_exec.value.strip()
        if valid_path(exec_path):
            updates["autoexec_path"] = exec_path
        else:
            errors.append("โฟลเดอร์ไม่ถูกต้อง")

        if errors:
            return await interaction.response.send_message("❌ " + ", ".join(errors), ephemeral=True)

        audit(interaction, "edit_settings")

        old_arh = float(CFG.get('auto_rejoin_hours', 0.0))
        new_arh = updates.get("auto_rejoin_hours", old_arh)
        if old_arh != new_arh:
            STATE["last_auto_rejoin"] = time.time()

        CFG.update(updates)
        save_config(CFG)
        add_history("Settings", f"โดย {interaction.user.name}")
        await interaction.response.send_message(
            f"✅ **อัปเดตการตั้งค่าสำเร็จ**\n🎮 Place ID: `{CFG['place_id']}`\n⏰ บังคับรีจอย: `{CFG['auto_rejoin_hours']} ชม.`\n📂 AutoExec: `{CFG['autoexec_path']}`", ephemeral=True)
        log("อัปเดตการตั้งค่าผ่าน Discord", GREEN)

