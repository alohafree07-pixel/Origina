    def __init__(self):
        super().__init__()
        self.inp_pid = discord.ui.TextInput(label='Place ID ปัจจุบัน', default=str(CFG.get('place_id', '')), required=True)
        self.inp_sm = discord.ui.TextInput(label='รอบแคปหน้าจอ (นาที)', default=str(CFG.get('screenshot_minutes', 10)), required=True)
        self.inp_rh = discord.ui.TextInput(label='รอบ Clear RAM (ชั่วโมง)', default=str(CFG.get('clear_ram_hours', 1.0)), required=True)
        self.inp_exec = discord.ui.TextInput(label='โฟลเดอร์ AutoExec', default=str(CFG.get('autoexec_path', '/sdcard/Delta/autoexec')), required=True)
        for item in (self.inp_pid, self.inp_sm, self.inp_rh, self.inp_exec):
            self.add_item(item)

    async def on_submit(self, interaction: discord.Interaction):
        if not is_authorized(interaction.user.id):
            return await interaction.response.send_message("⛔ ไม่มีสิทธิ์", ephemeral=True)

        errors = []
        updates = {}

        pid = self.inp_pid.value.strip()
        if valid_place_id(pid):
            updates["place_id"] = pid
        else:
            errors.append("Place ID ต้องเป็นตัวเลข")

        try:
            screenshot_minutes = int(self.inp_sm.value)
            if screenshot_minutes < 1:
                raise ValueError
            updates["screenshot_minutes"] = screenshot_minutes
        except ValueError:
            errors.append("รอบแคปหน้าจอต้องเป็นจำนวนเต็ม ≥ 1")

        try:
            clear_ram_hours = float(self.inp_rh.value)
            if clear_ram_hours < 0.1:
                raise ValueError
            updates["clear_ram_hours"] = clear_ram_hours
        except ValueError:
            errors.append("รอบ Clear RAM ต้องเป็นตัวเลข ≥ 0.1")

        exec_path = self.inp_exec.value.strip()
        if valid_path(exec_path):
            updates["autoexec_path"] = exec_path
        else:
            errors.append("โฟลเดอร์ AutoExec ไม่ถูกต้อง")

        if errors:
            return await interaction.response.send_message(
                "❌ **ยังไม่บันทึกการตั้งค่า**\n⚠️ กรุณาแก้ไข: " + ", ".join(errors),
                ephemeral=True
            )

        CFG.update(updates)
        save_config(CFG)

        summary = (f"✅ **อัปเดตการตั้งค่า**\n🎮 Place ID: `{CFG['place_id']}`\n"
                   f"📂 โฟลเดอร์: `{CFG['autoexec_path']}`")
        await interaction.response.send_message(summary, ephemeral=True)
        log("อัปเดตการตั้งค่าผ่าน Discord", GREEN)

