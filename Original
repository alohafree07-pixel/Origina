def clear_termux_junk():
    home = os.path.expanduser("~")
    prefix = os.environ.get("PREFIX", "")
    targets = glob.glob(os.path.join(home, ".cache", "*"))
    if prefix:
        targets += glob.glob(os.path.join(prefix, "tmp", "*"))
    for p in targets:
        try:
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p, ignore_errors=True)
            else:
                os.remove(p)
        except OSError:
            pass
    try:
        subprocess.run(["apt", "clean"], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    except Exception:
        pass

