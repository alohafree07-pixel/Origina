# RUNTIME MODES
# ═══════════════════════════════════════════════════════════════
def run_bot_foreground(service_mode: bool = False) -> None:
    """รันบอทจริง (ใช้โดย service หรือ --foreground)"""
    token = load_token(interactive=False)
    if not token:
        error("ไม่พบ Discord Bot Token")
        print(f"   วิธีแก้: สร้างไฟล์ {TOKEN_FILE} แล้วใส่ token ลงไป")
        print(f"   หรือ:    export DISCORD_TOKEN='your-token'")
        sys.exit(1)

    # บันทึก PID
    try:
        PID_FILE.write_text(str(os.getpid()))
    except Exception:
        pass

    # graceful shutdown
    def _sigterm(*_):
        log.info("ได้รับ SIGTERM — กำลังปิดบอท...")
        asyncio.create_task(bot.close())

    try:
        signal.signal(signal.SIGTERM, _sigterm)
        signal.signal(signal.SIGINT,  _sigterm)
    except Exception:
        pass

    try:
        if service_mode:
            log.info("=== BOT STARTING (service mode) ===")
        bot.run(token, log_handler=None)
    except Exception as e:
        log.exception(f"Bot crashed: {e}")
        sys.exit(1)
    finally:
        try:
            PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass


