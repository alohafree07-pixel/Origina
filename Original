# ================= ตัวตรวจสอบข้อมูล =================
RE_PLACE = re.compile(r"\d{1,20}")
RE_VIP = re.compile(r"[A-Za-z0-9_\-]{1,100}")
RE_FILE = re.compile(r"[\w\-. ]{1,60}\.(?:lua|txt|json|cfg|ini)", re.IGNORECASE)
# รองรับ path หลากหลายขึ้น + ครอบคลุม /data/..., /mnt/..., /system/... ฯลฯ
RE_PATH = re.compile(r"^/(sdcard|storage|mnt|data|system|root|vendor)(/|$)")

def valid_place_id(v):
    return bool(RE_PLACE.fullmatch(str(v).strip()))

def valid_vip(v):
    v = str(v).strip()
    return v == "" or bool(RE_VIP.fullmatch(v))

def valid_path(v):
    v = str(v).strip()
    if not v or ".." in v or "\x00" in v:
        return False
    if not RE_PATH.match(v):
        return False
    # กัน shell metacharacters ที่อันตราย (แม้จะ shlex.quote แล้ว)
    if any(c in v for c in "\n\r\t;&|`$()<>\\"):
        return False
    return True

def clean_filename(name):
    name = os.path.basename(str(name).strip())
    if not name:
        return None
    if not re.search(r"\.(lua|txt|json|cfg|ini)$", name, re.IGNORECASE):
        name += ".lua"
    if name.startswith(".") or not RE_FILE.fullmatch(name):
        return None
    return name

