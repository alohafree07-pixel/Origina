# ================= ตัวตรวจสอบข้อมูล (กัน command injection) =================
RE_PLACE = re.compile(r"\d{1,20}")
RE_VIP = re.compile(r"[A-Za-z0-9_\-]{1,100}")
RE_FILE = re.compile(r"[\w\-. ]{1,60}\.lua")
RE_PATH = re.compile(r"/(sdcard|storage|data/local/tmp)(/[\w\-. ]+)*")

def valid_place_id(v):
    return bool(RE_PLACE.fullmatch(str(v).strip()))

def valid_vip(v):
    v = str(v).strip()
    return v == "" or bool(RE_VIP.fullmatch(v))

def valid_path(v):
    v = str(v).strip()
    return bool(RE_PATH.fullmatch(v)) and ".." not in v

def clean_filename(name):
    name = os.path.basename(str(name).strip())
    if not name.lower().endswith(".lua"):
        name += ".lua"
    if name.startswith(".") or not RE_FILE.fullmatch(name):
        return None
    return name

def is_authorized(user_id):
    return int(user_id) in CFG.get("allowed_users", [])

