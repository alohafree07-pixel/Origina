def spawn(coro):
    t = asyncio.create_task(coro)
    BG_TASKS.add(t)
    t.add_done_callback(BG_TASKS.discard)
    return t

async def _safe_send(channel, **kwargs):
    for attempt in range(3):
        try:
            return await channel.send(**kwargs)
        except discord.HTTPException as e:
            if attempt == 2:
                log(f"ส่ง Discord ล้มเหลว 3 ครั้ง: {e}", RED)
                return None
            log(f"ส่ง Discord ล้มเหลว ({attempt + 1}/3): {e}", YELLOW)
            await asyncio.sleep(2 ** attempt)
    return None

DASH_FILE = "original_dash.json"
DASH = {"msg": None, "lock": None, "shot_time": None}

def _load_dash_id():
    try:
        with open(DASH_FILE, "r", encoding="utf-8") as f:
            return int(json.load(f).get("message_id", 0)) or None
    except Exception:
        return None

def _save_dash_id(mid):
    try:
        with open(DASH_FILE, "w", encoding="utf-8") as f:
            json.dump({"message_id": mid}, f)
    except Exception:
        pass

async def _get_dash_msg(channel):
    if DASH["msg"]:
        return DASH["msg"]
    mid = _load_dash_id()
    if mid:
        try:
            DASH["msg"] = await channel.fetch_message(mid)
            return DASH["msg"]
        except Exception:
            pass
    return None

async def send_bot_report(channel, message="", include_screenshot=False, force_new=False):
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    pause_tag = " ⏸️ `[PAUSED]`" if STATE["paused"] else ""

    status_text = get_status_text()

    last_rejoin_str = "ยังไม่เคย Rejoin"
    if STATE.get("last_successful_rejoin", 0.0) > 0:
        last_rejoin_str = datetime.fromtimestamp(STATE["last_successful_rejoin"]).strftime("%Y-%m-%d %H:%M:%S")

    auto_rejoin_hrs = float(CFG.get('auto_rejoin_hours', 0.0))
    if auto_rejoin_hrs > 0:
        target_time = STATE.get("last_auto_rejoin", 0) + (auto_rejoin_hrs * 3600)
        remain_sec = target_time - time.time()
        if remain_sec > 0:
            hours = int(remain_sec // 3600)
            mins = int((remain_sec % 3600) // 60)
            secs = int(remain_sec % 60)
            if hours > 0:
                auto_rejoin_text = f"อีก {hours} ชม. {mins} นาที"
            elif mins > 0:
                auto_rejoin_text = f"อีก {mins} นาที {secs} วินาที"
            else:
                auto_rejoin_text = f"อีก {secs} วินาที"
        else:
            auto_rejoin_text = "กำลังจะเริ่ม..."
    else:
        auto_rejoin_text = "ปิดใช้งาน"

    content = f"🤖 **[ORIGINAL REPORT]**{pause_tag} (`{now_str}`)\n"
    content += f"📌 **สถานะ:** {status_text}\n"

    if message:
        content += f"📝 **รายละเอียด:** {message}\n"

    content += (f"🎮 **Place ID:** `{CFG['place_id']}`\n"
                f"🔁 **Rejoin รวม:** {STATE['rejoin_total']} ครั้ง\n"
                f"⏱️ **Rejoin ล่าสุด:** `{last_rejoin_str}`\n"
                f"⏳ **บังคับรีจอยอัตโนมัติ:** `{auto_rejoin_text}`")

    try:
        embed = await asyncio.to_thread(get_discord_embed, STATE["dev_name"], STATE["paused"])
        view = ControlView()
        img_bytes = await asyncio.to_thread(capture_screenshot_bytes) if include_screenshot else None

        def make_file():
            return discord.File(io.BytesIO(img_bytes), filename="screenshot.png")

        if img_bytes:
            DASH["shot_time"] = datetime.now().strftime("%H:%M:%S")
        elif DASH["shot_time"]:
            content += f"\n🖼️ ภาพหน้าจอล่าสุดเมื่อ `{DASH['shot_time']}`"

        if force_new:
            if img_bytes:
                await _safe_send(channel, content=content, embed=embed, file=make_file(), view=view)
            else:
                await _safe_send(channel, content=content, embed=embed, view=view)
            return

        if DASH["lock"] is None:
            DASH["lock"] = asyncio.Lock()
        async with DASH["lock"]:
            msg = await _get_dash_msg(channel)
            if msg:
                try:
                    kwargs = dict(content=content, embed=embed, view=view)
                    if img_bytes:
                        kwargs["attachments"] = [make_file()]
                    else:
                        kwargs["attachments"] = []
                    await msg.edit(**kwargs)
                    return
                except discord.NotFound:
                    DASH["msg"] = None
                except discord.HTTPException as e:
                    log(f"แก้ไขข้อความรายงานไม่สำเร็จ ({e})", YELLOW)
                    DASH["msg"] = None

            if img_bytes:
                new_msg = await _safe_send(channel, content=content, embed=embed, file=make_file(), view=view)
            else:
                new_msg = await _safe_send(channel, content=content, embed=embed, view=view)
            if new_msg:
                DASH["msg"] = new_msg
                _save_dash_id(new_msg.id)
    except Exception as e:
        log(f"ส่งรายงานพลาด: {e}", RED)

async def do_rejoin(channel, done_message, reason="ไม่ระบุสาเหตุ"):
    ok = False
    async with STATE["lock"]:
        cooldown = max(10, int(CFG.get("rejoin_cooldown_seconds", 45)))
        since = time.time() - STATE.get("last_rejoin_attempt", 0.0)
        if since < cooldown:
            log(f"ข้าม Rejoin (cooldown {cooldown - since:.0f}s)", YELLOW)
            return False
        STATE["last_rejoin_attempt"] = time.time()

        add_history("Rejoin", reason)

        ok = await join_roblox_async(CFG)
        if ok:
            now = time.time()
            STATE["game_start_time"] = now
            STATE["last_ram_clear"] = now
            STATE["last_screenshot"] = now
            STATE["last_successful_rejoin"] = now
            STATE["last_auto_rejoin"] = now
            STATE["rejoin_total"] += 1
            STATE["frozen_count"] = 0
            STATE["last_frame_sig"] = None
            STATE["bg_count"] = 0

    if ok:
        healthy, health_reason = await asyncio.to_thread(analyze_game_health, CFG)
        if not healthy:
            log(f"พบปัญหาหลังเข้าเกม: {health_reason}", RED)
            add_history("Rejoin Failed", health_reason)
            if channel:
                await send_bot_report(channel, f"⚠️ **เข้าเกมแล้วติดปัญหาทันที:** {health_reason}", True)
            return False
        log("เข้าแมพสำเร็จ", GREEN, force_redraw=True)
    else:
        log("❌ Rejoin ล้มเหลว", RED, force_redraw=True)
        add_history("Rejoin Failed", reason)

    if channel:
        await send_bot_report(channel, done_message if ok else "❌ Rejoin ไม่สำเร็จ", True)
    return ok

