def menu_3_start_bot(cfg):
    if not cfg['place_id'] or not cfg['bot_token'] or not cfg['channel_id']:
        print(f"\n{RED}✘ กรุณาตั้งค่า Place ID และ Bot Token ในเมนูที่ 1 และ 2 ก่อนครับ!{RESET}")
        time.sleep(2)
        return

    print(f"\n{BRIGHT_CYAN}--- [3] เริ่มระบบ Discord Bot Auto Rejoin ---{RESET}")
    print(f"{YELLOW}บอทกำลังรัน... คุณสามารถพิมพ์คำสั่งใน Discord ได้เลย{RESET}")
    print(f"{YELLOW}(คำสั่ง: !status, !rejoin, !setmap, !stopgame){RESET}")
    print(f"{YELLOW}(กดปุ่ม CTRL + c บน Termux เพื่อหยุดบอทและกลับสู่เมนูหลัก){RESET}\n")

    subprocess.run(["termux-wake-lock"], stderr=subprocess.DEVNULL)
    dev_name = run_root_text("getprop ro.product.model") or "Android Device"

    intents = discord.Intents.default()
    intents.message_content = True
    bot = commands.Bot(command_prefix="!", intents=intents)

    # Variables for loops
    state = {
        "last_screenshot": time.time(),
        "last_ram_clear": time.time()
    }

    async def send_bot_report(channel, message, include_screenshot=False):
        now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        content = f"🤖 **[ORIGINAL REPORT]** (`{now_str}`)\n📌 **สถานะ:** {message}\n🎮 **Place ID:** `{cfg['place_id']}`"
        embed = get_discord_embed(dev_name)
        
        try:
            if include_screenshot:
                img_bytes = capture_screenshot_bytes()
                if img_bytes:
                    file = discord.File(io.BytesIO(img_bytes), filename="screenshot.png")
                    await channel.send(content=content, embed=embed, file=file)
                    return
            await channel.send(content=content, embed=embed)
        except Exception as e:
            log(f"ส่งรายงานพลาด: {e}", RED)

    @bot.event
    async def on_ready():
        log(f"✅ เชื่อมต่อบอท Discord: {bot.user.name} สำเร็จ!", GREEN)
        channel = bot.get_channel(int(cfg['channel_id']))
        if channel:
            await send_bot_report(channel, "🟢 เริ่มเดินระบบเฝ้าจอ Auto Rejoin แล้ว! (รองรับคำสั่ง !status, !rejoin, !setmap, !stopgame)")
        
        if not run_root_text(f"pidof {PACKAGE_NAME}"):
            log("ยังไม่ได้เปิดเกม กำลังสั่งเข้าแมพครั้งแรก...", CYAN)
            await join_roblox_async(cfg)

        game_monitor_loop.start()

    @tasks.loop(seconds=cfg['check_interval'])
    async def game_monitor_loop():
        channel = bot.get_channel(int(cfg['channel_id']))
        
        if not ("1 received" in run_root_text("ping -c 1 -W 3 8.8.8.8")):
            log("⚠️ อินเทอร์เน็ตหลุด! กำลังรอสัญญาณ...", RED)
            return

        is_healthy, reason = analyze_game_health(cfg)
        if not is_healthy:
            log(f"⚠️ ปัญหา: {reason}", RED)
            if channel: await send_bot_report(channel, f"⚠️ **ปัญหา:** {reason}\n🔄 กำลังทำการ Rejoin...", True)
            await join_roblox_async(cfg)
            state["last_ram_clear"] = time.time()
            if channel: await send_bot_report(channel, f"✅ **Rejoin สำเร็จแล้ว**", True)
            state["last_screenshot"] = time.time()
            return

        now = time.time()
        if now - state["last_ram_clear"] >= cfg.get('clear_ram_hours', 1) * 3600:
            clear_system_ram()
            log("เคลียร์ RAM สำเร็จ", GREEN)
            state["last_ram_clear"] = now

        if now - state["last_screenshot"] >= cfg['screenshot_minutes'] * 60:
            log("แคปหน้าจอส่งรายงานอัตโนมัติ...", CYAN)
            if channel: await send_bot_report(channel, f"📸 รายงานสถานะหน้าจอประจำรอบ", True)
            state["last_screenshot"] = now

    # ================= ชุดคำสั่งให้เราพิมพ์สั่งใน Discord =================
    @bot.command()
    async def status(ctx):
        log(f"ได้รับคำสั่ง !status จาก Discord", YELLOW)
        await send_bot_report(ctx.channel, "📊 สถานะปัจจุบันของระบบ (ตรวจสอบโดยคำสั่ง)", True)

    @bot.command()
    async def rejoin(ctx):
        log(f"ได้รับคำสั่ง !rejoin จาก Discord", YELLOW)
        await ctx.send("🔄 ได้รับคำสั่ง: กำลังบังคับ Rejoin เข้าเกมใหม่...")
        await join_roblox_async(cfg)
        await send_bot_report(ctx.channel, "✅ บังคับ Rejoin จากคำสั่งเสร็จสิ้น", True)

    @bot.command()
    async def setmap(ctx, place_id: str):
        log(f"ได้รับคำสั่งเปลี่ยนแมพเป็น {place_id}", YELLOW)
        cfg['place_id'] = place_id
        save_config(cfg)
        await ctx.send(f"✅ บันทึก Place ID เป็น `{place_id}` แล้ว! กำลังบังคับดึงเข้าแมพใหม่...")
        await join_roblox_async(cfg)
        await send_bot_report(ctx.channel, "✅ ดึงเข้าแมพใหม่เสร็จสิ้น", True)

    @bot.command()
    async def stopgame(ctx):
        log(f"ได้รับคำสั่งหยุดเกมจาก Discord", YELLOW)
        run_root_text(f"am force-stop {PACKAGE_NAME}")
        await ctx.send("🛑 สั่งบังคับปิดแอป Roblox แล้ว (บอทยังออนไลน์เฝ้ารอคำสั่งต่อไป)")

    try:
        bot.run(cfg['bot_token'], log_handler=None) # ปิด log รกๆ ของ discord.py
    except discord.LoginFailure:
        print(f"\n{RED}❌ Bot Token ไม่ถูกต้อง! ตรวจสอบอีกครั้งในเมนู 2{RESET}")
        time.sleep(2)
    except KeyboardInterrupt:
        subprocess.run(["termux-wake-unlock"], stderr=subprocess.DEVNULL)
        print(f"\n\n{YELLOW}🛑 ปิดบอทเฝ้าจอแล้ว (Offline){RESET}")
        ans = safe_input("ต้องการบังคับปิดแอป Roblox ด้วยไหม? (y/n): ").lower()
        if ans == 'y': run_root_text(f"am force-stop {PACKAGE_NAME}")
        time.sleep(1)

# ================= ลูปหลักของโปรแกรม =================
def main():
    cfg = load_config()
    while True:
        print_ui(cfg)
        choice = safe_input(f"{BOLD_WHITE}เลือกเมนู: {RESET}")

        if choice == "1": menu_1_set_map(cfg)
        elif choice == "2": menu_2_set_bot(cfg)
        elif choice == "3": menu_3_start_bot(cfg)
        elif choice == "4": menu_4_ram(cfg)
        elif choice == "0":
            sys.exit(0)

if __name__ == "__main__":
    main()
