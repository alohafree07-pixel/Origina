def _script_dir():
    try:
        return os.path.dirname(os.path.abspath(__file__))
    except NameError:
        return os.getcwd()

def _pick_data_dir():
    """เลือกที่สร้างโฟลเดอร์ข้อมูล: ข้างสคริปต์ → ~ (home) → โฟลเดอร์ปัจจุบัน"""
    for root in (_script_dir(), os.path.expanduser("~"), os.getcwd()):
        d = os.path.join(root, APP_DIR_NAME)
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
            if os.access(d, os.W_OK):
                return d
        except OSError:
            continue
    return os.getcwd()

