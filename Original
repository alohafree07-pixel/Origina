@bot.event
async def on_command_error(ctx, exc):
    if isinstance(exc, commands.CommandNotFound):
        return
    log.error(f"Command error: {exc}")
    try:
        await ctx.send(f"❌ Error: `{exc}`")
    except Exception:
        pass


