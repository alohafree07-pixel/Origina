def main():
    CFG.update(load_config())
    while True:
        print_ui(CFG)
        choice = safe_input(f"  {BOLD_WHITE}เลือกเมนู: {RESET}")
        if choice == "1":
            menu_1_set_map(CFG)
        elif choice == "2":
            menu_2_set_bot(CFG)
        elif choice == "3":
