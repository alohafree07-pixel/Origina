ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
RECENT_LOGS = deque(maxlen=60)
_DASH_FIRST = [True]
HEADLESS = [False]

def vlen(s):
    return sum(_char_width(ch) for ch in ANSI_RE.sub("", str(s)))

def fit(s, width):
    s = str(s)
    if vlen(s) <= width:
        return s
    limit = max(1, width - 2)
    out, used, pos = [], 0, 0

    def take(seg):
        nonlocal used
        buf = []
        for ch in seg:
            w = _char_width(ch)
            if used + w > limit:
                return "".join(buf), True
            used += w
            buf.append(ch)
        return "".join(buf), False

    for m in ANSI_RE.finditer(s):
        txt, stop = take(s[pos:m.start()])
        out.append(txt)
        if stop:
            return "".join(out) + ".." + RESET
        out.append(m.group())
        pos = m.end()
    txt, _ = take(s[pos:])
    out.append(txt)
    return "".join(out) + ".." + RESET

def _term_size():
    try:
        sz = shutil.get_terminal_size((46, 24))
        return sz.columns, sz.lines
    except Exception:
        return 46, 24

def _bw():
    cols, _ = _term_size()
    return max(32, min(cols - 2, 56))

def b_top(title=""):
    bw = _bw()
    if title:
        lab = f" {title} "
        fill = max(0, bw - 3 - vlen(lab))
        return f" {C_BD}╭─{C_LBL}{lab}{C_BD}{'─' * fill}\033[{bw + 1}G╮{RESET}"
    return f" {C_BD}╭{'─' * (bw - 2)}\033[{bw + 1}G╮{RESET}"

def b_sep(title=""):
    bw = _bw()
    if title:
        lab = f" {title} "
        fill = max(0, bw - 3 - vlen(lab))
        return f" {C_BD}├─{C_LBL}{lab}{C_BD}{'─' * fill}\033[{bw + 1}G┤{RESET}"
    return f" {C_BD}├{'─' * (bw - 2)}\033[{bw + 1}G┤{RESET}"

def b_bot():
    bw = _bw()
    return f" {C_BD}╰{'─' * (bw - 2)}\033[{bw + 1}G╯{RESET}"

def b_row(content=""):
    bw = _bw()
    return f" {C_BD}│{RESET} {fit(content, bw - 4)}{RESET}\033[{bw + 1}G{C_BD}│{RESET}"

def kv(label, value, lw=11):
    return f"{C_LBL}{label}{RESET}" + " " * max(1, lw - vlen(label)) + str(value)

def dot(kind="ok"):
    c = {"ok": C_OK, "warn": C_WARN, "err": C_ERR}.get(kind, C_DIM)
    return f"{c}●{RESET}"

def bar(val, need, width=10):
    need = max(1, int(need))
    val = max(0, int(val))
    ratio = min(1.0, val / need)
    filled = int(round(ratio * width))
    color = C_OK if ratio < 0.5 else (C_WARN if ratio < 0.85 else C_ERR)
    return (f"{color}{'█' * filled}{C_DIM}{'░' * (width - filled)}{RESET} "
            f"{C_DIM}{min(val, need)}/{need}{RESET}")

def gradient(text, colors=(51, 45, 39, 33, 27)):
    n = max(1, len(text))
    out = []
    for i, ch in enumerate(text):
        c = colors[min(len(colors) - 1, i * len(colors) // n)]
        out.append(f"\033[1;38;5;{c}m{ch}")
    return "".join(out) + RESET

def fmt_dur(sec):
    sec = max(0, int(sec))
    return f"{sec // 3600:02d}:{(sec % 3600) // 60:02d}:{sec % 60:02d}"

def fmt_ago(ts):
    if not ts or ts <= 0:
        return "ยังไม่เคย"
    s = int(time.time() - ts)
    if s < 60:
        return f"{s} วิที่แล้ว"
    if s < 3600:
        return f"{s // 60} นาทีที่แล้ว"
    return f"{s // 3600} ชม. {(s % 3600) // 60} นาทีที่แล้ว"

def short_path(p, maxlen):
    p = str(p)
    return p if len(p) <= maxlen else "…" + p[-(maxlen - 1):]

