        log("🔑 แท็ก Discord: พบหน้าต่าง Key", YELLOW, force_redraw=True)
        if sent is not None and CFG.get("key_alert_delete", True):
            STATE.setdefault("key_msgs", []).append(sent)
            await delete_key_messages(keep_last=True)
    except asyncio.TimeoutError:
        log("⚠️ ส่งแจ้งเตือน Key เกินเวลา", YELLOW)
    except Exception as e:
        log(f"ส่งแจ้งเตือน Key ไม่สำเร็จ: {e}", RED)

async def handle_key_panel(channel, seen, can_clear):
    if seen:
        STATE["key_hits"] = STATE.get("key_hits", 0) + 1
        if STATE["key_hits"] < KEY_PANEL_CONFIRM:
            return
        now = time.time()
        interval = max(15, int(CFG.get("key_alert_seconds", 60)))
        if not STATE.get("key_active"):
            STATE["key_active"] = True
            STATE["key_since"] = now
            add_history("Key Panel", "พบหน้าต่าง Delta ขอ Key")
            log("🔑 พบหน้าต่าง Delta ขอ Key!", YELLOW, force_redraw=True)
        if now - STATE.get("last_key_alert", 0.0) >= interval:
            STATE["last_key_alert"] = now
            if channel:
                await send_key_alert(channel, interval)
        return

    if can_clear and (STATE.get("key_hits", 0) or STATE.get("key_active")):
        was_active = STATE.get("key_active")
        waited = int(time.time() - STATE.get("key_since", 0.0)) if was_active else 0
        STATE["key_hits"] = 0
        STATE["key_active"] = False
        STATE["last_key_alert"] = 0.0
        if was_active:
            add_history("Key Panel Cleared", f"หน้าต่าง Key หายไปแล้ว (ค้าง {waited} วินาที)")
            log("✅ หน้าต่าง Key หายไปแล้ว", GREEN, force_redraw=True)
            await delete_key_messages()
            if channel:
                extra = {"delete_after": 30} if CFG.get("key_alert_delete", True) else {}
                await _safe_send(channel, content=f"✅ **หน้าต่าง Delta ขอ Key หายไปแล้ว** (ค้างอยู่ {waited // 60} นาที {waited % 60} วินาที)", **extra)

def touch_heartbeat():
    STATE["last_heartbeat"] = time.time()
    STATE["bot_unresponsive"] = False

async def do_rejoin(channel, done_message, reason="ไม่ระบุสาเหตุ", force=False):
    if STATE["lock"] is None:
        STATE["lock"] = asyncio.Lock()

    ok = False
    async with STATE["lock"]:
        cooldown = max(10, int(CFG.get("rejoin_cooldown_seconds", 45)))
        since = time.time() - STATE.get("last_rejoin_attempt", 0.0)
        if not force and since < cooldown:
            log(f"ข้าม Rejoin (cooldown {cooldown - since:.0f}s)", YELLOW)
            return False
        STATE["last_rejoin_attempt"] = time.time()
        STATE["rejoin_started"] = time.time()

        add_history("Rejoin", reason)

        hard = max(5, int(CFG.get("join_wait_seconds", 35))) + REJOIN_HARD_TIMEOUT_EXTRA
        try:
            ok = await asyncio.wait_for(join_roblox_async(CFG), timeout=hard)
        except asyncio.TimeoutError:
            log("❌ Rejoin ค้างเกินเวลา ยกเลิกรอบนี้ (จะลองใหม่)", RED, force_redraw=True)
            ok = False
        if ok:
            now = time.time()
            STATE["game_start_time"] = now
            STATE["last_ram_clear"] = now
            STATE["last_screenshot"] = now
            STATE["last_successful_rejoin"] = now
            STATE["last_auto_rejoin"] = now
            STATE["rejoin_total"] += 1
            STATE["frozen_count"] = 0
            STATE["last_frame_sig"] = None
            STATE["bg_count"] = 0
            STATE["cpu_last"] = None
            STATE["hang_count"] = 0
            STATE["key_hits"] = 0
            STATE["key_active"] = False
            STATE["last_key_alert"] = 0.0
            await delete_key_messages()

    touch_heartbeat()

    if ok:
        try:
            healthy, health_reason = await asyncio.wait_for(
                asyncio.get_running_loop().run_in_executor(ROOT_POOL, analyze_game_health, CFG),
                timeout=90)
        except Exception as e:
            logger.warning(f"ตรวจสุขภาพหลัง Rejoin เกินเวลา/ผิดพลาด: {e!r}")
            healthy, health_reason = True, "ข้ามการตรวจหลังเข้าเกม"
        touch_heartbeat()
        if not healthy:
            log(f"พบปัญหาหลังเข้าเกม: {health_reason}", RED)
            add_history("Rejoin Failed", health_reason)
            if channel:
                await send_bot_report(channel, f"⚠️ **เข้าเกมแล้วติดปัญหาทันที:** {health_reason}", True)
            return False
        log("เข้าแมพสำเร็จ", GREEN, force_redraw=True)
    else:
        log("❌ Rejoin ล้มเหลว", RED, force_redraw=True)
        add_history("Rejoin Failed", reason)

    if channel:
        await send_bot_report(channel, done_message if ok else "❌ Rejoin ไม่สำเร็จ", True)
    touch_heartbeat()
    return ok

