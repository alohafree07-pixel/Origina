# ================= ตั้งค่าสีหน้าจอ =================
CYAN = "\033[96m"
BRIGHT_CYAN = "\033[1;96m"
BOLD_WHITE = "\033[1;97m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
RESET = "\033[0m"

CONFIG_FILE = "original_config.json"
PACKAGE_NAME = "com.roblox.client"

DEFAULT_CONFIG = {
    "place_id": "",
    "vip_link_code": "",
    "webhook_url": "",
    "screenshot_minutes": 10,
    "check_interval": 15,
    "freeze_limit": 3
}

# ================= ฟังก์ชันแก้บัคพิมพ์ข้าม/Enter เบิ้ล =================
def safe_input(prompt_text):
    """ ล้างค่าที่ค้างในคีย์บอร์ด Termux ก่อนถามคำถามใหม่ """
    try:
        import termios
        # เคลียร์ปุ่มที่ถูกกดค้างไว้ก่อนหน้านี้ทิ้งให้หมด
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    except Exception:
        pass
    
    time.sleep(0.1) # หน่วงเวลาให้ระบบเคลียร์ค่าเสร็จ
    
    try:
        return input(prompt_text).strip()
    except EOFError:
        return ""

# ================= จัดการการตั้งค่าและคำสั่ง Root =================
def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                for k, v in DEFAULT_CONFIG.items():
                    if k not in data:
                        data[k] = v
                return data
        except Exception:
            return DEFAULT_CONFIG.copy()
    return DEFAULT_CONFIG.copy()

def save_config(cfg):
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)

def log(msg, color=CYAN):
    now = datetime.now().strftime("%H:%M:%S")
    print(f"{color}[{now}] {msg}{RESET}")

def run_root_text(cmd):
    try:
        res = subprocess.run(["su", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
        return res.stdout.strip()
    except Exception:
        return ""

# ================= ระบบแคปหน้าจอและส่ง Webhook =================
def capture_screenshot_bytes():
    try:
        cmd = "screencap -p /sdcard/orig_screen.png && cat /sdcard/orig_screen.png"
        res = subprocess.run(["su", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
        if res.returncode == 0 and res.stdout:
            return res.stdout
    except Exception:
        pass
    return None

def send_webhook_report(cfg, message, include_screenshot=False):
    url = cfg.get("webhook_url", "").strip()
    if not url: return

    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    content = f"🤖 **[ORIGINAL REPORT]** (`{now_str}`)\n📌 **สถานะ:** {message}\n🎮 **Place ID:** `{cfg.get('place_id') or '-'}`"

    try:
        if include_screenshot:
            img_bytes = capture_screenshot_bytes()
            if img_bytes:
                files = {"file": ("screenshot.png", img_bytes, "image/png")}
                data = {"content": content}
                requests.post(url, data=data, files=files, timeout=20)
                log("ส่งรายงานพร้อมรูปแคปหน้าจอเข้า Discord แล้ว", GREEN)
                return
        requests.post(url, json={"content": content}, timeout=15)
        log("ส่งข้อความแจ้งเตือนเข้า Discord แล้ว", GREEN)
    except Exception as e:
        log(f"ส่ง Webhook ไม่สำเร็จ: {e}", RED)

# ================= ระบบตรวจเช็คสถานะเชิงลึก =================
def check_internet_connection():
    res = run_root_text("ping -c 1 -W 3 8.8.8.8")
    return "1 received" in res or "1 packets received" in res

def is_roblox_running():
    pid = run_root_text(f"pidof {PACKAGE_NAME}")
    return bool(pid)

def get_latest_roblox_log():
    cmd = (f"LOG_DIR=/data/data/{PACKAGE_NAME}/files/appData/logs; "
           f"LATEST=$(ls -t $LOG_DIR/*.log 2>/dev/null | head -n 1); "
           f"if [ -n \"$LATEST\" ]; then tail -n 150 \"$LATEST\"; fi")
    return run_root_text(cmd)

def analyze_game_health(cfg, freeze_state):
    target_place_id = str(cfg.get("place_id", "")).strip()

    if not is_roblox_running(): return False, "แอป Roblox ปิดตัวลง (App Crashed / Closed)"

    dumpsys_focus = run_root_text("dumpsys window windows | grep -E 'mCurrentFocus|mFocusedApp'")
    if "Application Not Responding" in dumpsys_focus: return False, "ตัวเกมค้างไม่ตอบสนอง (System ANR)"
    
    # ❌ ลบการเช็คหน้าจอหลุดโฟกัสออกไปแล้ว เพื่อไม่ให้ตีกันกับหน้าต่างของ Executor / Script ❌

    log_text = get_latest_roblox_log()
    if log_text:
        log_lower = log_text.lower()
        if "273" in log_lower and ("same account" in log_lower or "different device" in log_lower or "disconnect" in log_lower):
            return False, "ตรวจพบการเข้าไอดีซ้อนจากเครื่องอื่น! (Error Code: 273)"
        if "error code: 267" in log_lower or "kicked from experience" in log_lower or "you were kicked" in log_lower:
            return False, "ถูกเตะออกจากแมพ (Error Code: 267 / Kicked)"
        if "error code: 268" in log_lower or "unexpected client behavior" in log_lower:
            return False, "เซิร์ฟเวอร์เตะเนื่องจากพฤติกรรมไคลเอนต์ (Error Code: 268)"
        
        disconnect_signals = ["lost connection to the game server", "connection attempt failed", "disconnected from game", "idledisconnect", "error code: 277", "error code: 279"]
        for sig in disconnect_signals:
            if sig in log_lower: return False, f"หลุดออกจากเซิร์ฟเวอร์ ({sig})"

        if "leaving game" in log_lower or "destructing datamodel" in log_lower:
            last_lines = "\n".join(log_lower.splitlines()[-30:])
            if "joining game" not in last_lines and "placeid" not in last_lines:
                return False, "ตัวละครเด้งออกกลับมาหน้าล็อบบี้หลักของ Roblox"

        if target_place_id:
            for line in reversed(log_text.splitlines()):
                if "placeId:" in line or "placeid=" in line.lower():
                    if target_place_id not in line: return False, f"ตรวจพบการอยู่ในแมพอื่นที่ไม่ใช่ Place ID: {target_place_id}"
                    break

    ui_xml = run_root_text("uiautomator dump /sdcard/orig_ui.xml && cat /sdcard/orig_ui.xml")
    if ui_xml:
        ui_lower = ui_xml.lower()
        if "same account" in ui_lower or "273" in ui_lower: return False, "ตรวจพบคนเข้าไอดีซ้อนบนหน้าจอ (Error 273)"
        for kw in ["disconnected", "reconnect", "error code", "ตัดการเชื่อมต่อ", "เชื่อมต่อใหม่", "รหัสข้อผิดพลาด"]:
            if kw in ui_lower: return False, f"ตรวจพบหน้าต่างแจ้งเตือนหลุดออกจากเกม ({kw})"

    img_bytes = capture_screenshot_bytes()
    if img_bytes:
        current_hash = hashlib.md5(img_bytes).hexdigest()
        if current_hash == freeze_state["last_hash"]:
            freeze_state["count"] += 1
            log(f"เตือน: ภาพหน้าจอนิ่งสนิทไม่ขยับ ({freeze_state['count']}/{cfg['freeze_limit']})", YELLOW)
            if freeze_state["count"] >= cfg["freeze_limit"]:
                freeze_state["count"] = 0
                return False, "ภาพหน้าจอเกมค้างนิ่งสนิทเกินเวลาที่กำหนด (Game Frozen)"
        else:
            freeze_state["last_hash"] = current_hash
            freeze_state["count"] = 0

    return True, "ปกติ"

