def safe_input(prompt_text, secret=False):
    fix_tty()
    try:
        import termios
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    except Exception:
        pass
    time.sleep(0.1)
    try:
        value = getpass.getpass(prompt_text) if secret else input(prompt_text)
        return value.strip()
    except EOFError:
        return ""

