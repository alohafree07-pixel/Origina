        if len(msg) > 1950:
            msg = msg[:1950] + "\n... (ตัดข้อความ)"
        await interaction.followup.send(msg)

    @discord.ui.button(label="🗑️ Clear History", style=discord.ButtonStyle.secondary, row=4, custom_id="btn_clear_history")
    async def btn_clear_history(self, interaction, button):
        count = len(REJOIN_HISTORY)
        REJOIN_HISTORY.clear()
        save_history()
        log(f"ล้างประวัติ {count} รายการ", YELLOW)
        add_history("History Cleared", f"โดย {interaction.user.name} ({count} รายการ)")
        await interaction.response.send_message(f"🗑️ ล้างประวัติ {count} รายการแล้ว", delete_after=30)

# ================= Start Bot Loop =================
def menu_3_start_bot(cfg):
    global DASHBOARD_ACTIVE, LAST_RESULT_TEXT

    if not cfg['place_id'] or not cfg['bot_token'] or not cfg['channel_id']:
        print(f"\n{RED}✘ กรุณาตั้งค่า Place ID, Bot Token, Channel ID ก่อน!{RESET}")
        time.sleep(2)
        return
    if not cfg['allowed_users']:
        print(f"\n{RED}✘ ยังไม่ได้ตั้งค่า Discord User ID (เมนู 2){RESET}")
        time.sleep(3)
        return

    subprocess.run(["termux-wake-lock"], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    STATE["dev_name"] = run_root_text("getprop ro.product.model") or "Android Device"
    load_history()
    add_history("Bot Start", "เริ่มระบบเฝ้าจอ")

    now = time.time()
    STATE.update({
        "paused": False, "last_screenshot": now, "last_ram_clear": now,
        "game_start_time": now, "fail_count": 0, "loop_restarts": 0,
        "net_dropped": False, "last_rejoin_attempt": 0.0, "lock": None,
        "last_frame_sig": None, "frozen_count": 0, "bg_count": 0,
        "check_count": 0, "discord_offline_since": 0.0, "rejoin_per_user": {},
        "last_heartbeat": now, "bot_unresponsive": False,
        "last_successful_rejoin": 0.0, "last_auto_rejoin": now,
    })
    _NET_CACHE_UNTIL[0] = 0.0

    LAST_RESULT_TEXT = f"{YELLOW}⏳ กำลังเชื่อมต่อ Discord...{RESET}"
    DASHBOARD_ACTIVE = True
    print_bot_dashboard()

    intents = discord.Intents.default()
    bot = commands.Bot(command_prefix="!", intents=intents)
    ready_once = {"done": False}

    @tasks.loop(seconds=max(5, int(cfg['check_interval'])))
    async def game_monitor_loop():
        try:
            STATE["last_heartbeat"] = time.time()
            STATE["bot_unresponsive"] = False

            if STATE["paused"] or (STATE["lock"] and STATE["lock"].locked()):
                return

            channel = bot.get_channel(int(cfg['channel_id']))

            await check_discord_health(bot, channel)   # ✅ FIX: pass bot

            if not await check_internet():
                if not STATE["net_dropped"]:
                    add_history("Net Drop", "ตรวจพบเน็ตหลุด")
                STATE["net_dropped"] = True
                log("⚠️ เน็ตหลุด! รอสัญญาณ...", RED, force_redraw=True)
                return

            if STATE.get("net_dropped"):
                STATE["net_dropped"] = False
                add_history("Net Restore", "เน็ตกลับมาเชื่อมต่อ")
                log("🌐 เน็ตกลับมา! Rejoin...", YELLOW, force_redraw=True)
                if channel:
                    await send_bot_report(channel, "🌐 **เน็ตกลับมาแล้ว!** Rejoin...", True)
                await do_rejoin(channel, "✅ Rejoin หลังเน็ตหลุดสำเร็จ", "เน็ตกลับมาเชื่อมต่อ")
                return

            STATE["check_count"] = STATE.get("check_count", 0) + 1
            cycle = STATE["check_count"]
            ui_n = max(1, int(cfg.get("ui_check_every_n", 3)))
            screen_n = max(1, int(cfg.get("screen_check_every_n", 2)))
            want_ui = (cycle % ui_n == 0)
            want_screen = (cycle % screen_n == 0)

            probe = await abatch_root(_build_health_commands(cfg, want_ui), timeout=20)

            healthy, reason = analyze_probe(cfg, probe)
            if healthy:
                healthy, reason = analyze_stall(cfg, probe)

            if healthy and want_screen:
                dialog, sig = await asyncio.to_thread(inspect_screen)
                if dialog:
                    healthy, reason = False, "ตรวจพบกล่อง Disconnected บนหน้าจอ"
                elif sig:
                    if sig == STATE.get("last_frame_sig"):
                        STATE["frozen_count"] = STATE.get("frozen_count", 0) + 1
                    else:
                        STATE["frozen_count"] = 0
                        STATE["last_frame_sig"] = sig

            now = time.time()

            if not healthy:
                log(f"⚠️ {reason}", RED, force_redraw=True)

                if "อัปเดต" in reason or "Upgrade" in reason or "Play Store" in reason:
                    STATE["paused"] = True
                    await aroot(f"am force-stop {PACKAGE_NAME}")
                    add_history("Auto Pause", f"ต้องอัปเดต: {reason}")
                    if channel:
                        await send_bot_report(channel, f"🚨 **หยุดอัตโนมัติ:** {reason}\n👉 *อัปเดตแอปแล้วกด ▶️ Resume*", True)
                    return

                STATE["fail_count"] += 1
                fails = STATE["fail_count"]
                delay = min(30 * (fails - 1), 300)
                msg = f"⚠️ **ปัญหา:** {reason}\n🔄 Rejoin ครั้งที่ {fails}"
                if delay:
                    msg += f" (รอ {delay}s)"
                if fails >= MAX_FAILS_ALERT:
                    msg += "\n🚨 **Rejoin หลายครั้งติด!** ตรวจสอบเครื่อง/ไอดี"
                if channel:
                    await send_bot_report(channel, msg, True)
                if delay:
                    await asyncio.sleep(delay)
                    if STATE["paused"]:
                        return
                await do_rejoin(channel, "✅ **Rejoin สำเร็จ**", f"ตรวจพบปัญหา: {reason}")
                return

            auto_rejoin_hrs = float(cfg.get('auto_rejoin_hours', 0.0))
            if auto_rejoin_hrs > 0 and now - STATE.get("last_auto_rejoin", 0) >= auto_rejoin_hrs * 3600:
                log(f"⏰ ถึงเวลาบังคับรีจอยอัตโนมัติ (รอบละ {auto_rejoin_hrs} ชม.)", YELLOW, force_redraw=True)
                add_history("Auto Rejoin", f"รอบ {auto_rejoin_hrs} ชม.")
                if channel:
                    await send_bot_report(channel, f"⏰ **ถึงเวลาบังคับรีจอยอัตโนมัติ** (รอบละ {auto_rejoin_hrs} ชม.)", True)
                await do_rejoin(channel, "✅ บังคับรีจอยอัตโนมัติสำเร็จ", f"ถึงเวลาบังคับรีจอยอัตโนมัติ ({auto_rejoin_hrs} ชม.)")
                return

            if STATE["fail_count"] and now - STATE["game_start_time"] > 180:
                STATE["fail_count"] = 0

            if now - STATE["last_ram_clear"] >= max(0.1, float(cfg.get('clear_ram_hours', 1))) * 3600:
                await abatch_root({
                    "ram": "sync && echo 3 > /proc/sys/vm/drop_caches",
                })
                await asyncio.to_thread(clear_termux_junk)
                log("เคลียร์ RAM & Termux สำเร็จ", GREEN)
                STATE["last_ram_clear"] = now

            if now - STATE["last_screenshot"] >= max(1, int(cfg['screenshot_minutes'])) * 60:
                log("แคปหน้าจอประจำรอบ", CYAN)
                if channel:
                    await send_bot_report(channel, "รายงานสถานะหน้าจอประจำรอบ", True)
                STATE["last_screenshot"] = now

            STATE["loop_restarts"] = 0

        except Exception as e:
            log(f"🔥 ข้อผิดพลาด: {e}", RED, force_redraw=True)
            raise

    @tasks.loop(seconds=WATCHDOG_INTERVAL)
    async def bot_watchdog():
        if STATE.get("paused") or STATE.get("last_heartbeat", 0) == 0:
            return
        elapsed = time.time() - STATE["last_heartbeat"]
        limit = max(WATCHDOG_TIMEOUT, int(cfg['check_interval']) * 4)
        if elapsed > limit and not STATE.get("bot_unresponsive"):
            STATE["bot_unresponsive"] = True
            log(f"🚨 บอทไม่ตอบสนองมานาน {int(elapsed)} วินาที!", RED, force_redraw=True)
            channel = bot.get_channel(int(cfg['channel_id']))
            if channel:
                await send_bot_report(channel, f"🚨 **บอทไม่ตอบสนอง** (ลูปค้างนาน {int(elapsed)} วินาที)", force_new=True)

    @game_monitor_loop.before_loop
    async def before_game_monitor():
        await bot.wait_until_ready()

    @bot_watchdog.before_loop
    async def before_watchdog():
        await bot.wait_until_ready()

    @game_monitor_loop.error
    async def game_monitor_error(error):
        STATE["loop_restarts"] += 1
        log(f"🚨 ลูปพัง ({STATE['loop_restarts']}/{MAX_LOOP_RESTARTS})", RED, force_redraw=True)
        if STATE["loop_restarts"] > MAX_LOOP_RESTARTS:
            log("❌ หยุดรีสตาร์ทลูป", RED, force_redraw=True)
            return
        await asyncio.sleep(5)
        game_monitor_loop.restart()

    @bot.event
    async def on_disconnect():
        if STATE.get("discord_offline_since", 0) == 0:
            STATE["discord_offline_since"] = time.time()
            log("🔌 Discord หลุด (event)", RED, force_redraw=True)

    @bot.event
    async def on_ready():
        log(f"✅ เชื่อมต่อ {bot.user.name} สำเร็จ!", GREEN, force_redraw=True)
        if ready_once["done"]:
            since = STATE.get("discord_offline_since", 0)
            if since > 0:
                STATE["discord_offline_since"] = 0
                dur = time.time() - since
                if dur >= DISCORD_OFFLINE_THRESHOLD:
                    channel = bot.get_channel(int(cfg['channel_id']))
                    if channel:
                        await send_reconnect_alert(channel, dur)
            return
        ready_once["done"] = True

        if STATE["lock"] is None:
            STATE["lock"] = asyncio.Lock()
        bot.add_view(ControlView(sync_buttons=False))

        channel = bot.get_channel(int(cfg['channel_id']))
        if channel:
            await send_bot_report(channel, "🟢 เริ่มเดินระบบเฝ้าจอ Auto Rejoin แล้ว!")
        else:
            log("⚠️ หา Channel ไม่เจอ", RED)

        if not await aroot(f"pidof {PACKAGE_NAME}"):
            log("เปิดเกมเข้าแมพครั้งแรก...", CYAN, force_redraw=True)
            await do_rejoin(channel, "✅ เข้าแมพครั้งแรกเรียบร้อย", "เริ่มระบบครั้งแรก")

        if not game_monitor_loop.is_running():
            game_monitor_loop.start()
        if not bot_watchdog.is_running():
            bot_watchdog.start()

    try:
        bot.run(cfg['bot_token'], log_handler=None)
    except discord.LoginFailure:
        DASHBOARD_ACTIVE = False
        fix_tty()
        print(f"\n{RED}❌ Bot Token ไม่ถูกต้อง!{RESET}")
        time.sleep(2)
        return
    except KeyboardInterrupt:
        pass

    DASHBOARD_ACTIVE = False
    fix_tty()
    subprocess.run(["termux-wake-unlock"], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    add_history("Bot Stop", "ปิดระบบ")
    print(f"\n\n{YELLOW}🛑 ปิดบอท (Offline){RESET}")
    ans = safe_input("บังคับปิด Roblox ด้วยไหม? (y/n): ").lower()
    if ans == 'y':
        run_root_text(f"am force-stop {PACKAGE_NAME}")
    time.sleep(1)

