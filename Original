def _log(tag: str, color: str, msg: str) -> None:
    ts = datetime.now().strftime("%H:%M:%S")
    print(f"{color}[{tag}]{RESET} {WHITE}{ts}{RESET} {msg}", flush=True)

def info(msg: str)  -> None: _log("INFO",  BRIGHT_CYAN, msg)
def ok(msg: str)    -> None: _log("OK",    GREEN,       msg)
def warn(msg: str)  -> None: _log("WARN",  YELLOW,      msg)
def error(msg: str) -> None: _log("ERR",   RED,         msg)


