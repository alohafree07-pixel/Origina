# ================= Core Root =================
def batch_root(commands: dict, timeout=ROOT_TIMEOUT_DEFAULT) -> dict:
    if not commands:
        return {}
    parts = []
    for key, cmd in commands.items():
        parts.append(f'echo "<<B:{key}>>"')
        parts.append(cmd)
        parts.append(f'echo "<<E:{key}>>"')
    script = " ; ".join(parts)
    try:
        res = subprocess.run(
            ["su", "-c", script],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
            errors="replace"
        )
        output = res.stdout or ""
    except Exception as e:
        logger.warning(f"batch_root ผิดพลาด: {e}")
        return {k: "" for k in commands}

    results = {}
    for key in commands:
        begin = f"<<B:{key}>>"
        end = f"<<E:{key}>>"
        try:
            s = output.index(begin) + len(begin)
            e = output.index(end, s)
            results[key] = output[s:e].strip()
        except ValueError:
            results[key] = ""
    return results

async def abatch_root(commands: dict, timeout=ROOT_TIMEOUT_DEFAULT) -> dict:
    return await asyncio.to_thread(batch_root, commands, timeout)

def run_root_text(cmd, timeout=ROOT_TIMEOUT_DEFAULT):
    try:
        res = subprocess.run(
