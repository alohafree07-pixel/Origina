def fix_tty():
    try:
        import termios
        fd = sys.stdout.fileno()
        attrs = termios.tcgetattr(fd)
        attrs[1] |= termios.ONLCR | termios.OPOST
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
    except Exception:
        pass

def trim_visible(text, max_vis=26):
    vis = 0
    out = []
    for ch in str(text):
        if ch in THAI_COMBINING:
            out.append(ch)
            continue
        w = 2 if ord(ch) > 0x1F000 else 1
        if vis + w > max_vis:
            out.append("..")
            break
        vis += w
        out.append(ch)
    return "".join(out)

