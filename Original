# ================= System Stats =================
def get_discord_embed(dev_name, is_paused):
    try:
        with open("/proc/stat", "r") as f:
            s1 = [int(i) for i in f.readline().split()[1:8]]
        time.sleep(0.15)
        with open("/proc/stat", "r") as f:
            s2 = [int(i) for i in f.readline().split()[1:8]]
        t1, t2 = sum(s1), sum(s2)
        i1, i2 = s1[3] + s1[4], s2[3] + s2[4]
        cpu_usage = round(100 * ((t2 - t1) - (i2 - i1)) / (t2 - t1), 2) if t2 - t1 > 0 else 0
    except Exception:
        cpu_usage = 0

    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
        mem_total = mem_avail = 0
        for l in lines:
            if l.startswith("MemTotal:"):
                mem_total = int(l.split()[1])
            elif l.startswith("MemAvailable:"):
                mem_avail = int(l.split()[1])
        mem_total_gb = round(mem_total / (1024 * 1024), 2)
        mem_avail_pct = round((mem_avail / mem_total) * 100, 2) if mem_total > 0 else 0
        mem_usage_pct = round(100 - mem_avail_pct, 2)
    except Exception:
        mem_total_gb = mem_avail_pct = mem_usage_pct = 0

    try:
        with open("/proc/uptime", "r") as f:
            up_sec = float(f.readline().split()[0])
        uptime_hrs = round(up_sec / 3600, 2)
    except Exception:
        uptime_hrs = 0

    status_color = 0xf1c40f if is_paused else 0x3498db
    embed = discord.Embed(color=status_color)
    embed.add_field(name="🔹 Device Name", value=f"`{dev_name}`", inline=True)
    embed.add_field(name="⚙️ CPU Usage", value=f"`{cpu_usage}%`", inline=True)
    embed.add_field(name="💾 Memory Usage", value=f"`{mem_usage_pct}%`", inline=True)
    embed.add_field(name="💾 Memory Available", value=f"`{mem_avail_pct}%`", inline=True)
    embed.add_field(name="💡 Total Memory", value=f"`{mem_total_gb} GB`", inline=True)
    embed.add_field(name="⏰ Uptime", value=f"`{uptime_hrs} hours`", inline=True)
    return embed

