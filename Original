def migrate_legacy_files():
    """ย้ายไฟล์ตั้งค่า/ประวัติของเวอร์ชันเก่าเข้าโฟลเดอร์ข้อมูล (ไม่ทับไฟล์ใหม่ที่มีอยู่แล้ว)"""
    moved = []
    for old, new in LEGACY_FILES.items():
        dst = os.path.join(DATA_DIR, new)
        if os.path.exists(dst):
            continue
        for src_dir in dict.fromkeys((_script_dir(), os.getcwd())):
            src = os.path.join(src_dir, old)
            if os.path.isfile(src):
                try:
                    shutil.move(src, dst)
                    moved.append(old)
                    break
                except OSError:
                    continue
    return moved

