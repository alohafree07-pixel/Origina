"""


def main() -> None:
    args = sys.argv[1:]

    if "--help" in args or "-h" in args:
        print(HELP_TEXT)
        return

    if "--run-service" in args:
        run_bot_foreground(service_mode=True)
        return

    if "--foreground" in args:
        info("รันแบบ foreground (Ctrl+C เพื่อหยุด)")
        run_bot_foreground(service_mode=False)
        return

    if "--status" in args:
        show_status()
        return

    if "--stop" in args:
        stop_service()
        ok("หยุด service แล้ว")
        return

    if "--restart" in args:
        if restart_service():
            ok("restart สำเร็จ")
        else:
            error("restart ไม่สำเร็จ — ดู: sv status " + SERVICE_NAME)
        return

    if "--uninstall" in args:
        uninstall_service()
        return

    # ─── default: install + start ───
    print(f"{BRIGHT_CYAN}╔══════════════════════════════════════════════════╗{RESET}")
    print(f"{BRIGHT_CYAN}║   Discord Bot — Termux Installer                 ║{RESET}")
    print(f"{BRIGHT_CYAN}╚══════════════════════════════════════════════════╝{RESET}")
    print()

    if not IS_TERMUX:
        warn("ไม่ได้รันบน Termux → เข้าโหมด foreground")
        run_bot_foreground(service_mode=False)
        return

    # ตรวจ token ก่อน
    token = load_token(interactive=True)
    if not token:
        error("ไม่มี token — ยกเลิกการติดตั้ง")
        sys.exit(1)

    # ติดตั้ง service (ถ้ายังไม่มี)
    if not is_installed():
        if not install_service():
            error("ติดตั้ง service ล้มเหลว")
            sys.exit(1)
    else:
        ok("service ติดตั้งอยู่แล้ว")

    # เริ่ม/restart
    info("เริ่ม service...")
    if is_running():
        restart_service()
    else:
        start_service()

    print()
    if is_running():
        print(f"{BRIGHT_GREEN}╔══════════════════════════════════════════════════╗{RESET}")
        print(f"{BRIGHT_GREEN}║   🎉 บอทกำลังทำงานเบื้องหลัง!                    ║{RESET}")
        print(f"{BRIGHT_GREEN}╚══════════════════════════════════════════════════╝{RESET}")
        print()
        print(f"   {CYAN}ดูสถานะ:{RESET}   python {SCRIPT_PATH.name} --status")
        print(f"   {CYAN}ดู log :{RESET}   tail -f {LOG_DIR / 'current'}")
        print(f"   {CYAN}หยุด  :{RESET}   python {SCRIPT_PATH.name} --stop")
        print(f"   {CYAN}ลบ     :{RESET}   python {SCRIPT_PATH.name} --uninstall")
    else:
        error("service ไม่ทำงาน — ดู log:")
        print(f"   tail -n 30 {LOG_DIR / 'current'}")


if __name__ == "__main__":
    main()
