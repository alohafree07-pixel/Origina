# ================= Core Root =================
# pool แยกสำหรับงาน root (ไม่ไปแย่ง default executor ของ discord.py/asyncio)
ROOT_POOL = ThreadPoolExecutor(max_workers=16, thread_name_prefix="root")
TIMEOUT_BIN = [False]   # เครื่องมีคำสั่ง `timeout` ฝั่ง root ไหม (ตรวจตอนเริ่มบอท)

def _t(seconds, cmd):
    """ครอบคำสั่งที่เสี่ยงค้าง (dumpsys/uiautomator/screencap) ด้วย timeout ฝั่ง root
    ไม่ให้มีโพรเซสค้างสะสมในเครื่องเวลารันนาน ๆ"""
    return f"timeout {int(seconds)} {cmd}" if TIMEOUT_BIN[0] else cmd

def _kill_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass

def _su_exec(cmd, timeout, want_stderr=False):
    """รัน `su -c cmd` และ "ฆ่าทั้ง process group" เมื่อ timeout
    (subprocess.run ธรรมดาอาจค้างถาวรถ้ามีลูกหลานถือ pipe อยู่)
    คืน (returncode, stdout_bytes, stderr_bytes) / raise TimeoutExpired เมื่อเกินเวลา"""
    proc = subprocess.Popen(
        ["su", "-c", cmd],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE if want_stderr else subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        _kill_group(proc)
        try:
            proc.communicate(timeout=3)
        except Exception:
            for p in (proc.stdout, proc.stderr):
                try:
                    if p:
                        p.close()
                except Exception:
                    pass
            try:
                proc.wait(timeout=1)
            except Exception:
                pass
        raise
    return proc.returncode, out or b"", err or b""

def batch_root(commands_map: dict, timeout=ROOT_TIMEOUT_DEFAULT) -> dict:
    if not commands_map:
        return {}
    parts = []
    for key, cmd in commands_map.items():
        parts.append(f'echo "<<B:{key}>>"')
        parts.append(cmd)
        parts.append(f'echo "<<E:{key}>>"')
    script = " ; ".join(parts)
    try:
        _, out, _ = _su_exec(script, timeout)
        output = out.decode("utf-8", errors="replace")
    except Exception as e:
        logger.warning(f"batch_root ผิดพลาด: {e}")
        return {k: "" for k in commands_map}

    results = {}
    for key in commands_map:
        begin = f"<<B:{key}>>"
        end = f"<<E:{key}>>"
        try:
            s = output.index(begin) + len(begin)
            e = output.index(end, s)
            results[key] = output[s:e].strip()
        except ValueError:
            results[key] = ""
    return results

async def _run_pool(fn, *args, hard_timeout):
    """รันงานบล็อกใน ROOT_POOL พร้อมเพดานเวลาฝั่ง asyncio (กัน await ค้างตลอดไป)"""
    loop = asyncio.get_running_loop()
    return await asyncio.wait_for(
        loop.run_in_executor(ROOT_POOL, lambda: fn(*args)), timeout=hard_timeout)

async def abatch_root(commands_map: dict, timeout=ROOT_TIMEOUT_DEFAULT) -> dict:
    try:
        return await _run_pool(batch_root, commands_map, timeout, hard_timeout=timeout + 10)
    except Exception as e:
        logger.warning(f"abatch_root เกินเวลา/ผิดพลาด: {e!r}")
        return {k: "" for k in commands_map}

def run_root_text(cmd, timeout=ROOT_TIMEOUT_DEFAULT):
    try:
        _, out, _ = _su_exec(cmd, timeout)
        return out.decode("utf-8", errors="replace").strip()
    except Exception as e:
        logger.warning(f"run_root_text ผิดพลาด: {e}")
        return ""

async def aroot(cmd, timeout=ROOT_TIMEOUT_DEFAULT):
    try:
        return await _run_pool(run_root_text, cmd, timeout, hard_timeout=timeout + 10)
    except Exception as e:
        logger.warning(f"aroot เกินเวลา/ผิดพลาด: {e!r}")
        return ""

