def grab_raw_frame():
    try:
        _, buf, _ = _su_exec(_t(12, "screencap"), 15)
    except Exception:
        return None
    if not buf or len(buf) < 100000:
        return None
    w = int.from_bytes(buf[0:4], "little")
    h = int.from_bytes(buf[4:8], "little")
    fmt = int.from_bytes(buf[8:12], "little")
    if w <= 0 or h <= 0 or w > 10000 or h > 10000 or fmt not in (1, 2):
        return None
    expected = w * h * 4
    if len(buf) < expected + 12:
        return None
    hdr = len(buf) - expected
    if hdr not in (12, 16):
        hdr = 12
    return buf, w, h, hdr

_SIG_OFFSET_CACHE = {}

def _get_sig_offsets(w, h, hdr):
    key = (w, h, hdr)
    cached = _SIG_OFFSET_CACHE.get(key)
    if cached is not None:
        return cached
    offsets = []
    for j in range(24):
        py = int(h * (j + 0.5) / 24)
        for i in range(14):
            px = int(w * (i + 0.5) / 14)
            offsets.append(hdr + (py * w + px) * 4)
    _SIG_OFFSET_CACHE[key] = offsets
    return offsets

def frame_signature(frame):
    buf, w, h, hdr = frame
    offsets = _get_sig_offsets(w, h, hdr)
    sig = bytearray(len(offsets) * 3)
    idx = 0
    for off in offsets:
        sig[idx] = buf[off] >> 4
        sig[idx + 1] = buf[off + 1] >> 4
        sig[idx + 2] = buf[off + 2] >> 4
        idx += 3
    return hashlib.md5(bytes(sig)).hexdigest()

def _is_key_panel_bg(r, g, b):
    return (14 <= r <= 42 and 16 <= g <= 48 and 24 <= b <= 60
            and b - r >= 6 and b >= g)

def _is_key_button_blue(r, g, b):
    return b >= 225 and g >= 170 and r <= 175 and (b - r) >= 70

def detect_key_panel(buf, w, h, hdr):
    try:
        def px(x, y):
            i = hdr + (y * w + x) * 4
            return buf[i], buf[i + 1], buf[i + 2]

        xs = [min(w - 1, int(w * (0.72 + 0.26 * i / 15))) for i in range(16)]
        ys = [min(h - 1, int(h * (0.06 + 0.88 * j / 19))) for j in range(20)]
        hit = 0
        for y in ys:
            for x in xs:
                if _is_key_panel_bg(*px(x, y)):
                    hit += 1
        if hit < 0.45 * len(xs) * len(ys):
            return False

        step = max(2, w // 400)
        blue = 0
        for y in range(int(h * 0.42), int(h * 0.62), step):
            for x in range(int(w * 0.74), int(w * 0.95), step):
                if _is_key_button_blue(*px(x, y)):
                    blue += 1
        return blue >= 12
    except Exception as e:
        logger.warning(f"detect_key_panel ผิดพลาด: {e}")
        return False

def key_panel_in_ui(ui_xml):
