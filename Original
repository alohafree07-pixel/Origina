def add_history(action, reason="", extra=None):
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    entry = {"time": now_str, "action": action, "reason": reason}
    if extra:
        entry.update(extra)
    REJOIN_HISTORY.append(entry)
    if len(REJOIN_HISTORY) > MAX_HISTORY_RECORDS:
        REJOIN_HISTORY.pop(0)
    save_history()

