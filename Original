        save_config(cfg)

    if not has_root():
        ui_err("ใช้ root (su) ไม่ได้ — ตรวจสอบสิทธิ์ root ของ Termux ก่อน")
        time.sleep(3)
        return
    ui_ok("root พร้อมใช้งาน")
    time.sleep(1.2)

    channel_id = int(cfg['channel_id']) if use_discord else 0

    TIMEOUT_BIN[0] = bool(run_root_text("command -v timeout", timeout=10))
    if cfg.get("device_tweaks", True):
        run_root_text(
            "dumpsys deviceidle whitelist +com.termux >/dev/null 2>&1; "
            "settings put global settings_enable_monitor_phantom_procs false >/dev/null 2>&1; "
            "device_config put activity_manager max_phantom_processes 2147483647 >/dev/null 2>&1; "
            "svc power stayon true >/dev/null 2>&1; true", timeout=20)

    try:
        subprocess.run(["termux-wake-lock"], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    STATE["dev_name"] = run_root_text("getprop ro.product.model") or "Android Device"
    load_history()
    add_history("Bot Start", "เริ่มระบบเฝ้าจอ")

    now = time.time()
    STATE.update({
        "paused": False, "last_screenshot": now, "last_ram_clear": now,
        "game_start_time": now, "fail_count": 0, "loop_restarts": 0,
        "net_dropped": False, "last_rejoin_attempt": 0.0, "lock": None,
        "last_frame_sig": None, "frozen_count": 0, "bg_count": 0,
        "check_count": 0, "discord_offline_since": 0.0, "rejoin_per_user": {},
        "last_heartbeat": now, "bot_unresponsive": False, "probe_fail": 0,
        "last_successful_rejoin": 0.0, "last_auto_rejoin": now,
        "auto_paused": False, "auto_paused_at": 0.0, "rejoin_started": 0.0,
        "key_hits": 0, "key_active": False, "key_since": 0.0, "last_key_alert": 0.0,
        "key_msgs": [], "hang_count": 0, "cpu_last": None,
        "mode_discord": use_discord, "session_start": now,
    })
    reset_dash_state()
    _NET_CACHE_UNTIL[0] = 0.0

    LAST_RESULT_TEXT = (f"{YELLOW}⏳ กำลังเชื่อมต่อ Discord...{RESET}" if use_discord
                        else f"{YELLOW}⏳ เริ่มโหมดไม่ใช้ Discord...{RESET}")
    _DASH_FIRST[0] = True
    DASHBOARD_ACTIVE = True
    print_bot_dashboard()

    bot = None
    if use_discord:
        intents = discord.Intents.default()
        bot = commands.Bot(command_prefix="!", intents=intents)
    ready_once = {"done": False}

    def get_channel():
        return bot.get_channel(channel_id) if bot else None

    async def hb_sleep(seconds):
        end = time.time() + seconds
        while time.time() < end:
            if STATE["paused"]:
                return
            touch_heartbeat()
            await asyncio.sleep(min(5, max(0.1, end - time.time())))

    async def monitor_cycle():
        if STATE["paused"]:
            if STATE.get("auto_paused") and time.time() - STATE.get("auto_paused_at", 0) >= FATAL_RETRY_SECONDS:
                STATE.update({"paused": False, "auto_paused": False, "fail_count": 0})
                add_history("Auto Resume", "ลองใหม่หลังหยุดอัตโนมัติ (เผื่ออัปเดตแล้ว)")
                log("▶️ ลองเดินระบบต่ออัตโนมัติ", YELLOW, force_redraw=True)
            else:
                return
        if _rejoin_in_progress():
            return

        channel = get_channel()

        if not await check_internet():
            if not STATE["net_dropped"]:
                add_history("Net Drop", "ตรวจพบเน็ตหลุด")
            STATE["net_dropped"] = True
            log("⚠️ เน็ตหลุด! รอสัญญาณ...", RED, force_redraw=True)
            return

        if STATE.get("net_dropped"):
            STATE["net_dropped"] = False
            add_history("Net Restore", "เน็ตกลับมาเชื่อมต่อ")
            log("🌐 เน็ตกลับมา! Rejoin...", YELLOW, force_redraw=True)
            if channel:
                await send_bot_report(channel, "🌐 **เน็ตกลับมาแล้ว!** Rejoin...", True)
            await do_rejoin(channel, "✅ Rejoin หลังเน็ตหลุดสำเร็จ", "เน็ตกลับมาเชื่อมต่อ", force=True)
            return

        STATE["check_count"] = STATE.get("check_count", 0) + 1
        cycle = STATE["check_count"]
        ui_n = max(1, int(cfg.get("ui_check_every_n", 3)))
        screen_n = max(1, int(cfg.get("screen_check_every_n", 2)))
        key_on = bool(cfg.get("key_alert_enabled", True))
        want_ui = (cycle % ui_n == 0)
        want_screen = (cycle % screen_n == 0) or (key_on and STATE.get("key_hits", 0) > 0)

        probe = await abatch_root(_build_health_commands(cfg, want_ui), timeout=20)
        touch_heartbeat()

        if not probe_ok(probe):
            STATE["probe_fail"] += 1
            log(f"⚠️ ติดต่อ root ไม่ได้ ({STATE['probe_fail']}) ข้ามรอบตรวจ", YELLOW)
            if STATE["probe_fail"] == PROBE_FAIL_ALERT and channel:
                await send_bot_report(channel, "🔒 **ติดต่อ root (su) ไม่ได้ต่อเนื่อง** ระบบจึงข้ามการตรวจ/Rejoin")
            return
        STATE["probe_fail"] = 0

        wake = probe.get("wake", "")
        if "Asleep" in wake or "Dozing" in wake:
            log("📴 จอดับ/เครื่องหลับ → ปลุกเครื่อง", YELLOW)
            await aroot("input keyevent KEYCODE_WAKEUP; wm dismiss-keyguard 2>/dev/null; true")

        healthy, reason = analyze_probe(cfg, probe)
        if healthy:
            healthy, reason = analyze_stall(cfg, probe)

        screen_checked = False
        key_screen = False
        if healthy and want_screen:
            dialog, sig, key_screen = await asyncio.to_thread(inspect_screen)
            screen_checked = True
            if dialog:
                healthy, reason = False, "ตรวจพบกล่อง Disconnected บนหน้าจอ"
            else:
                update_frozen_state(sig)
            touch_heartbeat()

        if key_on:
            key_seen = key_screen or key_panel_in_ui(probe.get("ui_xml", ""))
            await handle_key_panel(channel, key_seen, can_clear=screen_checked)
            touch_heartbeat()

        now = time.time()

        if not healthy:
            log(f"⚠️ {reason}", RED, force_redraw=True)

            if reason == REASON_LOBBY:
                await hb_sleep(8)
                p2 = await abatch_root(_build_health_commands(cfg, True), timeout=20)
                if not probe_ok(p2) or analyze_probe(cfg, p2)[1] != REASON_LOBBY:
                    log("ไม่ยืนยันอาการหลุดมาหน้าเมนู ข้ามรอบนี้", YELLOW)
                    return

            if reason in FATAL_REASONS:
                for _ in range(FATAL_CONFIRM - 1):
                    await hb_sleep(20)
                    p2 = await abatch_root(_build_health_commands(cfg, True), timeout=20)
                    r2 = analyze_probe(cfg, p2)[1] if probe_ok(p2) else None
                    if r2 != reason:
                        log("ไม่ยืนยันอาการ 'ต้องอัปเดต' (น่าจะเป็นป๊อปอัปชั่วคราว) ข้ามรอบนี้", YELLOW)
                        return
                STATE["paused"] = True
                STATE["auto_paused"] = True
                STATE["auto_paused_at"] = time.time()
                await aroot(f"am force-stop {PACKAGE_NAME}")
                add_history("Auto Pause", f"ต้องอัปเดต: {reason}")
                if channel:
                    await send_bot_report(
                        channel,
                        f"🚨 **หยุดอัตโนมัติ:** {reason}\n👉 *อัปเดตแอปแล้วกด ▶️ Resume "
                        f"(หรือรอ — บอทจะลองใหม่เองใน {FATAL_RETRY_SECONDS // 60} นาที)*", True)
                return

            STATE["fail_count"] += 1
            fails = STATE["fail_count"]
            delay = min(30 * (fails - 1), 300)
            msg = f"⚠️ **ปัญหา:** {reason}\n🔄 Rejoin ครั้งที่ {fails}"
            if delay:
                msg += f" (รอ {delay}s)"
            if fails >= MAX_FAILS_ALERT:
                msg += "\n🚨 **Rejoin หลายครั้งติด!** ตรวจสอบเครื่อง/ไอดี"
            if channel:
                await send_bot_report(channel, msg, True)
            if delay:
                await hb_sleep(delay)
                if STATE["paused"]:
                    return
            await do_rejoin(channel, "✅ **Rejoin สำเร็จ**", f"ตรวจพบปัญหา: {reason}")
            return

        auto_rejoin_hrs = float(cfg.get('auto_rejoin_hours', 0.0))
        if auto_rejoin_hrs > 0 and now - STATE.get("last_auto_rejoin", 0) >= auto_rejoin_hrs * 3600:
            log(f"⏰ ถึงเวลาบังคับรีจอยอัตโนมัติ (รอบละ {auto_rejoin_hrs} ชม.)", YELLOW, force_redraw=True)
            add_history("Auto Rejoin", f"รอบ {auto_rejoin_hrs} ชม.")
            if channel:
                await send_bot_report(channel, f"⏰ **ถึงเวลาบังคับรีจอยอัตโนมัติ** (รอบละ {auto_rejoin_hrs} ชม.)", True)
            await do_rejoin(channel, "✅ บังคับรีจอยอัตโนมัติสำเร็จ",
                            f"ถึงเวลาบังคับรีจอยอัตโนมัติ ({auto_rejoin_hrs} ชม.)", force=True)
            return

        if STATE["fail_count"] and now - STATE["game_start_time"] > 180:
            STATE["fail_count"] = 0

        if now - STATE["last_ram_clear"] >= max(0.1, float(cfg.get('clear_ram_hours', 1))) * 3600:
            await abatch_root({"ram": "sync && echo 3 > /proc/sys/vm/drop_caches"})
            await asyncio.to_thread(clear_termux_junk)
            log("เคลียร์ RAM & Termux สำเร็จ", GREEN)
            STATE["last_ram_clear"] = now

        if now - STATE["last_screenshot"] >= max(1, int(cfg['screenshot_minutes'])) * 60:
            log("แคปหน้าจอประจำรอบ", CYAN)
            if channel:
                await send_bot_report(channel, "รายงานสถานะหน้าจอประจำรอบ", True)
            STATE["last_screenshot"] = now

    @tasks.loop(seconds=max(5, int(cfg['check_interval'])))
    async def game_monitor_loop():
        touch_heartbeat()
        try:
            if bot:
                await check_discord_health(bot, get_channel())
            await asyncio.wait_for(monitor_cycle(), timeout=MONITOR_CYCLE_TIMEOUT)
            STATE["loop_restarts"] = 0
        except Exception as e:
            STATE["loop_restarts"] += 1
            n = STATE["loop_restarts"]
            logger.error("monitor loop error:\n%s", traceback.format_exc())
            log(f"🔥 ข้อผิดพลาดในลูป ({n}/{MAX_LOOP_RESTARTS}): {e!r}", RED, force_redraw=True)
            if n == MAX_LOOP_RESTARTS:
                channel = get_channel()
                if channel:
                    await send_bot_report(channel, f"🚨 **ลูปเฝ้าจอผิดพลาดติดกัน {n} ครั้ง:** `{e!r}`")
            await hb_sleep(min(60, 5 * n))
        touch_heartbeat()

    @tasks.loop(seconds=WATCHDOG_INTERVAL)
    async def bot_watchdog():
        flush_dashboard()
        if STATE.get("paused") or STATE.get("last_heartbeat", 0) == 0:
            return
        if _rejoin_in_progress():
            if time.time() - STATE.get("rejoin_started", 0) < 600:
                return
        elapsed = time.time() - STATE["last_heartbeat"]
        limit = max(WATCHDOG_TIMEOUT, int(cfg['check_interval']) * 4)
        if elapsed > limit and not STATE.get("bot_unresponsive"):
            STATE["bot_unresponsive"] = True
            log(f"🚨 บอทไม่ตอบสนองมานาน {int(elapsed)} วินาที!", RED, force_redraw=True)
            channel = get_channel()
            if channel:
                await send_bot_report(channel, f"🚨 **บอทไม่ตอบสนอง** (ลูปค้างนาน {int(elapsed)} วินาที) — กำลังรีสตาร์ทลูป")
            try:
                game_monitor_loop.restart()
            except Exception as e:
                logger.warning(f"restart loop ไม่สำเร็จ: {e!r}")

    async def wait_ready():
        if bot:
            await bot.wait_until_ready()

    @game_monitor_loop.before_loop
    async def before_game_monitor():
        await wait_ready()

    @bot_watchdog.before_loop
    async def before_watchdog():
        await wait_ready()

    @tasks.loop(seconds=3)
    async def dash_refresh():
        if DASHBOARD_ACTIVE:
            _DASH_DIRTY[0] = False
            _LAST_DASH_RENDER[0] = time.time()
            print_bot_dashboard()

    async def start_services(channel):
        touch_heartbeat()
        if not game_monitor_loop.is_running():
            game_monitor_loop.start()
        if not bot_watchdog.is_running():
            bot_watchdog.start()
        if not dash_refresh.is_running():
            dash_refresh.start()

        if not await aroot(f"pidof {PACKAGE_NAME}"):
            log("เปิดเกมเข้าแมพครั้งแรก...", CYAN, force_redraw=True)
            spawn(do_rejoin(channel, "✅ เข้าแมพครั้งแรกเรียบร้อย", "เริ่มระบบครั้งแรก", force=True))

    if bot:
        @bot.event
        async def on_disconnect():
            if STATE.get("discord_offline_since", 0) == 0:
                STATE["discord_offline_since"] = time.time()
                log("🔌 Discord หลุด (event)", RED, force_redraw=True)

        @bot.event
        async def on_resumed():
            log("🔌 Discord resume สำเร็จ", GREEN)
            await handle_discord_back(get_channel())

        @bot.event
        async def on_ready():
            log(f"✅ เชื่อมต่อ {bot.user.name} สำเร็จ!", GREEN, force_redraw=True)
            if ready_once["done"]:
                await handle_discord_back(get_channel())
                return
            ready_once["done"] = True

            if STATE["lock"] is None:
                STATE["lock"] = asyncio.Lock()
            bot.add_view(ControlView(sync_buttons=False))

            channel = get_channel()
            if channel:
                await send_bot_report(channel, "🟢 เริ่มเดินระบบเฝ้าจอ Auto Rejoin แล้ว!")
            else:
                log("⚠️ หา Channel ไม่เจอ", RED)

            await start_services(channel)

        try:
            bot.run(cfg['bot_token'], log_handler=None)
        except discord.LoginFailure:
            DASHBOARD_ACTIVE = False
            fix_tty()
            ui_err("Bot Token ไม่ถูกต้อง!")
            time.sleep(2)
            return
        except KeyboardInterrupt:
            pass
    else:
        async def standalone_main():
            if STATE["lock"] is None:
                STATE["lock"] = asyncio.Lock()
            log("✅ เริ่มโหมดไม่ใช้ Discord (เฝ้าจอ/Rejoin อย่างเดียว)", GREEN, force_redraw=True)
            await start_services(None)
            await asyncio.Event().wait()

        try:
            asyncio.run(standalone_main())
        except KeyboardInterrupt:
            pass

    DASHBOARD_ACTIVE = False
    fix_tty()
    try:
        subprocess.run(["termux-wake-unlock"], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    add_history("Bot Stop", "ปิดระบบ")
    _out("", f"  {C_WARN}■ ปิดบอทแล้ว (Offline){RESET}")
    ans = ask("บังคับปิด Roblox ด้วยไหม?", " (y/n)").lower()
    if ans == 'y':
        run_root_text(f"am force-stop {PACKAGE_NAME}")
    time.sleep(1)

def wait_device_ready(timeout=180):
    ui_info(f"รอ root และรหัสเครื่องพร้อม (สูงสุด {timeout} วินาที)...")
    end = time.time() + timeout
    while time.time() < end:
        if run_root_text("id -u", timeout=10) == "0":
            _D_RETRY_AT[0] = 0.0
            if _master_key(b"D"):
                return True
        time.sleep(5)
    for p in (CONFIG_FILE, HISTORY_FILE, DASH_FILE):
        try:
            with open(p, "rb") as f:
                if f.read(5) == SEAL_MAGIC + b"D":
                    ui_err("root ยังไม่พร้อม และไฟล์ตั้งค่าผูกกับเครื่อง จึงไม่เปิดบอท (ไม่แตะไฟล์ใด ๆ)")
                    return False
        except OSError:
            pass
    return True

def run_autostart():
    ui_ok("โหมดเริ่มอัตโนมัติ (--autostart)")
    logger.info("autostart: เริ่มระบบ")
    for attempt in range(1, 6):
        try:
            menu_3_start_bot(CFG)
            return
        except Exception as e:
            logger.error("autostart error:\n%s", traceback.format_exc())
            ui_err(f"autostart ผิดพลาด ({attempt}/5): {e!r} — ลองใหม่ใน 30 วินาที")
            time.sleep(30)

def main():
    if "--log" in sys.argv:
        show_log(80)
        return
    service = "--service" in sys.argv
    if service:
        HEADLESS[0] = True
        devnull = open(os.devnull, "w", encoding="utf-8")
        sys.stdout = devnull
        sys.stderr = devnull
        signal.signal(signal.SIGTERM, _sigterm_handler)
    autostart = service or "--autostart" in sys.argv
    if autostart and not wait_device_ready():
        return
    ui_info("กำลังเตรียมระบบเข้ารหัสไฟล์ข้อมูล...")
    if seal_mode_now() == b"F":
        ui_warn("อ่านรหัสเครื่องผ่าน root ไม่ได้ ใช้โหมดสำรอง (ผูกกับ Termux เท่านั้น) — "
                "เปิดโปรแกรมใหม่เมื่อ root พร้อม ไฟล์จะอัปเกรดเป็นโหมดผูกเครื่องอัตโนมัติ")
        time.sleep(1.5)
    if MIGRATED_FILES:
        logger.info(f"ย้ายไฟล์เวอร์ชันเก่าเข้า {DATA_DIR}: {', '.join(MIGRATED_FILES)}")
        ui_ok(f"ย้ายไฟล์ตั้งค่าเดิมเข้าโฟลเดอร์ {DATA_DIR} แล้ว: {', '.join(MIGRATED_FILES)}")
        time.sleep(1.5)
    CFG.update(load_config())
    load_history()
    seal_plain_files()
    if seal_mode_now() == b"D":
        for p in (CONFIG_FILE, HISTORY_FILE, DASH_FILE):
            try:
                with open(p, "rb") as f:
                    if f.read(5) == SEAL_MAGIC + b"F":
                        atomic_write_json(p, read_secure_json(p))
            except Exception:
                pass
    if SECURE_WARNINGS:
        for w in SECURE_WARNINGS:
            ui_err(f"🔒 {w}")
        ui_warn("ไฟล์เดิมไม่ถูกลบ — ถ้าเป็นแค่ root ไม่ตอบสนองชั่วคราว ให้เปลี่ยนชื่อกลับแล้วเปิดใหม่")
        time.sleep(4)
    if autostart:
        run_autostart()
        return
    try:
        while True:
            print_ui(CFG)
            choice = ask("เลือกเมนู", " [0-7]")
            if choice == "1":
                menu_1_set_map(CFG)
            elif choice == "2":
                menu_2_set_bot(CFG)
            elif choice == "3":
                menu_3_start_bot(CFG)
            elif choice == "4":
                menu_4_ram(CFG)
            elif choice == "5":
                menu_5_log()
            elif choice == "6":
                menu_6_reboot()
            elif choice == "7":
                menu_7_service()
            elif choice == "0":
                sys.exit(0)
            elif choice:
                ui_err(f"ไม่มีเมนู '{choice}'")
                time.sleep(1)
    except KeyboardInterrupt:
        fix_tty()
        _out("", f"  {C_ACC}👋 ออกจากโปรแกรม{RESET}")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except SystemExit:
        raise
    except Exception:
        logger.error("fatal error:\n%s", traceback.format_exc())
        if "--service" in sys.argv:
            sys.exit(1)
        raise
