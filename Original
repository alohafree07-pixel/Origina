SERVICE_NAME = "rbbot"
_LOCK_FH = [None]

def acquire_instance_lock():
    try:
        fh = open(os.path.join(DATA_DIR, "bot.lock"), "a+")
    except OSError:
        return True
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return False
    try:
        fh.seek(0)
        fh.truncate()
        fh.write(str(os.getpid()))
        fh.flush()
    except OSError:
        pass
    _LOCK_FH[0] = fh
    return True

def release_instance_lock():
    fh = _LOCK_FH[0]
    _LOCK_FH[0] = None
    if fh is None:
        return
    try:
        fcntl.flock(fh, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        fh.close()
    except OSError:
        pass

def _prefix():
    return os.environ.get("PREFIX", "")

def service_dir():
    return os.path.join(_prefix(), "var", "service", SERVICE_NAME)

def service_installed():
    return bool(_prefix()) and os.path.isfile(os.path.join(service_dir(), "run"))

def _sv_env():
    env = dict(os.environ)
    env["SVDIR"] = os.path.join(_prefix(), "var", "service")
    return env

def _sv(*args, timeout=15):
    exe = shutil.which(args[0])
    if not exe:
        return 127, ""
    try:
        r = subprocess.run([exe] + list(args[1:]), stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=timeout, env=_sv_env())
        return r.returncode, ((r.stdout or "") + (r.stderr or "")).strip()
    except Exception as e:
        return 1, repr(e)

def service_state():
    if not service_installed():
        return "none"
    if not shutil.which("sv"):
        return "nosv"
    _, out = _sv("sv", "status", SERVICE_NAME, timeout=5)
    if out.startswith("run:"):
        return "run"
    if out.startswith("down:"):
        return "down"
    if "runsv not running" in out or "unable to change to service directory" in out:
        return "nodaemon"
    return "unknown"

def service_state_text(st=None):
    st = st or service_state()
    return {
        "run": f"{dot('ok')} {C_OK}ทำงานอยู่{RESET}",
        "down": f"{dot('warn')} {C_WARN}หยุดอยู่{RESET}",
        "nodaemon": f"{dot('warn')} {C_WARN}ตัวจัดการยังไม่ทำงาน{RESET}",
        "nosv": f"{dot('err')} {C_ERR}ไม่พบคำสั่ง sv{RESET}",
        "unknown": f"{dot('warn')} {C_WARN}ไม่ทราบสถานะ{RESET}",
        "none": f"{C_DIM}○ ยังไม่ได้ติดตั้ง{RESET}",
    }.get(st, "-")

def _service_run_script():
    script = os.path.abspath(__file__)
    return ("#!" + _prefix() + "/bin/sh\n"
            "exec 2>&1\n"
            "sleep 10\n"
            "cd " + shlex.quote(os.path.dirname(script)) + "\n"
            "exec " + shlex.quote(sys.executable) + " " + shlex.quote(script) + " --service\n")

def service_install():
    if not _prefix():
        return False, "ไม่พบ $PREFIX (ต้องรันภายใน Termux)"
    if not shutil.which("sv-enable"):
        ui_info("กำลังติดตั้ง termux-services ...")
        try:
            subprocess.run(["pkg", "install", "-y", "termux-services"], timeout=600)
        except Exception as e:
            return False, f"ติดตั้ง termux-services ไม่สำเร็จ: {e!r}"
        if not shutil.which("sv-enable"):
            return False, "ติดตั้ง termux-services ไม่สำเร็จ (ลองรัน: pkg install termux-services)"
    d = service_dir()
    try:
        os.makedirs(d, exist_ok=True)
        run_path = os.path.join(d, "run")
        with open(run_path, "w", encoding="utf-8") as f:
            f.write(_service_run_script())
        os.chmod(run_path, 0o755)
        down = os.path.join(d, "down")
        if os.path.exists(down):
            os.remove(down)
    except OSError as e:
        return False, f"สร้างไฟล์บริการไม่สำเร็จ: {e!r}"
    if shutil.which("service-daemon"):
        _sv("service-daemon", "start", timeout=20)
    _sv("sv-enable", SERVICE_NAME, timeout=20)
    time.sleep(6)
    _sv("sv", "up", SERVICE_NAME, timeout=10)
    st = service_state()
    if st == "run":
        return True, "ติดตั้งและเริ่มบริการแล้ว"
    if st == "nodaemon":
        return True, "ติดตั้งแล้ว แต่ตัวจัดการยังไม่ทำงาน — ปิด Termux แล้วเปิดใหม่ 1 ครั้ง"
    return True, f"ติดตั้งแล้ว (สถานะ: {st})"

def service_control(action):
    if not service_installed():
        return False, "ยังไม่ได้ติดตั้งบริการ"
    rc, out = _sv("sv", action, SERVICE_NAME, timeout=15)
    if rc != 0:
        return False, out or "สั่งไม่สำเร็จ"
    return True, "สั่งเริ่มบริการแล้ว" if action == "up" else "สั่งหยุดบริการแล้ว"

def service_uninstall():
    if not service_installed():
        return True, "ยังไม่ได้ติดตั้ง"
    _sv("sv", "down", SERVICE_NAME, timeout=15)
    _sv("sv-disable", SERVICE_NAME, timeout=15)
    shutil.rmtree(service_dir(), ignore_errors=True)
    return True, "ถอนการติดตั้งบริการแล้ว"

