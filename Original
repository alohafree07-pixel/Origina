# ================= Screen Capture =================
def grab_raw_frame():
    try:
        _, buf, _ = _su_exec(_t(12, "screencap"), 15)
    except Exception:
        return None
    if not buf or len(buf) < 100000:
        return None
    w = int.from_bytes(buf[0:4], "little")
    h = int.from_bytes(buf[4:8], "little")
    fmt = int.from_bytes(buf[8:12], "little")
    if w <= 0 or h <= 0 or w > 10000 or h > 10000 or fmt not in (1, 2):
        return None
    expected = w * h * 4
    if len(buf) < expected + 12:
        return None
    hdr = len(buf) - expected
    if hdr not in (12, 16):
        hdr = 12
    return buf, w, h, hdr

_SIG_OFFSET_CACHE = {}

def _get_sig_offsets(w, h, hdr):
    key = (w, h, hdr)
    cached = _SIG_OFFSET_CACHE.get(key)
    if cached is not None:
        return cached
    offsets = []
    for j in range(24):
        py = int(h * (j + 0.5) / 24)
        for i in range(14):
            px = int(w * (i + 0.5) / 14)
            offsets.append(hdr + (py * w + px) * 4)
    _SIG_OFFSET_CACHE[key] = offsets
    return offsets

def frame_signature(frame):
    buf, w, h, hdr = frame
    offsets = _get_sig_offsets(w, h, hdr)
    sig = bytearray(len(offsets) * 3)
    idx = 0
    for off in offsets:
        sig[idx] = buf[off] >> 4
        sig[idx + 1] = buf[off + 1] >> 4
        sig[idx + 2] = buf[off + 2] >> 4
        idx += 3
    return hashlib.md5(bytes(sig)).hexdigest()

# ---------- ตรวจหน้าต่าง Delta ขอ Key ("Welcome Back!" แผงด้านขวา) ----------
# วัดจากภาพจริง: พื้นแผงสีเทาน้ำเงินเข้มเรียบ ~ (26,28,36) และตัวหนังสือปุ่ม Continue สีฟ้า ~ (140,206,255)
def _is_key_panel_bg(r, g, b):
    return (14 <= r <= 42 and 16 <= g <= 48 and 24 <= b <= 60
            and b - r >= 6 and b >= g)

def _is_key_button_blue(r, g, b):
    return b >= 225 and g >= 170 and r <= 175 and (b - r) >= 70

def detect_key_panel(buf, w, h, hdr):
    """True ถ้าแถบด้านขวาของจอเป็นแผง Delta ขอ Key
    เงื่อนไข 1) พื้นที่ฝั่งขวาส่วนใหญ่เป็นสีพื้นแผงเรียบ  2) มีพิกเซลสีฟ้าของปุ่ม Continue"""
    try:
        def px(x, y):
            i = hdr + (y * w + x) * 4
            return buf[i], buf[i + 1], buf[i + 2]

        xs = [min(w - 1, int(w * (0.72 + 0.26 * i / 15))) for i in range(16)]
        ys = [min(h - 1, int(h * (0.06 + 0.88 * j / 19))) for j in range(20)]
        hit = 0
        for y in ys:
            for x in xs:
                if _is_key_panel_bg(*px(x, y)):
                    hit += 1
        if hit < 0.45 * len(xs) * len(ys):
            return False

        step = max(2, w // 400)
        blue = 0
        for y in range(int(h * 0.42), int(h * 0.62), step):
            for x in range(int(w * 0.74), int(w * 0.95), step):
                if _is_key_button_blue(*px(x, y)):
                    blue += 1
        return blue >= 12
    except Exception as e:
        logger.warning(f"detect_key_panel ผิดพลาด: {e}")
        return False

def key_panel_in_ui(ui_xml):
    """ตรวจจากข้อความใน uiautomator dump (เสริมการตรวจด้วยภาพ ถ้า Delta เปิดเผยข้อความให้อ่านได้)"""
    if not ui_xml:
        return False
    ul = ui_xml.lower()
    if "access delta by completing" in ul:
        return True
    return "enter key" in ul and "receive key" in ul

def inspect_screen():
    """คืน (พบกล่อง Disconnected?, signature ของเฟรม, พบหน้าต่าง Delta ขอ Key?)"""
    try:
        frame = grab_raw_frame()
        if not frame:
            return False, None, False
        buf, w, h, hdr = frame
        sig = frame_signature(frame)
        key_panel = detect_key_panel(buf, w, h, hdr)

        def get_rgb(px, py):
            i = hdr + (py * w + px) * 4
            return buf[i], buf[i + 1], buf[i + 2]

        def is_modal_gray(r, g, b):
            return (50 <= r <= 66 and 52 <= g <= 68 and 54 <= b <= 70
                    and abs(r - g) <= 4 and abs(g - b) <= 4 and b >= r)

        xs = [int(w * (0.35 + 0.30 * i / 24)) for i in range(25)]
        ys = [int(h * (0.28 + 0.44 * j / 19)) for j in range(20)]
        flat_pairs = 0
        for py in ys:
            prev = None
            for px in xs:
                rgb = get_rgb(px, py)
                if is_modal_gray(*rgb):
                    if prev is not None and abs(rgb[0] - prev[0]) <= 2 and abs(rgb[1] - prev[1]) <= 2:
                        flat_pairs += 1
                    prev = rgb
                else:
                    prev = None
        if flat_pairs < 40:
            return False, sig, key_panel

        btn_xs = [int(w * (0.36 + 0.28 * i / 29)) for i in range(30)]
        btn_ys = [int(h * (0.48 + 0.26 * j / 19)) for j in range(20)]
        white_rows = 0
        for py in btn_ys:
            streak = 0
            for px in btn_xs:
                r, g, b = get_rgb(px, py)
                streak = streak + 1 if (r >= 235 and g >= 235 and b >= 235) else 0
                if streak >= 5:
                    white_rows += 1
                    break
        if white_rows < 1:
            return False, sig, key_panel

        edge_gray = 0
        for j in range(10):
            py = int(h * (0.25 + 0.50 * j / 9))
            if is_modal_gray(*get_rgb(int(w * 0.08), py)):
                edge_gray += 1
            if is_modal_gray(*get_rgb(int(w * 0.92), py)):
                edge_gray += 1
        return edge_gray <= 6, sig, key_panel
    except Exception as e:
        logger.warning(f"inspect_screen ผิดพลาด: {e}")
        return False, None, False

