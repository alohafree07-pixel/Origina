class SealError(Exception):
    pass

def _device_fingerprint():
    try:
        _, out, _ = _su_exec(
            "settings get secure android_id; getprop ro.serialno; getprop ro.boot.serialno; "
            "getprop ro.product.brand; getprop ro.product.model; getprop ro.product.device", 10)
        lines = [ln.strip() for ln in out.decode("utf-8", errors="replace").splitlines()]
    except Exception:
        return None
    if not lines or not re.fullmatch(r"[0-9a-fA-F]{8,}", lines[0]):
        return None
    return "\n".join(lines)

def _master_key(mode):
    with _KEY_LOCK:
        if mode in _KEY_CACHE:
            return _KEY_CACHE[mode]
        if mode == b"D":
            if time.time() < _D_RETRY_AT[0]:
                return None
            fp = _device_fingerprint()
            if fp is None:
                _D_RETRY_AT[0] = time.time() + 60
                return None
            secret = fp.encode("utf-8")
        elif mode == b"F":
            secret = f"{os.getuid()}|{os.path.expanduser('~')}".encode("utf-8")
        else:
            return None
        key = hashlib.pbkdf2_hmac("sha256", secret, _APP_PEPPER, 60000, 32)
        _KEY_CACHE[mode] = key
        return key

def seal_mode_now():
    return b"D" if _master_key(b"D") else b"F"

def _subkeys(master):
    return (hmac.new(master, b"enc", hashlib.sha256).digest(),
            hmac.new(master, b"mac", hashlib.sha256).digest())

def _xor(data, ks):
    return (int.from_bytes(data, "big") ^ int.from_bytes(ks, "big")).to_bytes(len(data), "big")

def seal(data):
    mode = seal_mode_now()
    enc_key, mac_key = _subkeys(_master_key(mode))
    nonce = os.urandom(16)
    ct = _xor(data, hashlib.shake_256(enc_key + nonce).digest(len(data)))
    body = SEAL_MAGIC + mode + nonce + ct
    return body + hmac.new(mac_key, body, hashlib.sha256).digest()

def unseal(blob):
    if len(blob) < 4 + 1 + 16 + 32 or not blob.startswith(SEAL_MAGIC):
        raise SealError("รูปแบบไฟล์ไม่ถูกต้อง")
    mode = blob[4:5]
    master = _master_key(mode)
    if master is None:
        raise SealError("ต้องใช้ root เพื่ออ่านรหัสเครื่องก่อนถอดรหัส")
    enc_key, mac_key = _subkeys(master)
    body, tag = blob[:-32], blob[-32:]
    if not hmac.compare_digest(tag, hmac.new(mac_key, body, hashlib.sha256).digest()):
        raise SealError("ถอดรหัสไม่ได้ (คนละเครื่อง หรือไฟล์ถูกแก้ไข)")
    nonce, ct = body[5:21], body[21:]
    return _xor(ct, hashlib.shake_256(enc_key + nonce).digest(len(ct)))

def is_sealed_file(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == SEAL_MAGIC
    except OSError:
        return False

def _quarantine(path, reason):
    dst = f"{path}.unreadable-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
    try:
        os.replace(path, dst)
        SECURE_WARNINGS.append(f"{os.path.basename(path)}: {reason} → เก็บไว้ที่ {os.path.basename(dst)}")
    except OSError:
        SECURE_WARNINGS.append(f"{os.path.basename(path)}: {reason}")

def read_secure_json(path):
    with open(path, "rb") as f:
        raw = f.read()
    if raw.startswith(SEAL_MAGIC):
        try:
            raw = unseal(raw)
        except SealError as e:
            _quarantine(path, str(e))
            raise
    return json.loads(raw.decode("utf-8"))

