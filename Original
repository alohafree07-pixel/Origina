def add_history(action, reason="", extra=None):
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    entry = {"time": now_str, "action": action, "reason": reason}
    if extra:
        entry.update(extra)
    REJOIN_HISTORY.append(entry)
    if len(REJOIN_HISTORY) > MAX_HISTORY_RECORDS:
        del REJOIN_HISTORY[: len(REJOIN_HISTORY) - MAX_HISTORY_RECORDS]
    save_history()

def fix_tty():
    try:
        import termios
        fd = sys.stdout.fileno()
        attrs = termios.tcgetattr(fd)
        attrs[1] |= termios.ONLCR | termios.OPOST
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
    except Exception:
        pass

def _char_width(ch):
    if unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    if unicodedata.east_asian_width(ch) in ("W", "F") or ord(ch) >= 0x1F000:
        return 2
    return 1

def trim_visible(text, max_vis=26):
    vis = 0
    out = []
    for ch in str(text):
        w = _char_width(ch)
        if w == 0:
            out.append(ch)
            continue
        if vis + w > max_vis:
            out.append("..")
            break
        vis += w
        out.append(ch)
    return "".join(out)

C_BD = "\033[38;5;38m"
C_DIM = "\033[38;5;244m"
C_LBL = "\033[38;5;109m"
C_VAL = "\033[1;97m"
C_OK = "\033[38;5;84m"
