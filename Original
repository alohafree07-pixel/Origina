def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            cfg.update({k: v for k, v in data.items() if k in DEFAULT_CONFIG})
        except Exception as e:
            logger.warning(f"อ่านไฟล์ config ไม่ได้: {e}")
    if not isinstance(cfg.get("allowed_users"), list):
        cfg["allowed_users"] = []
    return cfg

def save_config(cfg):
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except OSError:
        pass

# ================= คำสั่ง Root =================
def run_root_text(cmd, timeout=15):
    try:
        res = subprocess.run(["su", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, timeout=timeout, errors="replace")
        return res.stdout.strip()
    except Exception as e:
        logger.warning(f"run_root_text ผิดพลาด: {e}")
        return ""

async def aroot(cmd, timeout=15):
    return await asyncio.to_thread(run_root_text, cmd, timeout)

def clear_system_ram():
    run_root_text("sync && echo 3 > /proc/sys/vm/drop_caches")

def clear_termux_junk():
    home = os.path.expanduser("~")
    prefix = os.environ.get("PREFIX", "")
    targets = glob.glob(os.path.join(home, ".cache", "*"))
    if prefix:
        targets += glob.glob(os.path.join(prefix, "tmp", "*"))
    for p in targets:
        try:
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p, ignore_errors=True)
            else:
                os.remove(p)
        except OSError:
            pass
    try:
        subprocess.run(["apt", "clean"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    except Exception:
        pass

