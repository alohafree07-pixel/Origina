# ================= ไฟล์ JSON แบบ atomic =================
def atomic_write_json(path, data, **dump_kwargs):
    """เขียนไฟล์ผ่าน temp แล้ว os.replace (กันไฟล์พังเมื่อโปรแกรมถูกปิดกลางคัน)
    mkstemp สร้างไฟล์สิทธิ์ 600 ให้อยู่แล้ว เหมาะกับ config ที่มี token"""
    directory = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(prefix=".tmp_", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, **dump_kwargs)
        os.replace(tmp, path)
    except Exception:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise

