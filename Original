        if not is_authorized(interaction.user.id):
            return await interaction.response.send_message("⛔ ไม่มีสิทธิ์", ephemeral=True)
        path = str(CFG.get("autoexec_path", "")).strip()
        filename = clean_filename(self.filename_input.value)
        if not filename:
            return await interaction.response.send_message("❌ ชื่อไฟล์ไม่ถูกต้อง", ephemeral=True)
