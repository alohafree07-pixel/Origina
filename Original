            updates["clear_ram_hours"] = clear_ram_hours
        except ValueError:
            errors.append("รอบ Clear RAM ต้องเป็นตัวเลข ≥ 0.1")

        exec_path = self.inp_exec.value.strip()
        if valid_path(exec_path):
            updates["autoexec_path"] = exec_path
        else:
            errors.append("โฟลเดอร์ AutoExec ต้องขึ้นต้นด้วย /sdcard, /storage หรือ /data/local/tmp")

        if errors:
            return await interaction.response.send_message(
                "❌ **ยังไม่บันทึกการตั้งค่า**\n⚠️ กรุณาแก้ไข: " + ", ".join(errors),
                ephemeral=True
            )

        CFG.update(updates)
        save_config(CFG)

        summary = (f"✅ **อัปเดตการตั้งค่า**\n🎮 Place ID: `{CFG['place_id']}`\n"
                   f"📂 โฟลเดอร์: `{CFG['autoexec_path']}`")
        await interaction.response.send_message(summary, ephemeral=True)
        log("อัปเดตการตั้งค่าระบบผ่าน Discord", GREEN)

