def inspect_screen():
    try:
        frame = grab_raw_frame()
        if not frame:
            return False, None, False
        buf, w, h, hdr = frame
        sig = frame_signature(frame)
        key_panel = detect_key_panel(buf, w, h, hdr)

        def get_rgb(px, py):
            i = hdr + (py * w + px) * 4
            return buf[i], buf[i + 1], buf[i + 2]

        def is_modal_gray(r, g, b):
            return (50 <= r <= 66 and 52 <= g <= 68 and 54 <= b <= 70
                    and abs(r - g) <= 4 and abs(g - b) <= 4 and b >= r)

        xs = [int(w * (0.35 + 0.30 * i / 24)) for i in range(25)]
        ys = [int(h * (0.28 + 0.44 * j / 19)) for j in range(20)]
        flat_pairs = 0
        for py in ys:
            prev = None
            for px in xs:
                rgb = get_rgb(px, py)
                if is_modal_gray(*rgb):
                    if prev is not None and abs(rgb[0] - prev[0]) <= 2 and abs(rgb[1] - prev[1]) <= 2:
                        flat_pairs += 1
                    prev = rgb
                else:
                    prev = None
        if flat_pairs < 40:
            return False, sig, key_panel

        btn_xs = [int(w * (0.36 + 0.28 * i / 29)) for i in range(30)]
        btn_ys = [int(h * (0.48 + 0.26 * j / 19)) for j in range(20)]
        white_rows = 0
        for py in btn_ys:
            streak = 0
            for px in btn_xs:
                r, g, b = get_rgb(px, py)
                streak = streak + 1 if (r >= 235 and g >= 235 and b >= 235) else 0
                if streak >= 5:
                    white_rows += 1
                    break
        if white_rows < 1:
            return False, sig, key_panel

        edge_gray = 0
        for j in range(10):
            py = int(h * (0.25 + 0.50 * j / 9))
            if is_modal_gray(*get_rgb(int(w * 0.08), py)):
                edge_gray += 1
            if is_modal_gray(*get_rgb(int(w * 0.92), py)):
                edge_gray += 1
        return edge_gray <= 6, sig, key_panel
    except Exception as e:
        logger.warning(f"inspect_screen ผิดพลาด: {e}")
        return False, None, False

_NET_CACHE_UNTIL = [0.0]

async def check_internet():
    now = time.time()
    if now < _NET_CACHE_UNTIL[0]:
        return True

    async def probe(host, port):
        try:
            _, w = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=4)
            w.close()
            return True
        except Exception:
            return False

    results = await asyncio.gather(
        probe("1.1.1.1", 443),
        probe("8.8.8.8", 53),
        probe("google.com", 443),
        return_exceptions=True
    )
    ok = any(r is True for r in results)
    if ok:
        _NET_CACHE_UNTIL[0] = time.time() + NET_CACHE_SECONDS
    return ok

