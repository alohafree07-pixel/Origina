def _rx(pattern, text):
    return re.search(pattern, text, re.IGNORECASE) is not None

_LOG_RX_273 = re.compile(r"\b(?:error\s*code\s*[:=]\s*(?:273|264)|disconnect[^\n]*\breason\s*[:=]\s*(?:273|264))\b", re.I)
_LOG_RX_PSS4 = re.compile(r"\berror\s*code\s*[:=]?\s*pss4\b", re.I)
_LOG_RX_267 = re.compile(r"\b(?:error\s*code\s*[:=]\s*267|disconnect[^\n]*\breason\s*[:=]\s*267)\b", re.I)
_LOG_RX_277 = re.compile(r"\b(?:error\s*code\s*[:=]\s*(?:277|279)|disconnect[^\n]*\breason\s*[:=]\s*(?:277|279))\b", re.I)
_LOG_RX_278 = re.compile(r"\b(?:error\s*code\s*[:=]\s*278|disconnect[^\n]*\breason\s*[:=]\s*278)\b", re.I)
_LOG_RX_268 = re.compile(r"\b(?:error\s*code\s*[:=]\s*(?:268|272)|disconnect[^\n]*\breason\s*[:=]\s*(?:268|272))\b", re.I)
_LOG_RX_26X = re.compile(r"\berror\s*code\s*[:=]\s*(?:260|261|262|524|529|773)\b", re.I)
_LOG_RX_GEN = re.compile(r"disconnect\w*[^\n]*\breason\s*[:=]\s*(?:2[6-9]\d|5\d\d|6\d\d|7\d\d)\b", re.I)

def extract_active_session_logs(raw_log_text):
    if not raw_log_text:
        return ""
    lines = raw_log_text.splitlines()
    last_join_idx = 0
    for idx, line in enumerate(lines):
        ll = line.lower()
        if "! joining game" in ll or "joining game '" in ll or "connection accepted from" in ll:
            last_join_idx = idx
    return "\n".join(lines[last_join_idx:]).lower()

def _build_health_commands(cfg, want_ui):
    tail_n = max(800, int(cfg.get("log_tail_lines", 1000)))
    log_expr = f'LATEST=$(ls -t {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log 2>/dev/null | head -n 1)'
    cmds = {
        "pidof": f"pidof {PACKAGE_NAME} || true",
        "focus": "dumpsys window windows | grep -E 'mCurrentFocus|mFocusedApp' || true",
        "log_tail": f'{log_expr}; if [ -n "$LATEST" ]; then tail -n {tail_n} "$LATEST"; fi',
        "log_age": f'{log_expr}; if [ -n "$LATEST" ]; then NOW=$(date +%s); MT=$(stat -c %Y "$LATEST" 2>/dev/null); if [ -n "$MT" ]; then echo $((NOW-MT)); fi; fi',
    }
    if want_ui:
        cmds["ui_xml"] = f"uiautomator dump {UI_TMP} >/dev/null 2>&1; cat {UI_TMP} 2>/dev/null; rm -f {UI_TMP}"
    return cmds

def analyze_probe(cfg, probe):
    if not probe.get("pidof", "").strip():
        return False, "แอป Roblox ปิดตัวลง (App Crashed)"

    focus = probe.get("focus", "")
    if "com.android.vending" in focus or "Google Play" in focus:
        return False, "เด้งไป Play Store (เกมบังคับอัปเดตแพทช์)"
    if "Application Not Responding" in focus:
        return False, "ตัวเกมค้างไม่ตอบสนอง (System ANR)"

    active = extract_active_session_logs(probe.get("log_tail", ""))
    if active:
        if _LOG_RX_273.search(active) or "same account launched" in active \
                or "same account is currently" in active or "from different device" in active:
            return False, "ตรวจพบคนเข้าไอดีซ้อน! (Error Code: 273)"
        if _LOG_RX_PSS4.search(active) or "datastores not loading" in active:
            return False, "เซิร์ฟเวอร์โหลดข้อมูลไม่ขึ้น (Error PSS4 / 267)"
        if _LOG_RX_267.search(active) or "you have been kicked" in active \
                or "you were kicked" in active or "kicked by this experience" in active \
                or "moderation message:" in active:
            return False, "ถูกเตะออกจากแมพ (Error Code: 267)"
        if _LOG_RX_277.search(active) or "please check your internet connection" in active \
                or "lost connection to the game server" in active \
                or "id_connection_lost" in active or "connection attempt failed" in active:
            return False, "เน็ตหลุดหรือเซิร์ฟเวอร์ตัด (Error Code: 277)"
        if _LOG_RX_278.search(active) or "idle 20 minutes" in active or "idledisconnect" in active:
            return False, "ยืนนิ่งเกิน 20 นาที (Error Code: 278 AFK)"
        if _LOG_RX_268.search(active) or "unexpected client behavior" in active or "security kick" in active:
            return False, "เซิร์ฟเวอร์หรือระบบความปลอดภัยเตะ (Error: 268/272)"
        if _LOG_RX_26X.search(active):
            return False, "เชื่อมต่อแมพไม่สำเร็จ (Error: 529/524/26x)"
        if _LOG_RX_GEN.search(active) or "disconnection notification" in active:
            return False, "ถูกตัดการเชื่อมต่อจากเซิร์ฟเวอร์ (Disconnect)"

    ui = probe.get("ui_xml", "")
    if ui:
        ul = ui.lower()
        if any(k in ul for k in ("upgrade required", "update required", "needs to be updated", "please update")):
            return False, "หน้าจอแจ้งให้อัปเดตเวอร์ชัน (Upgrade Required)"
        if "same account launched" in ul or re.search(r"\berror\s*code\s*[:=]\s*273\b", ul):
            return False, "ตรวจพบคนเข้าไอดีซ้อนบนจอ (Error 273)"
        if "check your internet" in ul or re.search(r"\berror\s*code\s*[:=]\s*277\b", ul):
            return False, "หน้าจอแจ้งเตือนเน็ตหลุด (Error 277)"
        if "pss4" in ul or "datastores not loading" in ul:
            return False, "เซิร์ฟเวอร์แมพมีปัญหา (Error Code PSS4)"
        if "kicked by this experience" in ul or "you have been kicked" in ul:
            return False, "ถูกเตะออกจากแมพ (Kicked by Experience)"
        if "disconnected" in ul and ("error code" in ul or "leave" in ul or "reconnect" in ul):
            return False, "หน้าจอแจ้งเตือนหลุดออกจากเกม (Disconnected)"
        if ("log in" in ul and "sign up" in ul) or ("discover" in ul and "avatar" in ul and "connect" in ul):
            return False, "เด้งออกกลับมาหน้าเมนูหลัก Roblox"

    return True, "ปกติ"

def analyze_stall(cfg, probe):
    if not probe.get("pidof", "").strip():
        return False, "แอป Roblox ปิดตัวลง (Watchdog)"

    now = time.time()
    grace = max(60, int(cfg.get("startup_grace_seconds", 90)))
    if now - STATE.get("game_start_time", 0) < grace:
        STATE["bg_count"] = 0
        return True, "กำลังอยู่ในช่วงโหลดเกม"

    stale_limit = max(90, int(cfg.get("log_stale_seconds", 180)))

    try:
        log_age = int(probe.get("log_age", "").strip())
    except (TypeError, ValueError):
        log_age = None

    focus = probe.get("focus", "")
    focus_known = bool(focus.strip())
    roblox_focused = PACKAGE_NAME in focus

    if focus_known and not roblox_focused:
        STATE["bg_count"] = STATE.get("bg_count", 0) + 1
    else:
        STATE["bg_count"] = 0

    if roblox_focused and log_age is not None and log_age >= stale_limit:
        return False, f"Roblox เงียบ/ค้างนาน {log_age}s (Watchdog)"

    if focus_known and not roblox_focused:
        if log_age is None or log_age >= max(60, stale_limit // 2):
            return False, "Roblox ไม่ได้อยู่หน้าจอและไม่มี Log ใหม่"
        if STATE["bg_count"] >= 4:
            return False, "Roblox หลุดไปอยู่เบื้องหลังนานเกินไป"

    frozen_need = max(3, int(cfg.get("frozen_screen_checks", 6)))
    if STATE.get("frozen_count", 0) >= frozen_need and (log_age is None or log_age >= 60):
        return False, "หน้าจอนิ่งสนิทและไม่มี Log ใหม่ (น่าจะหลุด/ค้าง)"

    return True, "ปกติ"

def analyze_game_health(cfg):
    probe = run_health_probe(cfg, want_ui=True)
    healthy, reason = analyze_probe(cfg, probe)
    if not healthy:
        return False, reason
    healthy, reason = analyze_stall(cfg, probe)
    if not healthy:
        return False, reason
    dialog, sig = inspect_screen()
    if dialog:
        return False, "ตรวจพบกล่องแจ้งเตือน Disconnected บนหน้าจอเกม"
    if sig:
        if sig == STATE.get("last_frame_sig"):
            STATE["frozen_count"] = STATE.get("frozen_count", 0) + 1
        else:
            STATE["frozen_count"] = 0
            STATE["last_frame_sig"] = sig
    return True, "ปกติ"

def run_health_probe(cfg, want_ui=False):
    return batch_root(_build_health_commands(cfg, want_ui), timeout=20)

