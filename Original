# ================= Screen Capture =================
def grab_raw_frame():
    try:
        res = subprocess.run(
            ["su", "-c", "screencap"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=15
        )
        buf = res.stdout
    except Exception:
        return None
    if not buf or len(buf) < 100000:
        return None
    w = int.from_bytes(buf[0:4], "little")
    h = int.from_bytes(buf[4:8], "little")
    fmt = int.from_bytes(buf[8:12], "little")
    if w <= 0 or h <= 0 or w > 10000 or h > 10000 or fmt not in (1, 2):
        return None
    expected = w * h * 4
    if len(buf) < expected + 12:
        return None
    hdr = len(buf) - expected
    if hdr not in (12, 16):
        hdr = 12
    return buf, w, h, hdr

_SIG_OFFSET_CACHE = {}

def _get_sig_offsets(w, h, hdr):
    key = (w, h, hdr)
    cached = _SIG_OFFSET_CACHE.get(key)
    if cached is not None:
        return cached
    offsets = []
    for j in range(24):
        py = int(h * (j + 0.5) / 24)
        for i in range(14):
            px = int(w * (i + 0.5) / 14)
            offsets.append(hdr + (py * w + px) * 4)
    _SIG_OFFSET_CACHE[key] = offsets
    return offsets

def frame_signature(frame):
    buf, w, h, hdr = frame
    offsets = _get_sig_offsets(w, h, hdr)
    n = len(offsets)
    sig = bytearray(n * 3)
    idx = 0
    for off in offsets:
        sig[idx] = buf[off] >> 4
        sig[idx + 1] = buf[off + 1] >> 4
        sig[idx + 2] = buf[off + 2] >> 4
        idx += 3
    return hashlib.md5(bytes(sig)).hexdigest()

def inspect_screen():
    try:
        frame = grab_raw_frame()
        if not frame:
            return False, None
        buf, w, h, hdr = frame
        sig = frame_signature(frame)

        def get_rgb(px, py):
            i = hdr + (py * w + px) * 4
            return buf[i], buf[i + 1], buf[i + 2]

        def is_modal_gray(r, g, b):
            return (50 <= r <= 66 and 52 <= g <= 68 and 54 <= b <= 70
                    and abs(r - g) <= 4 and abs(g - b) <= 4 and b >= r)

        xs = [int(w * (0.35 + 0.30 * i / 24)) for i in range(25)]
        ys = [int(h * (0.28 + 0.44 * j / 19)) for j in range(20)]
        flat_pairs = 0
        for py in ys:
            prev = None
            for px in xs:
                rgb = get_rgb(px, py)
                if is_modal_gray(*rgb):
                    if prev is not None and abs(rgb[0] - prev[0]) <= 2 and abs(rgb[1] - prev[1]) <= 2:
                        flat_pairs += 1
                    prev = rgb
                else:
                    prev = None
        if flat_pairs < 40:
            return False, sig

        btn_xs = [int(w * (0.36 + 0.28 * i / 29)) for i in range(30)]
        btn_ys = [int(h * (0.48 + 0.26 * j / 19)) for j in range(20)]
        white_rows = 0
        for py in btn_ys:
            streak = 0
            for px in btn_xs:
                r, g, b = get_rgb(px, py)
                streak = streak + 1 if (r >= 235 and g >= 235 and b >= 235) else 0
                if streak >= 5:
                    white_rows += 1
                    break
        if white_rows < 1:
            return False, sig

        edge_gray = 0
        for j in range(10):
            py = int(h * (0.25 + 0.50 * j / 9))
            if is_modal_gray(*get_rgb(int(w * 0.08), py)):
                edge_gray += 1
            if is_modal_gray(*get_rgb(int(w * 0.92), py)):
                edge_gray += 1
        return edge_gray <= 6, sig
    except Exception as e:
        logger.warning(f"inspect_screen ผิดพลาด: {e}")
        return False, None

