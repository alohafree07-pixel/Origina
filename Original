def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                cfg.update({k: v for k, v in data.items() if k in DEFAULT_CONFIG})
        except Exception as e:
            logger.warning(f"อ่านไฟล์ config ไม่ได้: {e}")

    # ตรวจ/แปลงชนิดข้อมูล กันค่าพังจากการแก้ไฟล์มือ
    for key, default in DEFAULT_CONFIG.items():
        if isinstance(default, bool):
            continue
        if isinstance(default, (int, float)):
            try:
                cfg[key] = type(default)(cfg[key])
            except (TypeError, ValueError):
                cfg[key] = default
        elif isinstance(default, str):
            cfg[key] = "" if cfg[key] is None else str(cfg[key]).strip()
    cfg["allowed_users"] = _clean_user_ids(cfg.get("allowed_users"))
    return cfg

def save_config(cfg):
