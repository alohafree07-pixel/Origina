        cmd = f"mkdir -p {shlex.quote(path)} && echo {encoded} | base64 -d > {shlex.quote(file_path)}"
        await aroot(cmd)
        await interaction.response.send_message(f"✅ สร้างไฟล์ `{filename}` ลงใน AutoExecute สำเร็จ!", ephemeral=True)
        log(f"เพิ่มสคริปต์: {filename}", GREEN)

class DeleteScriptModal(discord.ui.Modal, title='🗑️ ลบสคริปต์ฟาร์ม (Delete Script)'):
