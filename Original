# TOKEN HANDLING
# ═══════════════════════════════════════════════════════════════
def load_token(interactive: bool = True) -> str | None:
    # 1) env
    t = os.environ.get("DISCORD_TOKEN", "").strip()
    if t:
        return t
    # 2) ไฟล์
    if TOKEN_FILE.exists():
        t = TOKEN_FILE.read_text(encoding="utf-8").strip()
        if t:
            return t
    # 3) ถาม (เฉพาะโหมด install)
    if interactive and sys.stdin.isatty():
        warn("ยังไม่มี Discord Bot Token")
        print(f"   สร้างได้ที่: https://discord.com/developers/applications")
        try:
            t = input(f"{BRIGHT_CYAN}วาง token ที่นี่: {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            return None
        if t:
            TOKEN_FILE.write_text(t, encoding="utf-8")
            try:
                TOKEN_FILE.chmod(0o600)
            except Exception:
                pass
            ok(f"บันทึก token ที่: {TOKEN_FILE}")
            return t
    return None


