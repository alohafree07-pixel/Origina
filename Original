async def delete_key_messages(keep_last=False):
    msgs = list(STATE.get("key_msgs", []))
    if keep_last:
        targets, STATE["key_msgs"] = msgs[:-1], msgs[-1:]
    else:
        targets, STATE["key_msgs"] = msgs, []
    for m in targets:
        try:
            await m.delete()
        except discord.NotFound:
            pass
        except Exception as e:
            logger.warning(f"ลบข้อความแจ้งเตือน Key ไม่สำเร็จ: {e!r}")

async def send_key_alert(channel, interval):
    mentions = " ".join(f"<@{uid}>" for uid in CFG.get("allowed_users", []))
    since = STATE.get("key_since", 0.0)
    waited = int(time.time() - since) if since > 0 else 0
    content = (f"🔑 **พบหน้าต่าง Delta ขอ Key (Welcome Back!)**\n"
               f"⚠️ สคริปต์จะยังไม่ทำงานจนกว่าจะใส่ Key\n"
               f"⏱️ รอมาแล้ว **{waited // 60} นาที {waited % 60} วินาที** • แท็กซ้ำทุก {interval} วินาที\n"
               f"{mentions}")[:DISCORD_MSG_LIMIT]
    try:
        img_bytes = await asyncio.to_thread(capture_screenshot_bytes)
        kwargs = dict(content=content, allowed_mentions=discord.AllowedMentions(users=True))
        if img_bytes:
            kwargs["file"] = discord.File(io.BytesIO(img_bytes), filename="key_panel.png")
