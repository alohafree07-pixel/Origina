def menu_3_start_bot(cfg):
    global DASHBOARD_ACTIVE, LAST_RESULT_TEXT

    if not cfg['place_id'] or not cfg['bot_token'] or not cfg['channel_id']:
        print(f"\n{RED}✘ กรุณาตั้งค่า Place ID, Bot Token และ Channel ID ก่อนครับ!{RESET}")
        time.sleep(2)
        return
    if not cfg['allowed_users']:
        print(f"\n{RED}✘ ยังไม่ได้ตั้งค่า Discord User ID ของผู้มีสิทธิ์สั่งงาน (เมนู 2){RESET}")
        time.sleep(3)
        return

    subprocess.run(["termux-wake-lock"], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    STATE["dev_name"] = run_root_text("getprop ro.product.model") or "Android Device"
    now = time.time()
    STATE.update({"paused": False, "last_screenshot": now, "last_ram_clear": now,
                  "game_start_time": now, "fail_count": 0, "loop_restarts": 0,
                  "net_dropped": False, "last_rejoin_attempt": 0.0, "lock": None})

    LAST_RESULT_TEXT = f"{YELLOW}⏳ กำลังเชื่อมต่อ Discord...{RESET}"
    DASHBOARD_ACTIVE = True
    print_bot_dashboard()

    intents = discord.Intents.default()
    bot = commands.Bot(command_prefix="!", intents=intents)
    ready_once = {"done": False}

    @tasks.loop(seconds=max(5, int(cfg['check_interval'])))
    async def game_monitor_loop():
        try:
            if STATE["paused"] or (STATE["lock"] and STATE["lock"].locked()):
                return

            channel = bot.get_channel(int(cfg['channel_id']))

            if not await check_internet():
                STATE["net_dropped"] = True
                log("⚠️ เน็ตหลุด! กำลังรอสัญญาณ...", RED)
                return

            if STATE.get("net_dropped"):
                STATE["net_dropped"] = False
                log("🌐 เน็ตกลับมาแล้ว! สั่ง Rejoin...", YELLOW)
                if channel:
                    await send_bot_report(channel, "🌐 **สัญญาณอินเทอร์เน็ตกลับมาแล้ว!** กำลังดึงกลับเข้าเกมอัตโนมัติ...", True)
                await do_rejoin(channel, "✅ **Rejoin หลังเน็ตหลุดสำเร็จแล้ว**")
                return

            healthy, reason = await asyncio.to_thread(analyze_game_health, cfg)
            if healthy:
                healthy, reason = await asyncio.to_thread(detect_long_session_stall, cfg)
            now = time.time()

            if not healthy:
                log(f"⚠️ {reason}", RED)

                if "อัปเดต" in reason or "Upgrade" in reason or "Play Store" in reason:
                    STATE["paused"] = True
                    await aroot(f"am force-stop {PACKAGE_NAME}")
                    if channel:
                        await send_bot_report(channel, f"🚨 **หยุดทำงานอัตโนมัติ:** {reason}\n👉 *โปรดไปอัปเดตแอปผ่าน Play Store ด้วยตัวเอง แล้วค่อยกดปุ่ม ▶️ Resume Auto*", True)
                    return

                STATE["fail_count"] += 1
                fails = STATE["fail_count"]
                delay = min(30 * (fails - 1), 300)
                msg = f"⚠️ **ปัญหา:** {reason}\n🔄 Rejoin ครั้งที่ {fails} ติดต่อกัน"
                if delay:
                    msg += f" (รอ {delay} วินาทีก่อนเข้าใหม่)"
                if fails >= MAX_FAILS_ALERT:
                    msg += "\n🚨 **Rejoin ติดต่อกันหลายครั้ง!** ตรวจสอบเครื่อง/เซิร์ฟเวอร์/ไอดีอาจมีคนเล่นซ้อนอยู่"
                if channel:
                    await send_bot_report(channel, msg, True)
                if delay:
                    await asyncio.sleep(delay)
                    if STATE["paused"]:
                        return
                await do_rejoin(channel, "✅ **Rejoin สำเร็จแล้ว**")
                return

            if STATE["fail_count"] and now - STATE["game_start_time"] > 180:
                STATE["fail_count"] = 0

            if now - STATE["last_ram_clear"] >= max(0.1, float(cfg.get('clear_ram_hours', 1))) * 3600:
                await asyncio.to_thread(clear_system_ram)
                await asyncio.to_thread(clear_termux_junk)
                log("เคลียร์ RAM & ขยะ Termux สำเร็จ", GREEN)
                STATE["last_ram_clear"] = now

            if now - STATE["last_screenshot"] >= max(1, int(cfg['screenshot_minutes'])) * 60:
                log("แคปหน้าจอส่งรายงานประจำรอบ", CYAN)
                if channel:
                    await send_bot_report(channel, "📸 รายงานสถานะหน้าจอประจำรอบ", True)
                STATE["last_screenshot"] = now

            STATE["loop_restarts"] = 0

        except Exception as e:
            log(f"🔥 ข้อผิดพลาด: {e}", RED)
            raise

    @game_monitor_loop.before_loop
    async def before_game_monitor():
        await bot.wait_until_ready()

    @game_monitor_loop.error
    async def game_monitor_error(error):
        STATE["loop_restarts"] += 1
        log(f"🚨 ลูปพัง ({STATE['loop_restarts']}/{MAX_LOOP_RESTARTS})", RED)
        if STATE["loop_restarts"] > MAX_LOOP_RESTARTS:
            log("❌ หยุดรีสตาร์ทลูป กรุณาเริ่มบอทใหม่", RED)
            return
        await asyncio.sleep(5)
        game_monitor_loop.restart()

    @bot.event
    async def on_ready():
        log(f"✅ เชื่อมต่อ {bot.user.name} สำเร็จ!", GREEN)
        if ready_once["done"]:
            return
        ready_once["done"] = True

        if STATE["lock"] is None:
            STATE["lock"] = asyncio.Lock()
        bot.add_view(ControlView())

        channel = bot.get_channel(int(cfg['channel_id']))
        if channel:
            await send_bot_report(channel, "🟢 เริ่มเดินระบบเฝ้าจอ Auto Rejoin แล้ว!")
        else:
            log("⚠️ หา Channel ไม่เจอ ตรวจสอบ ID", RED)

        if not await aroot(f"pidof {PACKAGE_NAME}"):
            log("กำลังสั่งเปิดเกมเข้าแมพครั้งแรก...", CYAN)
            await do_rejoin(channel, "✅ เข้าแมพครั้งแรกเรียบร้อย")

        if not game_monitor_loop.is_running():
            game_monitor_loop.start()

    try:
        bot.run(cfg['bot_token'], log_handler=None)
    except discord.LoginFailure:
        DASHBOARD_ACTIVE = False
        fix_tty()
        print(f"\n{RED}❌ Bot Token ไม่ถูกต้อง! ตรวจสอบอีกครั้งในเมนู 2{RESET}")
        time.sleep(2)
        return
    except KeyboardInterrupt:
        pass

    DASHBOARD_ACTIVE = False
    fix_tty()
    subprocess.run(["termux-wake-unlock"], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"\n\n{YELLOW}🛑 ปิดบอทเฝ้าจอแล้ว (Offline){RESET}")
    ans = safe_input("ต้องการบังคับปิดแอป Roblox ด้วยไหม? (y/n): ").lower()
    if ans == 'y':
        run_root_text(f"am force-stop {PACKAGE_NAME}")
    time.sleep(1)

# ================= ลูปหลักของโปรแกรม =================
def main():
    CFG.update(load_config())
    while True:
        print_ui(CFG)
        choice = safe_input(f"  {BOLD_WHITE}เลือกเมนู: {RESET}")

        if choice == "1":
            menu_1_set_map(CFG)
        elif choice == "2":
            menu_2_set_bot(CFG)
        elif choice == "3":
            menu_3_start_bot(CFG)
        elif choice == "4":
            menu_4_ram(CFG)
        elif choice == "0":
            sys.exit(0)

if __name__ == "__main__":
    main()
