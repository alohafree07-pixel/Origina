_NET_CACHE_UNTIL = [0.0]

async def check_internet():
    now = time.time()
    if now < _NET_CACHE_UNTIL[0]:
        return True

    async def probe(host, port):
        try:
            _, w = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=4)
            w.close()
            return True
        except Exception:
            return False

    results = await asyncio.gather(
        probe("1.1.1.1", 443),
        probe("8.8.8.8", 53),
        probe("google.com", 443),
        return_exceptions=True
    )
    ok = any(r is True for r in results)
    if ok:
        _NET_CACHE_UNTIL[0] = time.time() + NET_CACHE_SECONDS
    return ok

async def check_discord_health(bot, channel):
    """✅ FIX: รับ bot เป็น parameter (เดิมอ้าง global bot ที่ไม่มี → NameError)"""
    is_offline = False
    try:
        if bot.is_closed() or not bot.is_ready():
            is_offline = True
        else:
            lat = bot.latency
            if lat is None or (isinstance(lat, float) and math.isnan(lat)):
                is_offline = True
    except Exception:
        is_offline = True

    if is_offline:
        if STATE.get("discord_offline_since", 0) == 0:
            STATE["discord_offline_since"] = time.time()
            log("🔌 ตรวจพบ Discord ขาดการเชื่อมต่อ", RED, force_redraw=True)
        return

    since = STATE.get("discord_offline_since", 0)
    if since > 0:
        STATE["discord_offline_since"] = 0
        dur = time.time() - since
        if dur >= DISCORD_OFFLINE_THRESHOLD and channel:
            await send_reconnect_alert(channel, dur)

async def send_reconnect_alert(channel, duration_sec):
    mentions = " ".join(f"<@{uid}>" for uid in CFG.get("allowed_users", []))
    if duration_sec < 60:
        dur_text = f"{int(duration_sec)} วินาที"
    elif duration_sec < 3600:
        dur_text = f"{int(duration_sec / 60)} นาที"
    else:
        dur_text = f"{duration_sec / 3600:.1f} ชั่วโมง"
    try:
        await channel.send(
            f"🔌 **บอทกลับมาเชื่อมต่อ Discord แล้ว!**\n"
            f"⏱️ ขาดการเชื่อมต่อนานประมาณ **{dur_text}**\n"
            f"🔄 ระบบเฝ้าจออาจไม่ได้แจ้งเตือนในช่วงเวลาดังกล่าว\n"
            f"{mentions}",
            allowed_mentions=discord.AllowedMentions(users=True)
        )
        log(f"แจ้งเตือน Discord reconnect (ขาด {dur_text})", YELLOW, force_redraw=True)
    except Exception as e:
        log(f"ส่งแจ้งเตือน reconnect ไม่สำเร็จ: {e}", RED)

