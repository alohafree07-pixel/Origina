def detect_disconnect_dialog_screen():
    """
    สแกนพิกเซลหน้าจอเพื่อตรวจจับกล่อง Disconnected สีเทาเข้ม (#393B3D)
    คู่กับปุ่มสีขาว (Leave / Reconnect) ดักจับได้แม้เกมไม่เขียนไฟล์ Log
    """
    try:
        res = subprocess.run(
            ["su", "-c", "screencap"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15
        )
        buf = res.stdout
        if not buf or len(buf) < 100000:
            return False

        w = int.from_bytes(buf[0:4], "little")
        h = int.from_bytes(buf[4:8], "little")
        fmt = int.from_bytes(buf[8:12], "little")
        expected = w * h * 4
        if w <= 0 or h <= 0 or fmt != 1 or len(buf) < expected + 12:
            return False
        hdr = len(buf) - expected
        if hdr not in (12, 16):
            hdr = 12

        def get_rgb(px, py):
            idx = hdr + (py * w + px) * 4
            return buf[idx], buf[idx + 1], buf[idx + 2]

        def is_modal_gray(r, g, b):
            # สีพื้นหลังกล่อง Disconnected ของ Roblox คือ RGB(57, 59, 61)
            return (52 <= r <= 62 and 54 <= g <= 64 and 56 <= b <= 66
                    and abs(r - g) <= 3 and abs(g - b) <= 3 and b >= r)

        xs = [int(w * (0.35 + 0.30 * i / 24)) for i in range(25)]
        ys = [int(h * (0.28 + 0.44 * j / 19)) for j in range(20)]

        flat_gray_pairs = 0
        for py in ys:
            prev = None
            for px in xs:
                rgb = get_rgb(px, py)
                if is_modal_gray(*rgb):
                    if prev is not None and abs(rgb[0] - prev[0]) <= 1 and abs(rgb[1] - prev[1]) <= 1:
                        flat_gray_pairs += 1
                    prev = rgb
                else:
                    prev = None

        if flat_gray_pairs < 65:
            return False

        btn_xs = [int(w * (0.36 + 0.28 * i / 29)) for i in range(30)]
        btn_ys = [int(h * (0.48 + 0.26 * j / 19)) for j in range(20)]
        white_btn_rows = 0
        for py in btn_ys:
            white_streak = 0
            for px in btn_xs:
                r, g, b = get_rgb(px, py)
                if r >= 238 and g >= 238 and b >= 238:
                    white_streak += 1
                else:
                    white_streak = 0
                if white_streak >= 6:
                    white_btn_rows += 1
                    break

        if white_btn_rows < 2:
            return False

        edge_gray = 0
        edge_ys = [int(h * (0.25 + 0.50 * j / 9)) for j in range(10)]
        for py in edge_ys:
            if is_modal_gray(*get_rgb(int(w * 0.08), py)):
                edge_gray += 1
            if is_modal_gray(*get_rgb(int(w * 0.92), py)):
                edge_gray += 1

        return edge_gray <= 4
    except Exception as e:
        logger.warning(f"detect_disconnect_dialog_screen ผิดพลาด: {e}")
        return False

async def check_internet():
    for host, port in (("1.1.1.1", 443), ("8.8.8.8", 53), ("google.com", 443)):
        try:
            _, w = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=4)
            w.close()
            return True
        except Exception:
            continue
    return False

# ================= ดึงข้อมูลสถานะเครื่อง =================
def get_discord_embed(dev_name, is_paused):
    try:
        with open("/proc/stat", "r") as f:
            s1 = [int(i) for i in f.readline().split()[1:8]]
        time.sleep(0.2)
        with open("/proc/stat", "r") as f:
            s2 = [int(i) for i in f.readline().split()[1:8]]
        t1, t2 = sum(s1), sum(s2)
        i1, i2 = s1[3] + s1[4], s2[3] + s2[4]
        cpu_usage = round(100 * ((t2 - t1) - (i2 - i1)) / (t2 - t1), 2) if t2 - t1 > 0 else 0
    except Exception:
        cpu_usage = 0

    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
        mem_total = mem_avail = 0
        for l in lines:
            if l.startswith("MemTotal:"):
                mem_total = int(l.split()[1])
            elif l.startswith("MemAvailable:"):
                mem_avail = int(l.split()[1])
        mem_total_gb = round(mem_total / (1024 * 1024), 2)
        mem_avail_pct = round((mem_avail / mem_total) * 100, 2) if mem_total > 0 else 0
        mem_usage_pct = round(100 - mem_avail_pct, 2)
    except Exception:
        mem_total_gb = mem_avail_pct = mem_usage_pct = 0

    try:
        with open("/proc/uptime", "r") as f:
            up_sec = float(f.readline().split()[0])
        uptime_hrs = round(up_sec / 3600, 2)
    except Exception:
        uptime_hrs = 0

    status_color = 0xf1c40f if is_paused else 0x3498db
    embed = discord.Embed(color=status_color)
    embed.add_field(name="🔹 Device Name", value=f"`{dev_name}`", inline=True)
    embed.add_field(name="⚙️ CPU Usage", value=f"`{cpu_usage}%`", inline=True)
    embed.add_field(name="💾 Memory Usage", value=f"`{mem_usage_pct}%`", inline=True)
    embed.add_field(name="💾 Memory Available", value=f"`{mem_avail_pct}%`", inline=True)
    embed.add_field(name="💡 Total Memory", value=f"`{mem_total_gb} GB`", inline=True)
    embed.add_field(name="⏰ Uptime", value=f"`{uptime_hrs} hours`", inline=True)
    return embed

# ================= เข้าเกม / ตรวจสุขภาพเกม (ไร้ False Positive) =================
async def join_roblox_async(cfg):
    place_id = str(cfg.get("place_id", "")).strip()
    vip_code = str(cfg.get("vip_link_code", "")).strip()

    if not valid_place_id(place_id) or not valid_vip(vip_code):
        log("Place ID หรือ VIP Code ไม่ถูกต้อง", RED)
        return False

    log("กำลังปิดเกมและเคลียร์ Log...", YELLOW)
    await aroot(f"am force-stop {PACKAGE_NAME}")
    await aroot(f"rm -rf {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log")
    await asyncio.to_thread(clear_system_ram)
    await asyncio.sleep(3)

    if vip_code:
        deep_link = f"roblox://placeId={place_id}&linkCode={vip_code}"
    else:
        deep_link = f"roblox://placeId={place_id}"

    await aroot(f"am start -a android.intent.action.VIEW -d {shlex.quote(deep_link)} {PACKAGE_NAME}")
    wait = int(cfg.get("join_wait_seconds", 35))
    log(f"กำลังโหลดเข้าแมพ ({wait}s)...", GREEN)
    await asyncio.sleep(wait)
    return True

def _rx(pattern, text):
    return re.search(pattern, text, re.IGNORECASE) is not None

def extract_active_session_logs(raw_log_text):
    """
    ตัดเฉพาะบรรทัด Log ที่เกิดขึ้นหลังจากการเชื่อมต่อเซิร์ฟเวอร์ครั้งล่าสุด (! Joining game)
    เพื่อป้องกันไม่ให้ประวัติตอนย้ายเซิร์ฟ/เทเลพอร์ตไปดันเจี้ยนในรอบก่อนหน้ามาทำให้เกิดแจ้งเตือนหลอก
    """
    if not raw_log_text:
        return ""
    lines = raw_log_text.splitlines()
    last_join_idx = 0
    for idx, line in enumerate(lines):
        ll = line.lower()
        if "! joining game" in ll or "joining game '" in ll or "connection accepted from" in ll:
            last_join_idx = idx
    return "\n".join(lines[last_join_idx:]).lower()

def detect_long_session_stall(cfg):
    """
    Watchdog สำหรับอาการเล่นไปนาน ๆ แล้ว Roblox หลุด/ค้าง แต่ไม่มี Error ชัดเจน
    ใช้ PID + อายุ log ล่าสุด + สถานะหน้าต่าง เพื่อบังคับ Rejoin เมื่อเกมเงียบผิดปกติ
    """
    if not run_root_text(f"pidof {PACKAGE_NAME}"):
        return False, "แอป Roblox ปิดตัวลง (Watchdog)"

    now = time.time()
    grace = max(60, int(cfg.get("startup_grace_seconds", 90)))
    if now - STATE.get("game_start_time", 0) < grace:
        return True, "กำลังอยู่ในช่วงโหลดเกม"

    stale_limit = max(90, int(cfg.get("log_stale_seconds", 180)))
    age_text = run_root_text(
        f"LATEST=$(ls -t {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log 2>/dev/null | head -n 1); "
        f"if [ -n \"$LATEST\" ]; then NOW=$(date +%s); MT=$(stat -c %Y \"$LATEST\" 2>/dev/null); "
        f"if [ -n \"$MT\" ]; then echo $((NOW-MT)); fi; fi"
    )
    try:
        log_age = int(age_text.strip())
    except (TypeError, ValueError):
        log_age = None

    focus = run_root_text("dumpsys window windows | grep -E 'mCurrentFocus|mFocusedApp'")
    roblox_focused = PACKAGE_NAME in focus

    # ถ้า Roblox ยังอยู่หน้าจอแต่ log เงียบนานมาก ให้ถือว่าค้าง/หลุดแบบตรวจไม่เจอ
    if roblox_focused and log_age is not None and log_age >= stale_limit:
        return False, f"Roblox เงียบ/ค้างนาน {log_age}s (Watchdog)"

    # ถ้าแอปยังมี PID แต่หน้าต่างหลุดออกจาก Roblox และ log เงียบด้วย ก็ให้เข้าใหม่
    if (not roblox_focused and log_age is not None
            and log_age >= max(60, stale_limit // 2)):
        return False, f"Roblox ไม่ได้อยู่หน้าจอและไม่มี Log ใหม่ {log_age}s"

    return True, "ปกติ"


def analyze_game_health(cfg):
    # --- ชั้นที่ 1: ตรวจสอบสถานะแอปและหน้าต่างระบบ Android ---
    dumpsys_focus = run_root_text("dumpsys window windows | grep -E 'mCurrentFocus|mFocusedApp'")
    if "com.android.vending" in dumpsys_focus or "Google Play" in dumpsys_focus:
        return False, "เด้งไป Play Store (เกมบังคับอัปเดตแพทช์)"

    if not run_root_text(f"pidof {PACKAGE_NAME}"):
        return False, "แอป Roblox ปิดตัวลง (App Crashed)"

    if "Application Not Responding" in dumpsys_focus:
        return False, "ตัวเกมค้างไม่ตอบสนอง (System ANR)"

    # --- ชั้นที่ 2: อ่านเฉพาะไฟล์ Log ล่าสุดของ Roblox (ไม่อ่าน logcat เพื่อกันแจ้งเตือนหลอก) ---
    tail_n = max(800, int(cfg.get("log_tail_lines", 1000)))
    raw_logs = run_root_text(
        f"LATEST=$(ls -t {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log 2>/dev/null | head -n 1); "
        f"if [ -n \"$LATEST\" ]; then tail -n {tail_n} \"$LATEST\"; fi",
        timeout=15
    )

    active_logs = extract_active_session_logs(raw_logs)

    if active_logs:
        # 1. ตรวจจับคนเข้าไอดีซ้อน (Error 273 / 264) - ใช้ \b ล็อกคำเฉพาะ ไม่จับ KeyCode=273
        if (
            _rx(r"\b(?:error\s*code\s*[:=]\s*(?:273|264)|disconnect[^\n]*\breason\s*[:=]\s*(?:273|264))\b", active_logs)
            or "same account launched" in active_logs
            or "same account is currently" in active_logs
            or "from different device" in active_logs
        ):
            return False, "ตรวจพบคนเข้าไอดีซ้อน! (Error Code: 273)"

        # 2. ตรวจจับเซิร์ฟเวอร์แมพโหลดข้อมูลไม่ขึ้น (Error Code PSS4)
        if _rx(r"\berror\s*code\s*[:=]?\s*pss4\b", active_logs) or "datastores not loading" in active_logs:
            return False, "เซิร์ฟเวอร์โหลดข้อมูลไม่ขึ้น (Error PSS4 / 267)"

        # 3. ตรวจจับการถูกเตะออกจากแมพ (Error Code: 267)
        if (
            _rx(r"\b(?:error\s*code\s*[:=]\s*267|disconnect[^\n]*\breason\s*[:=]\s*267)\b", active_logs)
            or "you have been kicked" in active_logs
            or "you were kicked" in active_logs
            or "kicked by this experience" in active_logs
            or "moderation message:" in active_logs
        ):
            return False, "ถูกเตะออกจากแมพ (Error Code: 267)"

        # 4. ตรวจจับเน็ตหลุด / เซิร์ฟเวอร์ตัดการเชื่อมต่อ (Error Code: 277 / 279)
        if (
            _rx(r"\b(?:error\s*code\s*[:=]\s*(?:277|279)|disconnect[^\n]*\breason\s*[:=]\s*(?:277|279))\b", active_logs)
            or "please check your internet connection" in active_logs
            or "lost connection to the game server" in active_logs
            or "id_connection_lost" in active_logs
            or "connection attempt failed" in active_logs
        ):
            return False, "เน็ตหลุดหรือเซิร์ฟเวอร์ตัด (Error Code: 277)"

        # 5. ตรวจจับยืนนิ่ง AFK เกิน 20 นาที (Error Code: 278)
        if (
            _rx(r"\b(?:error\s*code\s*[:=]\s*278|disconnect[^\n]*\breason\s*[:=]\s*278)\b", active_logs)
            or "idle 20 minutes" in active_logs
            or "idledisconnect" in active_logs
        ):
            return False, "ยืนนิ่งเกิน 20 นาที (Error Code: 278 AFK)"

        # 6. ตรวจจับเซิร์ฟเวอร์หรือระบบความปลอดภัยเตะ (Error Code: 268 / 272)
        if (
            _rx(r"\b(?:error\s*code\s*[:=]\s*(?:268|272)|disconnect[^\n]*\breason\s*[:=]\s*(?:268|272))\b", active_logs)
            or "unexpected client behavior" in active_logs
            or "security kick" in active_logs
        ):
            return False, "เซิร์ฟเวอร์หรือระบบความปลอดภัยเตะ (Error: 268/272)"

        # 7. ตรวจจับเซิร์ฟเวอร์มีปัญหาเข้าไม่ได้ (Error Code: 524 / 529 / 773)
        if _rx(r"\berror\s*code\s*[:=]\s*(?:260|261|262|524|529|773)\b", active_logs):
            return False, "เชื่อมต่อแมพไม่สำเร็จ (Error: 529/524/26x)"

    # --- ชั้นที่ 3: ตรวจสอบ UI XML ---
    ui_xml = run_root_text(f"uiautomator dump {UI_TMP} >/dev/null 2>&1; cat {UI_TMP}; rm -f {UI_TMP}")
    if ui_xml:
        ul = ui_xml.lower()
        if "upgrade" in ul and "roblox" in ul:
            return False, "หน้าจอแจ้งให้อัปเดตเวอร์ชัน (Upgrade Required)"
        if "same account launched" in ul or _rx(r"\berror\s*code\s*[:=]\s*273\b", ul):
            return False, "ตรวจพบคนเข้าไอดีซ้อนบนจอ (Error 273)"
        if "check your internet" in ul or _rx(r"\berror\s*code\s*[:=]\s*277\b", ul):
            return False, "หน้าจอแจ้งเตือนเน็ตหลุด (Error 277)"
        if "pss4" in ul or "datastores not loading" in ul:
            return False, "เซิร์ฟเวอร์แมพมีปัญหา (Error Code PSS4)"
        if "kicked by this experience" in ul or "you have been kicked" in ul:
            return False, "ถูกเตะออกจากแมพ (Kicked by Experience)"
        if "disconnected" in ul and ("error code" in ul or "leave" in ul or "reconnect" in ul):
            return False, "หน้าจอแจ้งเตือนหลุดออกจากเกม (Disconnected)"
        if ("log in" in ul and "sign up" in ul) or ("discover" in ul and "avatar" in ul and "connect" in ul):
            return False, "เด้งออกกลับมาหน้าเมนูหลัก Roblox"

    # --- ชั้นที่ 4: สแกนพิกเซลหน้าจอจับกล่อง Disconnected สีเทาเข้ม (#393B3D) ---
    if detect_disconnect_dialog_screen():
        return False, "ตรวจพบกล่องแจ้งเตือน Disconnected บนหน้าจอเกม"

    return True, "ปกติ"

# ================= อัปเดตสคริปต์อย่างปลอดภัย =================
def safe_update_script():
    script_path = os.path.abspath(sys.argv[0])
    tmp_path = script_path + ".new"
    try:
        with urllib.request.urlopen(UPDATE_URL, timeout=30) as r:
            data = r.read()
    except Exception as e:
        return False, f"❌ ดาวน์โหลดไม่สำเร็จ: {e}"
    if len(data) < 5000:
        return False, "❌ ไฟล์ที่ดาวน์โหลดเล็กผิดปกติ ยกเลิกการอัปเดต"

    expected_hash = str(CFG.get("update_sha256", "")).strip().lower()
    if expected_hash:
        if not re.fullmatch(r"[0-9a-f]{64}", expected_hash):
            return False, "❌ update_sha256 ใน config ไม่ถูกต้อง"
        actual_hash = hashlib.sha256(data).hexdigest()
        if actual_hash != expected_hash:
            return False, "❌ SHA-256 ของไฟล์อัปเดตไม่ตรง ยกเลิกการอัปเดต"

    try:
        compile(data, "update_check", "exec")
    except SyntaxError as e:
        return False, f"❌ โค้ดใหม่มี Syntax Error ({e}) ยกเลิกการอัปเดต"
    if b"def main" not in data:
        return False, "❌ โค้ดใหม่ไม่มีฟังก์ชัน main ยกเลิกการอัปเดต"
    try:
        shutil.copy2(script_path, script_path + ".bak")
        with open(tmp_path, "wb") as f:
            f.write(data)
        os.replace(tmp_path, script_path)
    except Exception as e:
        return False, f"❌ เขียนไฟล์ไม่สำเร็จ: {e}"
    return True, "✅ อัปเดตโค้ดเรียบร้อย กำลังรีสตาร์ทใน 2 วินาที..."

