HOME          = Path(os.path.expanduser("~"))
SCRIPT_PATH   = Path(__file__).resolve()
SCRIPT_DIR    = SCRIPT_PATH.parent
IS_TERMUX     = Path("/data/data/com.termux").is_dir()
TERMUX_BIN    = Path("/data/data/com.termux/files/usr/bin")

SERVICE_NAME  = "discordbot"
SERVICE_DIR   = HOME / ".termux" / "services" / SERVICE_NAME
LOG_DIR       = SERVICE_DIR / "log" / "main"
BOOT_DIR      = HOME / ".termux" / "boot"
BOOT_SCRIPT   = BOOT_DIR / f"start-{SERVICE_NAME}.sh"
