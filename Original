    @discord.ui.button(label="📂 Check AutoExec", style=discord.ButtonStyle.secondary, row=3, custom_id="btn_check_exec")
    async def btn_check_exec(self, interaction, button):
        """✅ FIX: แยก FOUND/NOT_DIR/NOT_FOUND + แสดง parent + รองรับโฟลเดอร์ว่าง"""
        path = str(CFG.get("autoexec_path", "")).strip()
        await interaction.response.defer()

        if not path:
            return await interaction.followup.send("❌ ยังไม่ได้ตั้งค่า AutoExec Path")
        if not valid_path(path):
            return await interaction.followup.send(
                f"❌ Path ไม่ถูกต้อง: `{path}`\n"
                f"💡 ต้องขึ้นต้นด้วย `/sdcard`, `/storage`, `/data`, `/mnt`, `/system`, `/root`, `/vendor`"
            )

        q = shlex.quote(path)
        script = (
            f'echo "TARGET:{path}"; '
            f'if [ -d {q} ]; then echo "STATUS:FOUND"; '
            f'  echo "---LS---"; ls -la {q} 2>&1 | head -60; echo "---ENDLS---"; '
            f'elif [ -e {q} ]; then echo "STATUS:NOT_DIR"; '
            f'else echo "STATUS:NOT_FOUND"; '
            f'  P=$(dirname {q}); '
            f'  if [ -d "$P" ]; then echo "PARENT:FOUND:$P"; '
            f'    echo "---PARENTLS---"; ls -1 "$P" 2>&1 | head -15; echo "---ENDPARENT---"; '
            f'  else echo "PARENT:NOT_FOUND:$P"; '
            f'  fi; '
            f'fi'
        )
        res = await aroot(script)

        if "STATUS:FOUND" in res:
            files = ""
            if "---LS---" in res and "---ENDLS---" in res:
                files = res.split("---LS---")[1].split("---ENDLS---")[0].strip()
            # กรองบรรทัด . และ .. ออก แต่คงส่วนหัว (total ...)
            lines = [ln for ln in files.splitlines() if not re.search(r"\s\.{1,2}\s*$", ln)]
            body = "\n".join(lines) if lines else "(ว่างเปล่า)"
            msg = f"📂 **พบโฟลเดอร์** `{path}`\n```\n{body[:1600]}\n```"
            if len(lines) <= 1:
                msg += "\n\n💡 กด **📝 Add Script** เพื่อสร้างไฟล์ (โฟลเดอร์ถูกสร้างให้อัตโนมัติ)"
            return await interaction.followup.send(msg)

        if "STATUS:NOT_DIR" in res:
            return await interaction.followup.send(
                f"⚠️ `{path}` มีอยู่แต่ **ไม่ใช่โฟลเดอร์**\n"
                f"💡 ลองแก้ path ใน **⚙️ Edit Settings**"
            )

        extra = ""
        if "PARENT:FOUND:" in res:
            p = res.split("PARENT:FOUND:")[1].split("\n")[0].strip()
            pc = ""
            if "---PARENTLS---" in res and "---ENDPARENT---" in res:
                pc = res.split("---PARENTLS---")[1].split("---ENDPARENT---")[0].strip()
            extra = f"\n\n📁 **โฟลเดอร์แม่:** `{p}`\n```\n{pc[:800]}\n```"
        elif "PARENT:NOT_FOUND:" in res:
            p = res.split("PARENT:NOT_FOUND:")[1].split("\n")[0].strip()
            extra = f"\n\n❌ โฟลเดอร์แม่ก็ไม่มี: `{p}`"

        msg = (
            f"❌ **ไม่พบโฟลเดอร์** `{path}`{extra}\n\n"
            f"💡 **วิธีสร้าง:**\n"
            f"• กดปุ่ม **📝 Add Script** (จะสร้างโฟลเดอร์ให้อัตโนมัติ)\n"
            f"• หรือใช้ **⚙️ Edit Settings** แก้ path เป็นโฟลเดอร์ที่มีอยู่"
        )
        await interaction.followup.send(msg)

