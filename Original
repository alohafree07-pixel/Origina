def detect_disconnect_dialog_screen():
    """
    สแกนพิกเซลหน้าจอโดยตรงเพื่อตรวจจับกล่อง Disconnected สีเทาเข้ม (#393B3D)
    คู่กับปุ่มสีขาว (Leave / Reconnect) ตรงกลางจอ ดักจับได้แม้เกมไม่เขียนไฟล์ Log
    """
    try:
        res = subprocess.run(["su", "-c", "screencap"], stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, timeout=15)
        buf = res.stdout
        if not buf or len(buf) < 100000:
            return False

        w = int.from_bytes(buf[0:4], "little")
        h = int.from_bytes(buf[4:8], "little")
        fmt = int.from_bytes(buf[8:12], "little")
        expected = w * h * 4
        if w <= 0 or h <= 0 or fmt != 1 or len(buf) < expected + 12:
            return False
        hdr = len(buf) - expected
        if hdr not in (12, 16):
            hdr = 12

        def get_rgb(px, py):
            idx = hdr + (py * w + px) * 4
            return buf[idx], buf[idx + 1], buf[idx + 2]

        def is_modal_gray(r, g, b):
            # สีพื้นหลังกล่อง Disconnected ของ Roblox คือ RGB(57, 59, 61)
            return (50 <= r <= 65 and 52 <= g <= 67 and 54 <= b <= 69
                    and abs(r - g) <= 4 and abs(g - b) <= 4 and b >= r)

        # 1. สแกนพื้นที่กลางจอเพื่อหาพื้นหลังกล่องสีเทาเรียบ (Flat Modal Gray)
        xs = [int(w * (0.36 + 0.28 * i / 24)) for i in range(25)]
        ys = [int(h * (0.28 + 0.44 * j / 19)) for j in range(20)]

        flat_gray_pairs = 0
        for py in ys:
            prev = None
            for px in xs:
                rgb = get_rgb(px, py)
                if is_modal_gray(*rgb):
                    if prev is not None and abs(rgb[0] - prev[0]) <= 1 and abs(rgb[1] - prev[1]) <= 1:
                        flat_gray_pairs += 1
                    prev = rgb
                else:
                    prev = None

        if flat_gray_pairs < 55:
            return False

        # 2. สแกนหาปุ่มสีขาว (ปุ่ม Leave หรือปุ่ม Reconnect) ในครึ่งล่างของกล่องกลางจอ
        btn_xs = [int(w * (0.35 + 0.30 * i / 29)) for i in range(30)]
        btn_ys = [int(h * (0.46 + 0.30 * j / 19)) for j in range(20)]
        white_btn_rows = 0
        for py in btn_ys:
            white_streak = 0
            for px in btn_xs:
                r, g, b = get_rgb(px, py)
                if r >= 235 and g >= 235 and b >= 235:
                    white_streak += 1
                else:
                    white_streak = 0
                if white_streak >= 4:
                    white_btn_rows += 1
                    break

        if white_btn_rows < 2:
            return False

        # 3. ตรวจสอบขอบซ้าย-ขวาของจอว่าไม่ใช่หน้าจอสีเทาทั้งแผ่น
        edge_gray = 0
        edge_ys = [int(h * (0.25 + 0.50 * j / 9)) for j in range(10)]
        for py in edge_ys:
            if is_modal_gray(*get_rgb(int(w * 0.08), py)):
                edge_gray += 1
            if is_modal_gray(*get_rgb(int(w * 0.92), py)):
                edge_gray += 1

        return edge_gray <= 6
    except Exception as e:
        logger.warning(f"detect_disconnect_dialog_screen ผิดพลาด: {e}")
        return False

async def check_internet():
    for host, port in (("1.1.1.1", 443), ("8.8.8.8", 53), ("google.com", 443)):
        try:
            _, w = await asyncio.wait_for(asyncio.open_connection(host, port), timeout=4)
            w.close()
            return True
        except Exception:
            continue
    return False

# ================= ดึงข้อมูลสถานะเครื่อง =================
def get_discord_embed(dev_name, is_paused):
    try:
        with open("/proc/stat", "r") as f:
            s1 = [int(i) for i in f.readline().split()[1:8]]
        time.sleep(0.2)
        with open("/proc/stat", "r") as f:
            s2 = [int(i) for i in f.readline().split()[1:8]]
        t1, t2 = sum(s1), sum(s2)
        i1, i2 = s1[3] + s1[4], s2[3] + s2[4]
        cpu_usage = round(100 * ((t2 - t1) - (i2 - i1)) / (t2 - t1), 2) if t2 - t1 > 0 else 0
    except Exception:
        cpu_usage = 0

    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
        mem_total = mem_avail = 0
        for l in lines:
            if l.startswith("MemTotal:"):
                mem_total = int(l.split()[1])
            elif l.startswith("MemAvailable:"):
                mem_avail = int(l.split()[1])
        mem_total_gb = round(mem_total / (1024 * 1024), 2)
        mem_avail_pct = round((mem_avail / mem_total) * 100, 2) if mem_total > 0 else 0
        mem_usage_pct = round(100 - mem_avail_pct, 2)
    except Exception:
        mem_total_gb = mem_avail_pct = mem_usage_pct = 0

    try:
        with open("/proc/uptime", "r") as f:
            up_sec = float(f.readline().split()[0])
        uptime_hrs = round(up_sec / 3600, 2)
    except Exception:
        uptime_hrs = 0

    status_color = 0xf1c40f if is_paused else 0x3498db
    embed = discord.Embed(color=status_color)
    embed.add_field(name="🔹 Device Name", value=f"`{dev_name}`", inline=True)
    embed.add_field(name="⚙️ CPU Usage", value=f"`{cpu_usage}%`", inline=True)
    embed.add_field(name="💾 Memory Usage", value=f"`{mem_usage_pct}%`", inline=True)
    embed.add_field(name="💾 Memory Available", value=f"`{mem_avail_pct}%`", inline=True)
    embed.add_field(name="💡 Total Memory", value=f"`{mem_total_gb} GB`", inline=True)
    embed.add_field(name="⏰ Uptime", value=f"`{uptime_hrs} hours`", inline=True)
    return embed

# ================= เข้าเกม / ตรวจสุขภาพเกม (4-Layer Detection) =================
async def join_roblox_async(cfg):
    place_id = str(cfg.get("place_id", "")).strip()
    vip_code = str(cfg.get("vip_link_code", "")).strip()

    if not valid_place_id(place_id) or not valid_vip(vip_code):
        log("Place ID หรือ VIP Code ไม่ถูกต้อง (ต้องเป็นตัวเลข / ตัวอักษรอังกฤษ)", RED)
        return False

    log("กำลังบังคับปิดเกมและเคลียร์ไฟล์ Log เก่า...", YELLOW)
    await aroot(f"am force-stop {PACKAGE_NAME}")
    await aroot(f"rm -rf {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log; logcat -c 2>/dev/null")
    await asyncio.to_thread(clear_system_ram)
    await asyncio.sleep(3)

    if vip_code:
        deep_link = f"roblox://placeId={place_id}&linkCode={vip_code}"
    else:
        deep_link = f"roblox://placeId={place_id}"

    await aroot(f"am start -a android.intent.action.VIEW -d {shlex.quote(deep_link)} {PACKAGE_NAME}")
    wait = int(cfg.get("join_wait_seconds", 35))
    log(f"ยิงคำสั่งเข้าแมพ {place_id} สำเร็จ! รอโหลดเข้าเกม {wait} วินาที...", GREEN)
    await asyncio.sleep(wait)
    return True

def _rx(pattern, text):
    return re.search(pattern, text, re.IGNORECASE) is not None

def analyze_game_health(cfg):
    target_place_id = str(cfg.get("place_id", "")).strip()

    # --- ชั้นที่ 1: ตรวจสอบสถานะแอปและหน้าต่างระบบ Android ---
    dumpsys_focus = run_root_text("dumpsys window windows | grep -E 'mCurrentFocus|mFocusedApp'")
    if "com.android.vending" in dumpsys_focus or "Google Play" in dumpsys_focus:
        return False, "เด้งไป Play Store (เกมบังคับอัปเดตแพทช์)"

    if not run_root_text(f"pidof {PACKAGE_NAME}"):
        return False, "แอป Roblox ปิดตัวลง (App Crashed)"

    if "Application Not Responding" in dumpsys_focus:
        return False, "ตัวเกมค้างไม่ตอบสนอง (System ANR)"

    # --- ชั้นที่ 2: สแกนไฟล์ Log ทั้งหมดและ Logcat หาสาเหตุการหลุดทุกชนิด ---
    grep_pattern = (
        "pss4|datastores not loading|please rejoin|you have been kicked|you were kicked|"
        "kicked by this experience|moderation message|seterrormessage|errorprompt|"
        "same account|different device|launched experience|already playing|"
        "check your internet|lost connection|connection lost|timed out|connection attempt failed|"
        "idle 20 minutes|idledisconnect|unexpected client behavior|security kick|"
        "sending disconnect|received disconnect|disconnected from|id_connection_lost|id_disconnection_notification|"
        "error code[: =]*[257][0-9]{2}|reason[: =]*[257][0-9]{2}|status[: =]*[257][0-9]{2}"
    )
    log_hits = run_root_text(
        f"grep -iE '{grep_pattern}' {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log 2>/dev/null | tail -n 150",
        timeout=15
    )

    tail_n = max(500, int(cfg.get("log_tail_lines", 1000)))
    log_tail = run_root_text(
        f"tail -n {tail_n} {GAME_LOG_DIR}/*.log {EXT_LOG_DIR}/*.log 2>/dev/null | tail -n 1500",
        timeout=15
    )

    logcat_hits = run_root_text(
        f"logcat -d -t 1500 2>/dev/null | grep -iE '{grep_pattern}' | tail -n 60",
        timeout=10
    )

    combined_logs = "\n".join(filter(None, [log_hits, log_tail, logcat_hits])).lower()

    if combined_logs:
        # 1. ตรวจจับคนเข้าไอดีซ้อน (Error 273 / 264)
        if (
            _rx(r"(error code|reason|status|code)[: =]*(273|264)\b", combined_logs)
            or "same account" in combined_logs
            or "different device" in combined_logs
            or "already playing" in combined_logs
        ):
            return False, "ตรวจพบคนเข้าไอดีซ้อนจากเครื่องอื่น! (Error Code: 273/264)"

        # 2. ตรวจจับแมพโหลดข้อมูลไม่ขึ้น (Error PSS4)
        if "pss4" in combined_logs or "datastores not loading" in combined_logs:
            return False, "เซิร์ฟเวอร์แมพโหลดข้อมูลไม่ขึ้น (Error Code PSS4 / 267)"

        # 3. ตรวจจับการถูกเตะออกจากแมพ (Error 267)
        if (
            _rx(r"(error code|reason|status|code)[: =]*267\b", combined_logs)
            or "you have been kicked" in combined_logs
            or "you were kicked" in combined_logs
            or "kicked by this experience" in combined_logs
            or "moderation message" in combined_logs
        ):
            return False, "ถูกเตะออกจากแมพ (Error Code: 267 / Kicked)"

        # 4. ตรวจจับเน็ตหลุด / หลุดจากเซิร์ฟเวอร์ (Error 277 / 266 / 279)
        if (
            _rx(r"(error code|reason|status|code)[: =]*(277|266|279)\b", combined_logs)
            or "check your internet" in combined_logs
            or "lost connection" in combined_logs
            or "connection lost" in combined_logs
            or "connection timed out" in combined_logs
            or "connection attempt failed" in combined_logs
            or "id_connection_lost" in combined_logs
        ):
            return False, "เน็ตกระตุกหรือหลุดจากเซิร์ฟเวอร์เกม (Error Code: 277/279)"

        # 5. ตรวจจับยืนนิ่ง AFK ครบ 20 นาที (Error 278)
        if (
            _rx(r"(error code|reason|status|code)[: =]*278\b", combined_logs)
            or "idle 20 minutes" in combined_logs
            or "idledisconnect" in combined_logs
        ):
            return False, "ถูกเตะเพราะยืนนิ่งเกิน 20 นาที (Error Code: 278 AFK)"

        # 6. ตรวจจับระบบความปลอดภัย/เซิร์ฟเวอร์เตะ (Error 268 / 272)
        if (
            _rx(r"(error code|reason|status|code)[: =]*(268|272)\b", combined_logs)
            or "unexpected client behavior" in combined_logs
            or "security kick" in combined_logs
        ):
            return False, "เซิร์ฟเวอร์หรือระบบความปลอดภัยเตะ (Error Code: 268/272)"

        # 7. ตรวจจับเซิร์ฟเวอร์ล่ม หรือเข้าเซิร์ฟ VIP ไม่ได้ (Error 524 / 529 / 773)
        if _rx(r"(error code|reason|status|code)[: =]*(260|261|262|524|529|773)\b", combined_logs):
            return False, "เชื่อมต่อแมพไม่สำเร็จหรือเซิร์ฟเวอร์มีปัญหา (Error Code: 529/524/26x)"

        # 8. คำสั่งตัดการเชื่อมต่อระดับเอนจินทั่วไป
        for sig in (
            "disconnected from",
            "sending disconnect",
            "received disconnect",
            "id_disconnection_notification",
            "seterrormessage",
            "errorprompt",
        ):
            if sig in combined_logs:
                return False, f"ตรวจพบการตัดการเชื่อมต่อจากเซิร์ฟเวอร์ ({sig})"

        if target_place_id and log_tail:
            for line in reversed(log_tail.splitlines()):
                if "placeId:" in line or "placeid=" in line.lower():
                    if target_place_id not in line:
                        return False, f"ตรวจพบการอยู่ในแมพอื่นที่ไม่ใช่ Place ID: {target_place_id}"
                    break

    # --- ชั้นที่ 3: ตรวจสอบ UI XML (ดักจับหน้าต่างระบบและอาการเด้งออกหน้าหลัก Roblox) ---
    ui_xml = run_root_text(f"uiautomator dump {UI_TMP} >/dev/null 2>&1; cat {UI_TMP}; rm -f {UI_TMP}")
    if ui_xml:
        ul = ui_xml.lower()
        if "upgrade" in ul and "roblox" in ul:
            return False, "หน้าจอแจ้งเตือนให้อัปเดตเวอร์ชัน (Upgrade Required)"
        if "same account" in ul or "different device" in ul or _rx(r"error code[: ]*273\b", ul):
            return False, "ตรวจพบคนเข้าไอดีซ้อนบนหน้าจอ (Error 273)"
        if "check your internet" in ul or _rx(r"error code[: ]*277\b", ul):
            return False, "หน้าจอแจ้งเตือนเน็ตหลุด (Error 277)"
        if "pss4" in ul or "datastores not loading" in ul:
            return False, "หน้าจอแจ้งเตือนเซิร์ฟเวอร์แมพมีปัญหา (Error Code PSS4)"
        if "kicked by this experience" in ul or "you have been kicked" in ul:
            return False, "หน้าจอแจ้งเตือนถูกเตะออกจากแมพ (Kicked by Experience)"
        if "disconnected" in ul and ("error code" in ul or "leave" in ul or "reconnect" in ul):
            return False, "หน้าจอแจ้งเตือนหลุดออกจากเกม (Disconnected)"
        # ดักจับกรณีหลุดออกจากแมพแล้วเด้งกลับมาอยู่หน้าเมนูหลัก (Home/Login)
        if ("log in" in ul and "sign up" in ul) or ("discover" in ul and "avatar" in ul and "connect" in ul):
            return False, "ตัวเกมเด้งออกกลับมาหน้าเมนูหลัก (หลุดออกจากแมพ)"

    # --- ชั้นที่ 4: สแกนพิกเซลหน้าจอจับกล่อง Disconnected สีเทาเข้ม (#393B3D) โดยตรง ---
    if detect_disconnect_dialog_screen():
        return False, "ตรวจพบกล่องแจ้งเตือน Disconnected บนหน้าจอเกม (หลุดจากแมพ / โดนเตะ / เข้าซ้อน)"

    return True, "ปกติ"

# ================= อัปเดตสคริปต์อย่างปลอดภัย =================
def safe_update_script():
    script_path = os.path.abspath(sys.argv[0])
    tmp_path = script_path + ".new"
    try:
        with urllib.request.urlopen(UPDATE_URL, timeout=30) as r:
            data = r.read()
    except Exception as e:
        return False, f"❌ ดาวน์โหลดไม่สำเร็จ: {e}"
    if len(data) < 5000:
        return False, "❌ ไฟล์ที่ดาวน์โหลดเล็กผิดปกติ ยกเลิกการอัปเดต (ไฟล์เดิมยังอยู่)"

    expected_hash = str(CFG.get("update_sha256", "")).strip().lower()
    if expected_hash:
        if not re.fullmatch(r"[0-9a-f]{64}", expected_hash):
            return False, "❌ update_sha256 ใน config ไม่ถูกต้อง (ต้องเป็น hex 64 ตัว)"
        actual_hash = hashlib.sha256(data).hexdigest()
        if actual_hash != expected_hash:
            return False, "❌ SHA-256 ของไฟล์อัปเดตไม่ตรง ยกเลิกการอัปเดต"

    try:
        compile(data, "update_check", "exec")
    except SyntaxError as e:
        return False, f"❌ โค้ดใหม่มี Syntax Error ({e}) ยกเลิกการอัปเดต"
    if b"def main" not in data:
        return False, "❌ โค้ดใหม่ไม่มีฟังก์ชัน main ยกเลิกการอัปเดต"
    try:
        shutil.copy2(script_path, script_path + ".bak")
        with open(tmp_path, "wb") as f:
            f.write(data)
        os.replace(tmp_path, script_path)
    except Exception as e:
        return False, f"❌ เขียนไฟล์ไม่สำเร็จ: {e}"
    return True, "✅ อัปเดตโค้ดเรียบร้อย (สำรองไฟล์เดิมเป็น .bak) กำลังรีสตาร์ทใน 2 วินาที..."

