def spawn(coro):
    t = asyncio.create_task(coro)
    BG_TASKS.add(t)
    t.add_done_callback(BG_TASKS.discard)
    return t

async def send_bot_report(channel, message, include_screenshot=False):
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    pause_tag = " ⏸️ `[PAUSED]`" if STATE["paused"] else ""
    content = (f"🤖 **[ORIGINAL REPORT]**{pause_tag} (`{now_str}`)\n"
               f"📌 **สถานะ:** {message}\n"
               f"🎮 **Place ID:** `{CFG['place_id']}`\n"
               f"🔁 **Rejoin รวม:** {STATE['rejoin_total']} ครั้ง")
    try:
        embed = await asyncio.to_thread(get_discord_embed, STATE["dev_name"], STATE["paused"])
        view = ControlView()
        img_bytes = await asyncio.to_thread(capture_screenshot_bytes) if include_screenshot else None
        if img_bytes:
            file = discord.File(io.BytesIO(img_bytes), filename="screenshot.png")
            await channel.send(content=content, embed=embed, file=file, view=view)
        else:
            await channel.send(content=content, embed=embed, view=view)
    except Exception as e:
        log(f"ส่งรายงานพลาด: {e}", RED)

async def do_rejoin(channel, done_message):
    async with STATE["lock"]:
        ok = await join_roblox_async(CFG)
        if ok:
            now = time.time()
            STATE["game_start_time"] = now
            STATE["last_ram_clear"] = now
            STATE["last_screenshot"] = now
            STATE["rejoin_total"] += 1

    # ตรวจสอบทันทีหลังโหลดเข้าเกมครบ 35 วินาทีว่าติดหน้า Disconnected หรือไม่
    if ok:
        healthy, reason = await asyncio.to_thread(analyze_game_health, CFG)
        if not healthy:
            log(f"⚠️ เข้าเกมแล้วพบปัญหาทันที: {reason}", RED)
            if channel:
                await send_bot_report(channel, f"⚠️ **เข้าเกมแล้วติดปัญหาทันที:** {reason}\n🔄 ระบบจะทำการ Rejoin ใหม่อัตโนมัติในรอบถัดไป", True)
            return False

    if channel:
        await send_bot_report(channel, done_message if ok else "❌ Rejoin ไม่สำเร็จ (ตรวจสอบ Place ID / VIP Code)", True)
    return ok

