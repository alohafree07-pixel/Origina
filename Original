def _read_cpu_samples():
    try:
        with open("/proc/stat", "r") as f:
            a = f.readline()
        time.sleep(0.15)
        with open("/proc/stat", "r") as f:
            b = f.readline()
        return a, b
    except OSError:
        out = run_root_text("head -n1 /proc/stat; sleep 0.2; head -n1 /proc/stat", timeout=8)
        lines = [ln for ln in out.splitlines() if ln.startswith("cpu")]
        if len(lines) >= 2:
            return lines[0], lines[1]
    return None

def _txt_bar(pct, width=8):
    try:
        pct = max(0.0, min(100.0, float(pct)))
    except (TypeError, ValueError):
        pct = 0.0
    filled = int(round(pct / 100 * width))
    return "▰" * filled + "▱" * (width - filled)

def get_discord_embed(dev_name, is_paused, info=None):
    info = info or {}
    cpu_usage = 0
    try:
        samples = _read_cpu_samples()
        if samples:
            s1 = [int(i) for i in samples[0].split()[1:8]]
            s2 = [int(i) for i in samples[1].split()[1:8]]
            t1, t2 = sum(s1), sum(s2)
            i1, i2 = s1[3] + s1[4], s2[3] + s2[4]
            if t2 - t1 > 0:
                cpu_usage = round(100 * ((t2 - t1) - (i2 - i1)) / (t2 - t1), 2)
    except Exception:
        cpu_usage = 0

    try:
        mem_total = mem_avail = 0
        with open("/proc/meminfo", "r") as f:
            for ln in f:
                if ln.startswith("MemTotal:"):
                    mem_total = int(ln.split()[1])
                elif ln.startswith("MemAvailable:"):
                    mem_avail = int(ln.split()[1])
        mem_total_gb = round(mem_total / (1024 * 1024), 2)
        mem_avail_pct = round((mem_avail / mem_total) * 100, 2) if mem_total > 0 else 0
        mem_usage_pct = round(100 - mem_avail_pct, 2)
    except Exception:
        mem_total_gb = mem_avail_pct = mem_usage_pct = 0

    try:
        with open("/proc/uptime", "r") as f:
